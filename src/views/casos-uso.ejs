<!-- Script específico de esta página: reproducción de video/imagen en cada caso de uso -->
<script>
const mediaAssets = {
    1: { video:"https://storage.googleapis.com/humansystem/5.mp4", staticImg:"https://storage.googleapis.com/humansystem/Gemini_Generated_Image_xnjmb7xnjmb7xnjm%20(1).png"},
    2: { video:"https://storage.googleapis.com/humansystem/4.mp4", staticImg:"https://storage.googleapis.com/humansystem/Gemini_Generated_Image_n30epdn30epdn30e.png" },
    3: { video:"https://storage.googleapis.com/humansystem/2.mp4", staticImg:"https://storage.googleapis.com/humansystem/img.png" },
    4: { video:"https://storage.googleapis.com/humansystem/1.mp4", staticImg:"https://storage.googleapis.com/humansystem/Gemini_Generated_Image_3v8j6n3v8j6n3v8j.png" }
};

document.addEventListener('DOMContentLoaded', () => {

    function playClip(container) {
        if (container.isPlaying) return;
        container.isPlaying = true;
        container.videoEl.style.display = 'block';
        container.imgEl.style.display = 'none';
        container.videoEl.currentTime = 0;
        const p = container.videoEl.play();
        if (p && p.catch) p.catch(() => stopClip(container));
    }

    function stopClip(container) {
        container.isPlaying = false;
        container.videoEl.pause();
        container.videoEl.style.display = 'none';
        container.imgEl.style.display = 'block';
    }

    for (let i = 1; i <= 4; i++) {
        const container = document.getElementById(`media-container-${i}`);
        if (!container) continue;

        const img = document.createElement('img');
        img.src = mediaAssets[i].staticImg;
        img.alt = `Human System Asset ${i}`;
        img.style.cssText = 'width:100%; height:100%; object-fit:cover; cursor:pointer; display:block;';

        const video = document.createElement('video');
        video.src = mediaAssets[i].video;
        video.muted = true;
        video.defaultMuted = true;
        video.setAttribute('muted', '');
        video.playsInline = true;
        video.setAttribute('playsinline', '');
        video.preload = 'auto';
        video.style.cssText = 'width:100%; height:100%; object-fit:cover; cursor:pointer; display:none;';

        container.innerHTML = '';
        container.appendChild(img);
        container.appendChild(video);

        container.imgEl = img;
        container.videoEl = video;
        container.isPlaying = false;

        video.addEventListener('ended', () => stopClip(container));
        video.addEventListener('error', () => stopClip(container));
    }

    for (let i = 1; i <= 4; i++) {
        const container = document.getElementById(`media-container-${i}`);
        if (!container) continue;
        container.addEventListener('mouseenter', () => playClip(container));
        container.addEventListener('touchstart', () => playClip(container), { passive: true });
    }

    const mediaObserver = new IntersectionObserver((entries) => {
        entries.forEach(entry => { if (entry.isIntersecting) playClip(entry.target); });
    }, { root: null, rootMargin: '0px', threshold: 0.5 });

    for (let i = 1; i <= 4; i++) {
        const container = document.getElementById(`media-container-${i}`);
        if (container) mediaObserver.observe(container);
    }
});
</script>

