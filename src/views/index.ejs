                            })
                    
                             .then(response => response.json())
                            .then(data => {
                                if (data.success) {
                  
                                     Swal.fire({
                                        title: 'Dato Personal eliminado',
                               
                                         text: 'Su dato personal ha sido eliminado correctamente.',
