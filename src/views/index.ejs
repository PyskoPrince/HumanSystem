        cardBack.style.borderRadius = '16px';
        cardBack.style.boxShadow = '0 10px 25px rgba(0,0,0,0.2)';
        cardBack.style.backgroundImage = 'url("https://storage.googleapis.com/humansystem/HUMAN%20ID%20BACK.png")';
        cardBack.style.backgroundSize = '100% 100%';
        cardBack.style.display = 'flex';
        cardBack.style.flexDirection = 'column';
        cardBack.style.overflow = 'hidden';

        // Banda magnética
        const magneticStripe = document.createElement('div');
