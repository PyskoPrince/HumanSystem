</script>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        const toggleSwitch = document.getElementById('toggleSwitch');
        toggleSwitch.checked = <%= JSON.stringify(toggleState) %>;
        toggleBlur();
    });

    function toggleBlur() {
        const toggleSwitch = document.getElementById('toggleSwitch');
        const nombreElement = document.getElementById("nombreID");
        const humanoElement = document.getElementById("humanoID");
        const telefonoLabel = document.getElementById("telefonoLabel");
        const correoLabel = document.getElementById("correoLabel");
        const direccionLabel = document.getElementById("direccionLabel");
        const descripcionUsuario = document.getElementById("descripcionUsuario");
        
        // NUEVO: Seleccionamos todos los iconos de redes sociales
        const socialLinks = document.querySelectorAll(".social-link");

        const shouldBlur = toggleSwitch.checked;

        // Aplicar o quitar la clase blurred a los textos
        nombreElement.classList.toggle("blurred", shouldBlur);
        humanoElement.classList.toggle("blurred", shouldBlur);
        descripcionUsuario.classList.toggle("blurred", shouldBlur);
        if(telefonoLabel) telefonoLabel.classList.toggle("blurred", shouldBlur);
        if(correoLabel) correoLabel.classList.toggle("blurred", shouldBlur);
        if(direccionLabel) direccionLabel.classList.toggle("blurred", shouldBlur);
        
        // NUEVO: Aplicar el blur a cada icono de red social
        socialLinks.forEach(link => {
            link.classList.toggle("blurred", shouldBlur);
            // Opcional: Deshabilitar clics cuando está oculto para mayor privacidad
            link.style.pointerEvents = shouldBlur ? "none" : "auto";
        });

        // Guardar estado en el servidor
        fetch('/toggle', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ toggleState: shouldBlur })
        })
        .catch(error => console.error('Error al guardar estado blur:', error));
    }
</script>

<script>
// ════════════════════════════════════════════════════════════════════════════
//  UTILIDAD: MODAL DE PAGO INLINE CON STRIPE
//  Retorna { success, paymentIntentId } o lanza error
// ════════════════════════════════════════════════════════════════════════════
async function _mostrarModalPago({ titulo, descripcion, monto, endpointIntento }) {

    // 1. Crear intento de pago en el servidor
    let clientSecret, paymentIntentId;
    try {
        const res  = await fetch(endpointIntento, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ tarjetaID: tarjetaID }) // ignorado por certificado
        });
        const data = await res.json();
        if (data.error) throw new Error(data.error);
        clientSecret  = data.clientSecret;
        paymentIntentId = clientSecret.split('_secret_')[0]; // extrae pi_xxx
    } catch (err) {
        throw new Error('No se pudo iniciar el pago: ' + err.message);
    }

    // 2. Montar Stripe Elements en un div temporal
    const stripeInstance = Stripe('pk_test_51RzULWPzFVL2ubLUEK6vHTCzHmw5ZKR7fIxywToZU62Hh6iG11Hok9sxeLPQDaMe75mlD5kQMrQarJSMw0LhYlAY00fkNYY5y7');
    const elementsInstance = stripeInstance.elements();
    const cardEl = elementsInstance.create('card', {
        style: {
            base: {
                fontSize: '16px',
                color: '#1F4E67',
                fontFamily: 'monospace',
                '::placeholder': { color: '#aab7c4' }
            }
        }
    });

    // 3. Construir el HTML del modal
    const modalHtml = `
        <div style="text-align:left;">
            <div style="background:#f0f4f8; border-radius:12px; padding:15px; margin-bottom:15px;">
                <div style="font-size:.82rem; color:#888; margin-bottom:4px; letter-spacing:.5px;">CONCEPTO</div>
                <div style="font-weight:700; color:#1F4E67; font-size:.95rem;">${descripcion}</div>
            </div>
            <div style="background:#f0f4f8; border-radius:12px; padding:15px; margin-bottom:20px; display:flex; justify-content:space-between; align-items:center;">
                <span style="font-size:.82rem; color:#888; letter-spacing:.5px;">TOTAL A PAGAR</span>
                <span style="font-weight:800; color:#1F4E67; font-size:1.4rem;">${monto}</span>
            </div>
            <div style="font-size:.78rem; color:#888; margin-bottom:8px; letter-spacing:.5px;">DATOS DE TARJETA</div>
            <div id="stripe-card-inline" style="
                border: 1.5px solid #dde3ea;
                border-radius: 10px;
                padding: 14px 16px;
                background: white;
                box-shadow: inset 0 1px 3px rgba(0,0,0,.06);
                transition: border-color .2s;
            "></div>
            <div id="stripe-error-inline" style="color:#d33; font-size:.82rem; margin-top:8px; min-height:18px;"></div>
            <div style="display:flex; align-items:center; gap:6px; margin-top:14px; color:#aaa; font-size:.75rem;">
                <i class="fas fa-lock"></i> Pago seguro procesado por Stripe
            </div>
        </div>`;

    // 4. Mostrar SweetAlert
    return new Promise((resolve, reject) => {
        Swal.fire({
            title: titulo,
            html: modalHtml,
            showCancelButton: true,
            confirmButtonText: '<i class="fas fa-lock mr-1"></i> Pagar ahora',
            cancelButtonText: 'Cancelar',
            confirmButtonColor: '#1F4E67',
            cancelButtonColor: '#d33',
            width: '420px',
            focusConfirm: false,
            didOpen: () => {
                // Montar el card element DESPUÉS de que el DOM esté listo
                cardEl.mount('#stripe-card-inline');
                cardEl.on('change', (e) => {
                    document.getElementById('stripe-error-inline').textContent =
                        e.error ? e.error.message : '';
                });
            },
            willClose: () => {
                cardEl.unmount();
            },
            preConfirm: async () => {
                Swal.showLoading();
                try {
                    const { paymentIntent, error } = await stripeInstance.confirmCardPayment(
                        clientSecret,
                        { payment_method: { card: cardEl } }
                    );
                    if (error) {
                        Swal.showValidationMessage(error.message);
                        return false;
                    }
                    if (paymentIntent.status !== 'succeeded') {
                        Swal.showValidationMessage('El pago no pudo completarse. Intenta nuevamente.');
                        return false;
                    }
                    return paymentIntent.id;
                } catch (err) {
                    Swal.showValidationMessage('Error al procesar el pago: ' + err.message);
                    return false;
                }
            }
        }).then(result => {
            if (result.isConfirmed && result.value) {
                resolve(result.value); // paymentIntentId
            } else {
                reject(new Error('cancelled'));
            }
        });
    });
}

// ════════════════════════════════════════════════════════════════════════════
//  COMPRAR CERTIFICADO ADICIONAL (CON VERIFICACIÓN DE ENVÍO)
// ════════════════════════════════════════════════════════════════════════════
async function comprarCertificadoAdicional() {
    try {
        // 1. Obtener próxima versión del certificado
        let nextVersion = '?';
        try {
            const vRes  = await fetch('/get-next-certificate-version', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ humanoID: '<%= humanoID %>' })
            });
            const vData = await vRes.json();
            nextVersion = vData.nextVersion || nextVersion;
        } catch (_) {}

        // 2. Extraer la dirección actual del perfil
        let direccionEnvio = '<%= direccion %>'.trim();
        let necesitaNuevaDireccion = false;

        // 3. LÓGICA DE DIRECCIÓN: Preguntar o forzar llenado
        if (direccionEnvio) {
            const confirmAddress = await Swal.fire({
                title: 'Verificación de envío',
                html: `
                    <div style="text-align:center; margin-bottom: 15px;">
                        <p>Estás a punto de generar tu <strong>${nextVersion}º certificado</strong> de registro humano.</p>
                        <p style="color:#1F4E67; font-size:1.2rem;"><strong>PRECIO: $100.00 MXN</strong></p>
                    </div>
                    <div style="background: #f8fafc; border-radius: 10px; padding: 15px; text-align: left; border: 1px solid #e2e8f0;">
                        <p style="margin-bottom: 5px; font-weight: bold; color: #1F4E67;"><i class="fas fa-truck mr-2"></i>Dirección registrada:</p>
                        <p style="margin-bottom: 0; font-size: 0.9rem;">${direccionEnvio}</p>
                    </div>
                    <p class="mt-3 mb-0" style="font-size: 0.95rem; font-weight: 500;">¿Deseas enviar el documento físico a esta dirección?</p>
                `,
                icon: 'question',
                showDenyButton: true,
                showCancelButton: true,
                confirmButtonText: 'Sí, enviar aquí',
                denyButtonText: 'Usar otra dirección',
                cancelButtonText: 'Cancelar',
                confirmButtonColor: '#28a745',
                denyButtonColor: '#1F4E67',
                cancelButtonColor: '#d33',
            });

            if (confirmAddress.isDismissed) return; // Canceló el proceso
            if (confirmAddress.isDenied) necesitaNuevaDireccion = true; // Eligió "Otra dirección"
        } else {
            const noAddressConfirm = await Swal.fire({
                title: 'Falta dirección de envío',
                html: `
                    <p>Para emitir tu <strong>${nextVersion}º certificado físico y digital</strong> (por <strong>$100.00 MXN</strong>), necesitamos saber a dónde enviarlo.</p>
                    <p>Actualmente no tienes una dirección registrada.</p>
                `,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'Ingresar dirección',
                cancelButtonText: 'Cancelar',
                confirmButtonColor: '#1F4E67',
                cancelButtonColor: '#d33'
            });
            
            if (!noAddressConfirm.isConfirmed) return; // Canceló
            necesitaNuevaDireccion = true;
        }

        // 4. FORMULARIO DE NUEVA DIRECCIÓN (Si aplica)
        if (necesitaNuevaDireccion) {
            const { value: formValues } = await Swal.fire({
                title: 'Dirección de Envío',
                html: `
                    <div class="text-left" style="font-size: 0.9rem;">
                        <div class="form-group mb-2">
                            <label class="font-weight-bold mb-1">Calle <span class="text-danger">*</span></label>
                            <input id="swal-calle" class="form-control form-control-sm" placeholder="Ej. Av. Reforma" required>
                        </div>
                        <div class="row">
                            <div class="col-6 form-group mb-2">
                                <label class="font-weight-bold mb-1">Nº Exterior <span class="text-danger">*</span></label>
                                <input id="swal-next" class="form-control form-control-sm" placeholder="Ej. 123" required>
                            </div>
                            <div class="col-6 form-group mb-2">
                                <label class="font-weight-bold mb-1">Nº Interior</label>
                                <input id="swal-nint" class="form-control form-control-sm" placeholder="Opcional">
                            </div>
                        </div>
                        <div class="form-group mb-2">
                            <label class="font-weight-bold mb-1">Colonia / C.P. <span class="text-danger">*</span></label>
                            <input id="swal-colonia" class="form-control form-control-sm" placeholder="Ej. Centro, 06000" required>
                        </div>
                        <div class="form-group mb-2">
                            <label class="font-weight-bold mb-1">Municipio / Alcaldía <span class="text-danger">*</span></label>
                            <input id="swal-municipio" class="form-control form-control-sm" placeholder="Ej. Cuauhtémoc" required>
                        </div>
                        <div class="form-group mb-0">
                            <label class="font-weight-bold mb-1">Estado <span class="text-danger">*</span></label>
                            <input id="swal-estado" class="form-control form-control-sm" placeholder="Ej. CDMX" required>
                        </div>
                    </div>
                `,
                focusConfirm: false,
                showCancelButton: true,
                confirmButtonText: 'Continuar',
                cancelButtonText: 'Cancelar',
                confirmButtonColor: '#1F4E67',
                preConfirm: () => {
                    const calle = document.getElementById('swal-calle').value.trim();
                    const next = document.getElementById('swal-next').value.trim();
                    const nint = document.getElementById('swal-nint').value.trim();
                    const colonia = document.getElementById('swal-colonia').value.trim();
                    const municipio = document.getElementById('swal-municipio').value.trim();
                    const estado = document.getElementById('swal-estado').value.trim();

                    // Validación
                    if (!calle || !next || !colonia || !municipio || !estado) {
                        Swal.showValidationMessage('Por favor, completa todos los campos marcados con *');
                        return false;
                    }

                    // Concatenar dirección final
                    let dir = `${calle} ${next}`;
                    if (nint) dir += ` Int. ${nint}`;
                    dir += `, Col. ${colonia}, ${municipio}, ${estado}`;
                    
                    return dir;
                }
            });

            if (!formValues) return; // Canceló en el formulario
            direccionEnvio = formValues;

            // PREGUNTAR SI DESEA GUARDARLA PERMANENTEMENTE
            const saveConfirm = await Swal.fire({
                title: '¿Actualizar perfil?',
                text: '¿Deseas guardar esta nueva dirección en tu perfil para futuros envíos o compras?',
                icon: 'question',
                showDenyButton: true,
                showCancelButton: true,
                confirmButtonText: 'Sí, guardar',
                denyButtonText: 'No, solo usar esta vez',
                cancelButtonText: 'Cancelar compra',
                confirmButtonColor: '#28a745',
                denyButtonColor: '#6c757d',
                cancelButtonColor: '#d33'
            });

            if (saveConfirm.isDismissed) return; // Canceló toda la operación

            if (saveConfirm.isConfirmed) {
                // Guardar la dirección en segundo plano
                Swal.fire({ title: 'Actualizando perfil...', allowOutsideClick: false, didOpen: () => Swal.showLoading() });
                try {
                    const updRes = await fetch('/updateDireccion', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ direccion: direccionEnvio })
                    });
                    const updData = await updRes.json();
                    if (updData.success) {
                        const dirLabel = document.getElementById('direccionLabel');
                        if (dirLabel) dirLabel.innerText = direccionEnvio;
                    }
                } catch (e) {
                    console.error('Error guardando dirección:', e);
                }
            }
        }

        // 5. PASAR A LA PASARELA DE PAGO (El flujo original continúa aquí)
        const paymentIntentId = await _mostrarModalPago({
            titulo: 'Pagar certificado',
            descripcion: `${nextVersion}º Certificado de registro humano`,
            monto: '$100.00 MXN',
            endpointIntento: '/crearIntentoPagoCertificado'
        });

        // 6. CONFIRMAR EN EL SERVIDOR Y EMITIR EL DOCUMENTO
        Swal.fire({ 
            title: 'Emitiendo certificado...', 
            html: `Preparando documento y coordinando envío físico a:<br><br><small><strong>${direccionEnvio}</strong></small>`, 
            allowOutsideClick: false, 
            didOpen: () => Swal.showLoading() 
        });

        const res  = await fetch('/confirmarPagoCertificadoInline', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ 
                paymentIntentId, 
                direccionEnvio: direccionEnvio // <-- ENVIAMOS LA DIRECCIÓN AQUÍ
            })
        });
        const data = await res.json();

        if (data.success) {
            await Swal.fire({
                icon: 'success',
                title: '¡Certificado generado!',
                html: `
                    <p>Tu <strong>${data.version}º certificado</strong> oficial ha sido emitido.</p>
                    <p>El documento físico con tecnología NFC será enviado a:<br><strong>${direccionEnvio}</strong></p>
                    <p class="text-muted small mt-3">Encuéntralo ya mismo en la sección <strong>Certificado</strong> del menú para su uso digital.</p>`,
                confirmButtonColor: '#28a745',
                confirmButtonText: 'Ver mis certificados'            
            });
            // Abrir directamente la lista de certificados
            document.getElementById('certificadoBtn').click();
        } else {
            throw new Error(data.error || 'Error al procesar y guardar el certificado.');
        }

    } catch (err) {
        if (err.message === 'cancelled') return;
        Swal.fire({ icon: 'error', title: 'Operación fallida', text: err.message, confirmButtonColor: '#1F4E67' });
    }
}

// ════════════════════════════════════════════════════════════════════════════
//  COMPRAR NUEVA TARJETA
// ════════════════════════════════════════════════════════════════════════════
async function comprarNuevaTarjeta() {
    try {
        // Verificar estado actual de la tarjeta
        Swal.fire({ title: 'Verificando tarjeta...', allowOutsideClick: false, didOpen: () => Swal.showLoading() });

        const estadoRes  = await fetch('/verificarEstado', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ humanoID: '<%= humanoID %>' })
        });
        const estadoData = await estadoRes.json();
        Swal.close();

        if (estadoData.estado === 'no-encontrado') {
            return Swal.fire('Error', 'Humano no encontrado.', 'error');
        }

        // Si la tarjeta está activa, pedir que la reporte primero
        if (estadoData.estado !== 'inactivo') {
            const reportConfirm = await Swal.fire({
                title: 'Reportar tarjeta actual',
                text: 'Para obtener una nueva tarjeta debes reportar la actual como inactiva. ¿Deseas continuar?',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'Sí, reportar y continuar',
                confirmButtonColor: '#1F4E67',
                cancelButtonColor: '#d33',
                cancelButtonText: 'Cancelar'
            });
            if (!reportConfirm.isConfirmed) return;

            Swal.fire({ title: 'Reportando...', allowOutsideClick: false, didOpen: () => Swal.showLoading() });
            await fetch('/actualizarEstado', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ humanoID: '<%= humanoID %>' })
            });
            Swal.close();
        }

        // Confirmar intención de compra
        const buyConfirm = await Swal.fire({
            title: '<i class="fas fa-id-card-alt mr-2"></i>Nueva tarjeta',
            html: `
                <div style="text-align:center;">
                    <p>Recibirás una nueva tarjeta física con activación digital.</p>
                    <p style="color:#1F4E67; font-size:1.2rem;"><strong>$500.00 MXN</strong></p>
                    <p class="text-muted small">Incluye envío y activación del perfil digital.</p>
                </div>`,
            icon: 'info',
            showCancelButton: true,
            confirmButtonText: 'Continuar al pago',
            cancelButtonText: 'Cancelar',
            confirmButtonColor: '#1F4E67',
            cancelButtonColor: '#d33'
        });
        if (!buyConfirm.isConfirmed) return;

        // Abrir modal de pago inline
        const paymentIntentId = await _mostrarModalPago({
            titulo: 'Pagar nueva tarjeta',
            descripcion: 'Tarjeta física + activación digital',
            monto: '$500.00 MXN',
            endpointIntento: '/crearIntentoPagoTarjeta'
        });

        // Confirmar en el servidor
        Swal.fire({ title: 'Procesando...', allowOutsideClick: false, didOpen: () => Swal.showLoading() });

        const confirmRes  = await fetch('/confirmarPagoTarjetaInline', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ paymentIntentId, tarjetaID: '<%= tarjetaID %>' })
        });
        const confirmData = await confirmRes.json();

        if (confirmData.success) {
            await Swal.fire({
                icon: 'success',
                title: '¡Pago exitoso!',
                text: 'Tu nueva tarjeta ha sido registrada. Pronto la recibirás en tu domicilio.',
                confirmButtonColor: '#1F4E67'
            });
            location.reload();
        } else {
            throw new Error(confirmData.error || 'Error al confirmar la tarjeta.');
        }

    } catch (err) {
        if (err.message === 'cancelled') return;
        Swal.fire({ icon: 'error', title: 'Error', text: err.message, confirmButtonColor: '#1F4E67' });
    }
}
</script>

<script>
    document.addEventListener('DOMContentLoaded', async () => {
        const urlParams = new URLSearchParams(window.location.search);
        const estadoPago = urlParams.get('estado_pago');

        if (estadoPago === 'exitoso') {
             Swal.fire({
                title: 'Pago Exitoso',
                text: 'Tu pago se ha completado con éxito. ¡Gracias por tu compra!',
                icon: 'success',
                 confirmButtonText: 'Aceptar',
                confirmButtonColor: '#1F4E67'
            }).then((result) => {
                if (result.isConfirmed) {
                    window.location.href = '/';
                }
            });
        } else if (estadoPago === 'cancelado') {
            Swal.fire({
                title: 'Pago Cancelado',
                text: 'Tu pago ha sido cancelado. Puedes intentar nuevamente más tarde.',
                icon: 'error',
                confirmButtonText: 'Aceptar',
                confirmButtonColor: '#d33'
            }).then((result) => {
                 if (result.isConfirmed) {
                    window.location.href = '/';
                }
             });
        }
    });
</script>

<script>
    async function eliminarPerfil() {
        // 1. PRIMERA ADVERTENCIA: DISEÑO DE ALTO IMPACTO
        const confirmResult = await Swal.fire({
            title: '<span style="color: #d71d00;  font-size: 1.8rem;">¡ADVERTENCIA!</span>',
            html: `
                <div style="text-align: center;">
                    <i class="fas fa-exclamation-triangle" style="font-size: 3rem; color: #d71d00; margin-bottom: 15px;"></i>
                    <p style="color: #333; font-weight: bold;">¿Estás seguro de que quieres eliminar tu perfil?</p>
                    <p style="color: #666; font-size: 0.9rem;">Esta acción es <b>permanente</b>. Se borrarán tus datos y tus tarjetas (física y digital) quedarán inoperativas de inmediato.</p>
                </div>
            `,
            showCancelButton: true,
            confirmButtonColor: "#d71d00", // Rojo acento para peligro
            cancelButtonColor: "#1F4E67",  // Azul corporativo para seguridad
            confirmButtonText: "Sí, eliminar perfil",
            cancelButtonText: "No, cancelar",
            background: "#ffffff",
            borderRadius: "25px",
            backdrop: `rgba(215, 29, 0, 0.2)` // Un ligero tinte rojo en el fondo
        });

        if (confirmResult.isConfirmed) {
            // 2. SEGUNDA ADVERTENCIA: CONFIRMACIÓN POR CONTRASEÑA
            const passwordResult = await Swal.fire({
                title: '<span style="color: #1F4E67; font-family: \'Iceland\', sans-serif;">VERIFICACIÓN FINAL</span>',
                text: "Introduce tu contraseña para confirmar la destrucción del perfil.",
                input: 'password',
                inputPlaceholder: 'Tu contraseña de seguridad',
                inputAttributes: { autocapitalize: 'off', autocorrect: 'off' },
                showCancelButton: true,
                confirmButtonColor: "#d71d00",
                cancelButtonColor: "#1F4E67",
                confirmButtonText: "CONFIRMAR ELIMINACIÓN",
                cancelButtonText: "VOLVER",
                background: "#ffffff",
                borderRadius: "25px",
                inputValidator: (value) => {
                    if (!value) return '¡La contraseña es obligatoria para este proceso!';
                }
            });

            if (passwordResult.isConfirmed) {
                try {
                    // Muestra un estado de "Procesando" con el estilo de tu marca
                    Swal.fire({
                        title: 'ELIMINANDO REGISTRO...',
                        allowOutsideClick: false,
                        didOpen: () => { Swal.showLoading(); }
                    });

                    const response = await fetch('/eliminarPerfil', {
                        method: 'DELETE',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ contrasena: passwordResult.value })
                    });

                    const data = await response.json();

                    if (data.success) {
                        Swal.fire({
                            icon: 'success',
                            title: '<span style="font-family: \'Iceland\';">PERFIL ELIMINADO</span>',
                            text: "Tu rastro ha sido borrado de Human System.",
                            showConfirmButton: false,
                            timer: 2500
                        }).then(() => {
                            window.location.href = '/login'; // Redirige al login tras borrar
                        });
                    } else {
                        Swal.fire({
                            icon: 'error',
                            title: 'FALLO EN LA VERIFICACIÓN',
                            text: data.error || 'La contraseña es incorrecta.',
                            confirmButtonColor: "#1F4E67"
                        });
                    }
                } catch (error) {
                    Swal.fire({
                        icon: 'error',
                        title: 'ERROR DE SISTEMA',
                        text: 'No se pudo completar la purga de datos.',
                        confirmButtonColor: "#1F4E67"
                    });
                }
            }
        }
    }
</script>

<script>
// Función para mostrar mensaje de éxito después de comprar certificado
document.addEventListener('DOMContentLoaded', function() {
    const urlParams = new URLSearchParams(window.location.search);
    const certificadoComprado = urlParams.get('certificado_comprado');
    const certificadoID = urlParams.get('certificadoID');
    const version = urlParams.get('version');

    if (certificadoComprado === 'true' && certificadoID) {
        Swal.fire({
            title: '<i class="fas fa-file-pdf mr-2" style="color: #28a745;"></i>¡Certificado Adicional Generado!',
            html: `
                <div style="text-align: center;">
                    <p>Tu nuevo certificado ha sido generado exitosamente.</p>
                    <p><strong>ID del certificado:</strong> ${certificadoID}</p>
                    <p><strong>Versión:</strong> ${version || 'Nueva'}</p>
                    <p class="text-muted">Puedes descargarlo desde el botón de "Certificado" en el menú principal.</p>
                </div>
            `,
            icon: 'success',
            confirmButtonText: '<i class="fas fa-check mr-1"></i>Aceptar',
            confirmButtonColor: '#28a745',
            timer: 5000
        }).then(() => {
            // Limpiar la URL para que no muestre el mensaje otra vez al recargar
            window.history.replaceState({}, document.title, window.location.pathname);
        });
    }
});
</script>

