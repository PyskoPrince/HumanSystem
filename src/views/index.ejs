<script>
    // --- MODIFICAR DESCRIPCIÓN ---
    document.getElementById('btnModificarDescripcion')?.addEventListener('click', function() {
      Swal.fire({
        title: '<i class="fas fa-user-edit ml-2"></i> Modifica tu descripción',
        html: '<textarea id="descripcionInput" class="swal2-textarea" maxlength="50" style="width: 100%;border-radius: 15px; border: 1.5px solid #4ca1af; padding: 12px; margin: 0; resize: none; box-sizing: border-box;"></textarea>' +
              '<div style="text-align: right; font-size: 12px; color: gray;"><span id="contadorCaracteres">0</span>/50 caracteres</div>',
        showCancelButton: true,
        confirmButtonText: 'Guardar',
        cancelButtonText: 'Cancelar',
        confirmButtonColor: '#1F4E67',
        cancelButtonColor: '#d33',
        didOpen: () => {
          const descripcionInput = document.getElementById('descripcionInput');
          const contadorCaracteres = document.getElementById('contadorCaracteres');
          // Limpiar espacios en blanco innecesarios al cargar
          descripcionInput.value = document.getElementById('descripcionUsuario').textContent.trim();
          contadorCaracteres.textContent = descripcionInput.value.length;
          descripcionInput.addEventListener('input', function() {
            contadorCaracteres.textContent = descripcionInput.value.length;
          });
        }
      }).then((result) => {
        if (result.isConfirmed) {
          const nuevaDescripcion = document.getElementById('descripcionInput').value.trim();
          const descripcionActual = document.getElementById('descripcionUsuario').textContent.trim();

          if (nuevaDescripcion === descripcionActual) {
            Swal.fire({
              icon: 'info',
              title: 'Sin cambios',
              text: 'La descripción es la misma.',
              showConfirmButton: false,
              timer: 2000
            });
            return;
          }

          // Función para ejecutar la actualización (evita repetir código)
          const ejecutarActualizacion = (desc) => {
            Swal.fire({
              title: desc === '' ? 'Eliminando...' : 'Modificando...',
              text: desc === '' ? 'Por favor, espera mientras eliminamos tu descripción.' : 'Por favor, espera mientras actualizamos tu descripción.',
              allowOutsideClick: false,
              allowEscapeKey: false,
              didOpen: () => Swal.showLoading()
            });

            jQuery.ajax({
              type: 'POST',
              url: '/updateDescripcion',
              data: { descripcion: desc },
              success: function(response) {
                Swal.close();
                if (response.success) {
                  document.getElementById('descripcionUsuario').textContent = desc;
                  Swal.fire({
                    icon: 'success',
                    title: desc === '' ? '¡Eliminada!' : '¡Guardado!',
                    text: desc === '' ? 'La descripción ha sido eliminada de tu perfil.' : 'La descripción ha sido modificada.',
                    showConfirmButton: false,
                    timer: 2000
                  });
                } else {
                  Swal.fire({
                    icon: 'error',
                    title: 'Error',
                    text: 'No se pudo actualizar la descripción.',
                    showConfirmButton: false,
                    timer: 2000
                  });
                }
              },
              error: function() {
                Swal.close();
                Swal.fire({
                  icon: 'error',
                  title: 'Error',
                  text: 'Hubo un error al modificar la descripción.',
                  showConfirmButton: false,
                  timer: 2000
                });
              }
            });
          };

          // Verificamos si la nueva descripción está vacía
          if (nuevaDescripcion === "") {
            Swal.fire({
              title: 'Eliminarás tu descripción',
              text: 'Tu descripción está vacía. ¿Deseas continuar y eliminarla por completo?',
              icon: 'warning',
              showCancelButton: true,
              confirmButtonColor: '#d33',
              cancelButtonColor: '#1F4E67',
              confirmButtonText: 'Sí, eliminar',
              cancelButtonText: 'Cancelar'
            }).then((confirmDelete) => {
              if (confirmDelete.isConfirmed) {
                ejecutarActualizacion(nuevaDescripcion);
              }
            });
          } else {
            // Si tiene contenido normal, procedemos directo
            ejecutarActualizacion(nuevaDescripcion);
          }
        }
      });
    });
</script>

<script>
