        idElem.style.position = 'absolute';
        idElem.style.top = '69%';
        idElem.style.left = '0';
        idElem.style.width = '100%';
        idElem.style.textAlign = 'center';
        idElem.style.fontWeight = 'bold';
        idElem.style.fontSize = '13px';
        idElem.style.color = '#1F4E67';
        idElem.style.fontFamily = 'Iceland, sans-serif';
        idElem.style.zIndex = '10';
