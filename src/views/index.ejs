    };

    const nombresRedes = {
        'personal': 'Página Personal',
        'whatsapp': 'WhatsApp',
        'instagram': 'Instagram',
        'facebook': 'Facebook',
        'youtube': 'YouTube',
        'linkedin': 'LinkedIn',
        'twitter': 'Twitter',
        'tiktok': 'TikTok'
    };

    // 2. Generar opciones HTML
    const opcionesHTML = Object.keys(iconMap).map(key => `
        <div class="opcion-red" data-value="${key}" data-icon="${iconMap[key]}" 
             style="padding: 12px; margin: 5px 0; cursor: pointer; border-radius: 8px; 
