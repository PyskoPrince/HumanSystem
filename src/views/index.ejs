            <span style="font-size: 1rem;">${nombresRedes[key]}</span>
        </div>
    `).join('');

    const htmlOptions = `
        <div style="text-align: center; padding: 10px;">
            <div id="contenedorIconoCentral" style="background: #f0f7fa; border-radius: 50%; width: 80px; height: 80px; margin: 0 auto 20px auto; display: flex; align-items: center; justify-content: center;">
                <span id="swalIconWrapper">
                    <i id="swalIconRef" class="fas fa-user" style="font-size: 3rem; color: #1F4E67; transition: all 0.3s;"></i>
                </span>
            </div>
            <div style="font-size: 1.1rem; color: #1F4E67; margin-bottom: 15px; font-weight: 500;">
             Selecciona una red social:
            </div>
            <div id="selectorRedesPersonalizado" style="width: 100%; max-height: 300px; overflow-y: auto; border-radius: 12px; padding: 5px;">
                <div id="opcionesRedes" style="text-align: left;">
                    ${opcionesHTML}
                </div>
            </div>
            <input type="hidden" id="selectRedSocial" value="personal">
        </div>
        <style>
            .opcion-red { 
                transition: all 0.3s ease; 
                border-left: 4px solid transparent; 
            }
            .opcion-red:hover { 
                background-color: #e3f2fd !important; 
                border-left: 4px solid #1F4E67 !important; 
                transform: translateX(5px); 
                box-shadow: 0 2px 8px rgba(0,0,0,0.1); 
            }
            .opcion-red.seleccionada { 
                background: linear-gradient(90deg, #e1f0f5 0%, #f0f7fa 100%); 
                border-left: 4px solid #1F4E67 !important; 
                font-weight: 500; 
            }
            #selectorRedesPersonalizado::-webkit-scrollbar { 
                width: 8px; 
            }
            #selectorRedesPersonalizado::-webkit-scrollbar-thumb { 
                background: #1F4E67; 
                border-radius: 10px; 
            }
        </style>
    `;

    Swal.fire({
        title: '<i class="fas fa-link" style="margin-right: 8px;"></i>Modifica tus enlaces',
        html: htmlOptions,
        confirmButtonText: 'Continuar',
        confirmButtonColor: '#1F4E67',
        showCloseButton: true,
        width: '500px',
        didOpen: () => {
            const popup = Swal.getPopup();
            const wrapper = popup.querySelector('#swalIconWrapper');
            const opciones = popup.querySelectorAll('.opcion-red');
            const hiddenInput = popup.querySelector('#selectRedSocial');
            
            let iconoSeleccionado = 'fas fa-user';

            // Función para cambiar icono (solución clave)
            const actualizarIcono = (claseIcono) => {
                wrapper.innerHTML = `<i class="${claseIcono}" style="font-size: 3rem; color: #1F4E67; transition: all 0.3s;"></i>`;
            };

            // Marcar selección inicial
            const opcionInicial = popup.querySelector('.opcion-red[data-value="personal"]');
