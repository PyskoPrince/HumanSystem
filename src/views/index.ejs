<%- include('partials/header', { title: 'Home', pageClass: 'page-index' }) %>
<% if (login) { %>

    <style>
        /* Definición de variables de color basadas en tu código */
        :root {
            --hs-dark: #0a0e14;
            --hs-blue: #1a2a6c;
            --hs-cyan: #4ca1af;
            --hs-red: #f44336; /* Color para el láser y acentos */
        }

        #contenedorPrincipal {
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.2);
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }
        
        .social-link {
            transition: transform 0.2s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        }
        
        .social-link:hover {
            transform: translateY(-5px) scale(1.2);
        }

        .blurred {
            filter: blur(8px) grayscale(100%); 
            transition: filter 0.3s ease;
            user-select: none; 
        }

        .switch {
            position: relative;
            display: inline-block;
            width: 60px;
            height: 34px;
            margin-left: 10px;
        }

        .switch input {
            display: none;
        }

        .slider {
            position: absolute;
            cursor: pointer;
            top: 0; 
            left: 0;
            right: 0;
            bottom: 0;
            background-color: #ccc;
            transition: 0.4s;
            border-radius: 34px;
        }

        .slider:before {
            position: absolute;
            content: "";
            height: 26px;
            width: 26px;
            left: 4px;
            bottom: 4px;
            background-color: white;
            transition: 0.4s;
            border-radius: 50%;
        }

        input:checked + .slider {
            background-color: #1F4E67;
        }

        input:checked + .slider:before {
            transform: translateX(26px);
        }

        .social-links-container {
            display: flex;
            justify-content: center;
            flex-wrap: wrap;
            gap: 10px;
        }

        .custom-btn {
            border-radius: 30px;
        }

        .id-card-overlay-text {
            position: absolute;
            text-align: center;
            width: 100%;
            font-weight: bold;
        }

        /* ========== MEJORAS RESPONSIVAS ========== */

    /* Busca este bloque y déjalo así */
#perfilImg {
    width: min(200px, 35vw);
    height: min(200px, 35vw);
    min-width: 180px;
    min-height: 180px;
    max-width: 200px;
    max-height: 200px;
    object-fit: cover;
    transition: all 0.3s ease;
    /* Quitamos border y border-radius de aquí */
}

/* Agrega esta nueva clase justo debajo */
.img-circular {
    border-radius: 50%;
    border: 3px solid #1F4E67;
}
        /* Contenedor principal - mejor padding en móvil */
        #contenedorPrincipal {
            padding: 16px !important;
        }

        /* Pantallas GRANDES (≥ 1300px) - Dos columnas visibles */
        @media (min-width: 1300px) {
    /* No forzar display block de todas las secciones (lo maneja JS) */
    /* La clase .hidden-section se controla con JS */
    
    /* Asegurar que la columna de perfil siempre se muestre */
    #colPerfilContainer {
        display: block !important;
    }
    
    /* Opcional: mejorar espaciado */
    #contenedorPrincipal .row {
        flex-wrap: nowrap;
    }
}


        /* Pantallas PEQUEÑAS (< 1300px) - Modo móvil con pestañas */
        @media (max-width: 1299px) {
            #contenedorPrincipal {
                padding: 12px !important;
            }
            
            /* ¡LA MAGIA AQUÍ! Forzamos a que las columnas tomen el 100% del ancho en iPad/Móviles */
           #colPerfilContainer, #colConfigContainer {
        flex: 0 0 100% !important;
        max-width: 100% !important;
    }

            /* Las tarjetas internas mejoran su padding */
            .hidden-section {
                padding: 20px 16px !important;
            }

            /* Títulos más pequeños */
            .header-title {
                font-size: 2.0rem !important;
            }
            
            /* Botones de configuración mejor espaciados */
            .form-group .input-group {
                flex-wrap: nowrap;
            }
            
            .form-group .input-group button {
                white-space: nowrap;
                padding-left: 12px;
                padding-right: 12px;
            }
            
            /* Contenedor de enlaces sociales */
            .social-links-container {
                gap: 8px;
            }
            
            .social-link {
                font-size: 18px !important;
                padding: 4px;
            }
            
            /* Imagen de perfil más pequeña en móvil */
            #perfilImg {
                width: 180px;
                height: 180px;
            }
            
            /* Cards de configuración */
            .card-body {
                padding: 16px 8px !important;
            }
            
            .card-body h6 {
                font-size: 0.85rem;
            }
            
            .card-body .small {
                font-size: 0.7rem;
            }
            
            /* Switch más pequeño */
            .switch {
                width: 50px;
                height: 28px;
            }
            
            .slider:before {
                height: 22px;
                width: 22px;
            }
            
            input:checked + .slider:before {
                transform: translateX(22px);
            }
        }

        /* Asegurar que el texto no se desborde */
        #descripcionUsuario {
            word-break: break-word;
            overflow-wrap: break-word;
            max-width: 100%;
        }
    </style>

    <nav class="navbar navbar-expand-lg navbar-light bg-white sticky-top">
        <a class="navbar-brand" href="#">
            <img src="https://i.ibb.co/G3XDtMJ/Logoapp.png" alt="Logo Human System" class="brand-logo" style="height: 60px; border-radius: 20%;">
        </a>
        <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
            <div class="hamburger">
                <div class="line"></div>
                <div class="line"></div>
                <div class="line"></div>
            </div>
        </button>
        <div class="collapse navbar-collapse" id="navbarNav">
            <ul class="navbar-nav ml-auto align-items-center">
                <li class="nav-item mt-2">
                    <a class="nav-link info" id="perfilBtn">
                        <i class="fas fa-user mr-1" style="color:white;"></i>
                        <span style="color:white;">Perfil</span>
                    </a>
                </li>
                <li class="nav-item mt-2">
                    <a class="nav-link ingreso" id="idCardIcon">
                        <i class="fas fa-id-card mr-1" style="color:white;"></i>
                        <span style="color:white;">Identificación</span>
                    </a>
                </li>
                <li class="nav-item mt-2">
                    <a class="nav-link ingreso" id="certificadoBtn">
                        <i class="fas fa-file-alt mr-1" style="color:white;"></i>
                        <span style="color:white;">Certificado</span>
                    </a>
                </li>
                <li class="nav-item mt-2">
                    <a class="nav-link ingreso" id="billeteraBtn">
                        <i class="fas fa-wallet mr-1" style="color:white;"></i>
                        <span style="color:white;">Billetera</span>
                    </a>
                </li>
                <li class="nav-item mt-2">
                    <a class="nav-link info" id="configuracionBtn">
                        <i class="fas fa-cog mr-1" style="color:white;"></i>
                        <span style="color:white;">Configuración</span>
