                            Swal.fire('Error', data.error || 'No se pudo procesar la solicitud', 'error');
                        }
                    })
                    .catch(error => {
                        Swal.fire('Error', 'Ocurrió un error al actualizar la tarjeta. Intente nuevamente.', 'error');
          
                     });
            }
        });
    }

