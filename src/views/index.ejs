                if (!dest.startsWith('HUM-')) { Swal.showValidationMessage('ID de humano inválido (debe empezar con HUM-)'); return false; }
                if (!monto || monto < 1)      { Swal.showValidationMessage('Monto mínimo: 1 HC'); return false; }
