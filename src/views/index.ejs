        if (!form) return;

        // ── Vector Search: detectar si ya enviaste algo similar ──────────────────
        Swal.fire({ title: 'Verificando transacción...', allowOutsideClick: false, didOpen: () => Swal.showLoading() });

        const vecRes  = await fetch('/billetera/buscar-similar', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
