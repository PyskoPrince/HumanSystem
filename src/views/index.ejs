            const popup = Swal.getPopup();
            const hiddenInput = popup.querySelector('#selectRedSocial');
            const selectedValue = hiddenInput.value;
            
            const opcionSeleccionada = popup.querySelector(`.opcion-red[data-value="${selectedValue}"]`);
            const iconClass = opcionSeleccionada ? opcionSeleccionada.dataset.icon : 'fas fa-user';
            
            return { 
                seleccion: selectedValue, 
                iconClass: iconClass 
            };
        }
    }).then((result) => {
        if (result.isConfirmed && result.value) {
            const { seleccion, iconClass } = result.value;
            solicitarValorEnlace(seleccion, iconClass);
        }
    });
});

// Función para el segundo paso
function solicitarValorEnlace(seleccion, iconClass) {
    const baseUrls = {
        'personal': '', 
        'whatsapp': 'https://wa.me/', 
        'instagram': 'https://www.instagram.com/',
        'facebook': 'https://www.facebook.com/', 
        'youtube': 'https://www.youtube.com/',
        'linkedin': 'https://www.linkedin.com/', 
        'twitter': 'https://www.twitter.com/', 
        'tiktok': 'https://www.tiktok.com/@'
    };

    const config = {
        'personal': {
            titulo: 'URL de tu página personal',
            placeholder: 'https://www.tusitio.com'
        },
        'whatsapp': {
            titulo: 'Número de WhatsApp',
            placeholder: '5212345678901'
        }
    };

    const titulo = config[seleccion]?.titulo || `Usuario de ${seleccion}`;
    const placeholder = config[seleccion]?.placeholder || 'Nombre de usuario';

    Swal.fire({
        title: titulo,
        html: `<div style="text-align: center; margin: 15px 0;">
                <i class="${iconClass}" style="font-size: 3rem; color: #1F4E67;"></i>
               </div>`,
        input: 'text',
        inputPlaceholder: placeholder,
        confirmButtonColor: '#1F4E67',
        showCancelButton: true,
        cancelButtonText: 'Cancelar',
        confirmButtonText: 'Guardar'
    }).then((inputResult) => {
        if (inputResult.isConfirmed) {
            let inputValue = inputResult.value.trim();
            
            if (!inputValue) {
                manejarEliminacionEnlace(seleccion);
            } else {
                let fullUrl;
                if (seleccion === 'personal') {
                    fullUrl = inputValue.startsWith('http') ? inputValue : 'https://' + inputValue;
                } else if (seleccion === 'whatsapp') {
                    fullUrl = `https://wa.me/${inputValue.replace(/\D/g, '')}`;
                } else {
                    const usuario = inputValue.replace(/^@/, '').replace(/^(https?:\/\/)?(www\.)?/, '');
                    fullUrl = `${baseUrls[seleccion]}${usuario}`;
                }

                ejecutarUpdate(seleccion, fullUrl, null);
            }
        }
    });
}

// Función para enviar al servidor
function ejecutarUpdate(seleccion, url, pass) {
    Swal.fire({
        title: url === '' ? 'Eliminando...' : 'Actualizando...',
        allowOutsideClick: false,
        didOpen: () => Swal.showLoading()
    });

    fetch('/updateSocialLinks', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
            socialLinks: { [seleccion]: url },
            contrasena: pass
        })
    })
    .then(response => {
        if (!response.ok) {
            throw new Error(`HTTP error! status: ${response.status}`);
        }
        return response.json();
    })
    .then(data => {
        Swal.close();
        if (data.success) {
            Swal.fire({ 
                icon: 'success', 
                title: '¡Hecho!', 
                text: url === '' ? 'Enlace eliminado' : 'Enlace actualizado',
                showConfirmButton: false, 
                timer: 1500 
            }).then(() => location.reload());
        } else {
            Swal.fire('Error', data.error || 'No se pudo realizar la acción', 'error');
        }
    })
    .catch(err => {
        Swal.close();
        Swal.fire('Error', 'Problema de conexión con el servidor', 'error');
        console.error('Error:', err);
    });
}

// Función de eliminación con contraseña
function manejarEliminacionEnlace(seleccion) {
    Swal.fire({
        title: `¿Eliminar enlace de ${seleccion}?`,
        text: "Esta acción no se puede deshacer.",
        icon: 'warning',
        showCancelButton: true,
        confirmButtonText: 'Sí, eliminar',
        confirmButtonColor: '#d33',
        cancelButtonColor: '#1F4E67',
    }).then((result) => {
        if (result.isConfirmed) {
            Swal.fire({
                title: 'Confirma tu contraseña',
                input: 'password',
                inputPlaceholder: 'Ingresa tu contraseña',
                showCancelButton: true,
                confirmButtonColor: '#1F4E67',
                preConfirm: (pass) => {
                    if (!pass) {
                        Swal.showValidationMessage('Contraseña requerida');
                        return false;
                    }
                    return pass;
                }
            }).then((passResult) => {
                if (passResult.isConfirmed && passResult.value) {
                    ejecutarUpdate(seleccion, '', passResult.value);
                }
            });
        }
    });
}
</script>

