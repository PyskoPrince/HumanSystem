    <div id="loading" style="display: none;">Cargando...</div>
    <img id="imagenOriginal1" src="https://storage.googleapis.com/humansystem/HUMAN%20ID%20FRENTE.png" style="display: none;">
    <img id="imagenFrente1" src="<%= fotoPerfilUrl %>" style="display: none;">

<script>
    // ════════════════════════════════════════════════════════════════════════════
    //  BILLETERA HUMANA — CLIENT LOGIC
    // ════════════════════════════════════════════════════════════════════════════

    let hwPagina = 1;

    // ── Cargar transacciones al abrir la sección ─────────────────────────────────
    document.getElementById('billeteraBtn')?.addEventListener('click', function () {
        cargarTransacciones();
        cargarPreciosCripto();
    });

    async function cargarTransacciones(pagina = 1) {
        const lista = document.getElementById('hwTxnList');
        if (pagina === 1) {
            lista.innerHTML = `<div class="text-center py-3" style="color:rgba(255,255,255,0.3);">
                <i class="fas fa-spinner fa-spin"></i></div>`;
        }

        try {
            const res  = await fetch('/billetera/historial', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ pagina, limite: 10 })
            });
            const data = await res.json();
            hwPagina = pagina;

            if (!data.transacciones || data.transacciones.length === 0) {
                if (pagina === 1) {
                    lista.innerHTML = `<div class="text-center py-4" style="color:rgba(255,255,255,0.3);">
                        <i class="fas fa-inbox fa-2x d-block mb-2"></i>
                        Sin movimientos aún. ¡Realiza tu primer depósito!
                    </div>`;
                }
                return;
            }

            const html = data.transacciones.map(t => renderTxnItem(t)).join('');
            if (pagina === 1) {
                lista.innerHTML = html;
            } else {
                lista.insertAdjacentHTML('beforeend', html);
            }
        } catch (err) {
            if (pagina === 1) {
                lista.innerHTML = `<div class="text-center py-3" style="color:#ff6b6b;">
                    Error al cargar movimientos</div>`;
            }
        }
    }

    function cargarMasTransacciones() {
        cargarTransacciones(hwPagina + 1);
    }

    function renderTxnItem(t) {
        const esPositivo = t.monto > 0;
        const iconMap = {
            deposito:        { icon: 'fas fa-arrow-down',    bg: 'rgba(40,167,69,0.2)',   color: '#5dd87e' },
            retiro:          { icon: 'fas fa-arrow-up',      bg: 'rgba(215,29,0,0.2)',    color: '#ff6b6b' },
            transferencia:   { icon: 'fas fa-exchange-alt',  bg: 'rgba(31,78,103,0.4)',   color: '#8fa8ff' },
            compra_humancoin:{ icon: 'fas fa-coins',         bg: 'rgba(252,196,4,0.2)',   color: '#fcc404' },
            compra_cripto:   { icon: 'fas fa-bitcoin',       bg: 'rgba(100,130,255,0.2)', color: '#8fa8ff' },
        };
        const i = iconMap[t.tipo] || { icon: 'fas fa-circle', bg: 'rgba(255,255,255,0.1)', color: 'white' };
        const fecha = new Date(t.fechaCreacion).toLocaleDateString('es-MX', { day:'2-digit', month:'short', hour:'2-digit', minute:'2-digit' });
        const montoClass = esPositivo ? 'hw-txn-positivo' : 'hw-txn-negativo';
        const signo = esPositivo ? '+' : '';

        return `
        <div class="hw-txn-item">
            <div class="hw-txn-icon" style="background:${i.bg}; color:${i.color};">
                <i class="${i.icon}"></i>
            </div>
            <div class="flex-grow-1 mx-3">
                <div style="font-weight:600; font-size:.88rem; color:white;">
                    ${t.descripcion || t.tipo}
                </div>
                <div style="font-size:.72rem; color:rgba(255,255,255,0.4);">
                    ${fecha} · <span style="text-transform:uppercase; letter-spacing:.5px;">${t.estado}</span>
                </div>
            </div>
            <div class="text-right">
                <div class="${montoClass}" style="font-weight:800; font-family:monospace;">
                    ${signo}${Math.abs(t.monto).toFixed(2)} ${t.moneda}
                </div>
                ${t.montoDest ? `<div style="font-size:.7rem; color:rgba(255,255,255,0.35);">→ ${t.montoDest} ${t.monedaDest}</div>` : ''}
            </div>
        </div>`;
    }

    // ── Cambiar Tab ───────────────────────────────────────────────────────────────
    function hwCambiarTab(tab, btn) {
        document.querySelectorAll('.hw-tab').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');

        document.getElementById('hwTabFiat').style.display    = tab === 'fiat'    ? 'block' : 'none';
        document.getElementById('hwTabCripto').style.display  = tab === 'cripto'  ? 'block' : 'none';
        document.getElementById('hwTabTarjeta').style.display = tab === 'tarjeta' ? 'block' : 'none';

        if (tab === 'cripto') cargarPreciosCripto();
    }

    // ── Copiar dirección ETH ──────────────────────────────────────────────────────
    function copiarDireccionETH(addr) {
        navigator.clipboard.writeText(addr).then(() => {
            Swal.fire({
                icon: 'success',
                title: '¡Copiado!',
                text: 'Dirección ETH copiada al portapapeles.',
                timer: 1800,
                showConfirmButton: false
            });
        });
    }

    // ── Precios cripto live (CoinGecko público) ───────────────────────────────────
    async function cargarPreciosCripto() {
        try {
            const r = await fetch(
                'https://api.coingecko.com/api/v3/simple/price?ids=ethereum,bitcoin&vs_currencies=usd,mxn&include_24hr_change=true'
            );
            const d = await r.json();

            if (d.ethereum) {
                document.getElementById('precioETH').textContent  = `$${d.ethereum.usd?.toLocaleString()} USD`;
                document.getElementById('cambioETH').textContent  = `${d.ethereum.usd_24h_change?.toFixed(2)}%`;
                document.getElementById('cambioETH').style.color  = d.ethereum.usd_24h_change >= 0 ? '#5dd87e' : '#ff6b6b';
                document.getElementById('rateETHUSD').textContent = `$${d.ethereum.usd?.toLocaleString()}`;
            }
            if (d.bitcoin) {
                document.getElementById('precioBTC').textContent  = `$${d.bitcoin.usd?.toLocaleString()} USD`;
                document.getElementById('cambioBTC').textContent  = `${d.bitcoin.usd_24h_change?.toFixed(2)}%`;
                document.getElementById('cambioBTC').style.color  = d.bitcoin.usd_24h_change >= 0 ? '#5dd87e' : '#ff6b6b';
                document.getElementById('rateBTCUSD').textContent = `$${d.bitcoin.usd?.toLocaleString()}`;
            }
            // USD/MXN aproximado
            if (d.bitcoin?.mxn && d.bitcoin?.usd) {
                const fx = (d.bitcoin.mxn / d.bitcoin.usd).toFixed(2);
                document.getElementById('rateUSDMXN').textContent = `$${fx}`;
            }
        } catch (_) { /* falla silenciosamente */ }
    }

    // ════════════════════════════════════════════════════════════════════════════
    //  MODALES DE OPERACIONES
    // ════════════════════════════════════════════════════════════════════════════

    // ── Depositar MXN ─────────────────────────────────────────────────────────────
    async function abrirDepositarMXN() {
        const { value: monto } = await Swal.fire({
            title: '<i class="fas fa-arrow-down mr-2" style="color:#5dd87e;"></i>Depositar MXN',
            html: `
                <div style="text-align:left; margin-bottom:10px;">
                    <label style="font-size:.82rem; color:#666; letter-spacing:.5px;">MONTO A DEPOSITAR</label>
                    <div class="input-group mt-1">
                        <div class="input-group-prepend">
                            <span class="input-group-text" style="background:#f8fafc;">$</span>
                        </div>
                        <input id="swal-monto" type="number" class="form-control" 
                               placeholder="100.00" min="10" step="0.01" style="border-radius:0 8px 8px 0;">
                    </div>
                    <small class="text-muted">Mínimo $10 MXN</small>
                </div>
                <div style="display:grid; grid-template-columns:repeat(4,1fr); gap:8px; margin-top:10px;">
                    <button type="button" class="btn btn-sm btn-outline-secondary" style="border-radius:8px;" onclick="document.getElementById('swal-monto').value=100">$100</button>
                    <button type="button" class="btn btn-sm btn-outline-secondary" style="border-radius:8px;" onclick="document.getElementById('swal-monto').value=250">$250</button>
                    <button type="button" class="btn btn-sm btn-outline-secondary" style="border-radius:8px;" onclick="document.getElementById('swal-monto').value=500">$500</button>
                    <button type="button" class="btn btn-sm btn-outline-secondary" style="border-radius:8px;" onclick="document.getElementById('swal-monto').value=1000">$1,000</button>
                </div>`,
            showCancelButton: true,
            confirmButtonText: 'Continuar al pago',
            confirmButtonColor: '#28a745',
            cancelButtonColor: '#1F4E67',
            preConfirm: () => {
                const v = parseFloat(document.getElementById('swal-monto').value);
                if (!v || v < 10) { Swal.showValidationMessage('Mínimo $10 MXN'); return false; }
                return v;
            }
        });

        if (!monto) return;

        // Mostrar modal de pago Stripe inline
        try {
            const paymentIntentId = await _mostrarModalPago({
                titulo:          'Depositar a Billetera Humana',
                descripcion:     `Depósito de $${monto} MXN`,
                monto:           `$${monto} MXN`,
                endpointIntento: '/billetera/intento-deposito',
                extraBody:       { monto }
            });

            Swal.fire({ title: 'Confirmando depósito...', allowOutsideClick: false, didOpen: () => Swal.showLoading() });

            const res  = await fetch('/billetera/confirmar-deposito', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ paymentIntentId, descripcion: `Depósito $${monto} MXN` })
            });
            const data = await res.json();

            if (data.success) {
                await Swal.fire({
                    icon: 'success',
                    title: '¡Depósito exitoso!',
                    html: `<p>Se acreditaron <strong>$${monto} MXN</strong> a tu billetera.</p>
                           <p class="text-muted small">ID: ${data.transaccionID}</p>`,
                    confirmButtonColor: '#28a745'
                });
                location.reload();
            } else {
                throw new Error(data.error);
            }
        } catch (err) {
            if (err.message === 'cancelled') return;
            Swal.fire({ icon: 'error', title: 'Error', text: err.message, confirmButtonColor: '#1F4E67' });
        }
    }

    // ── Transferir HumanCoins ─────────────────────────────────────────────────────
    async function abrirTransferir() {
        const { value: form } = await Swal.fire({
            title: '<i class="fas fa-exchange-alt mr-2" style="color:#8fa8ff;"></i>Transferir',
