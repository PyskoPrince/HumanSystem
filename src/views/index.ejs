        mainContentBack.style.flexDirection = 'row';
        mainContentBack.style.justifyContent = 'space-between';
        mainContentBack.style.alignItems = 'center';
        mainContentBack.style.flexGrow = '1';
        mainContentBack.style.padding = '0 20px';

        // QR izquierda
        const leftSide = document.createElement('div');
        const qrImg = document.createElement('img');
