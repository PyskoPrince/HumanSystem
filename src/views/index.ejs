<script>
  document.addEventListener('DOMContentLoaded', function() {
    const navLinks = document.querySelectorAll('.nav-link');
    const sections = document.querySelectorAll('.hidden-section');
    const perfilBtn = document.getElementById('perfilBtn');
    const configuracionBtn = document.getElementById('configuracionBtn');
    const billeteraBtn = document.getElementById('billeteraBtn');
    
    const perfilLi = perfilBtn ? perfilBtn.closest('li') : null;
    const configuracionLi = configuracionBtn ? configuracionBtn.closest('li') : null;
    const billeteraLi = billeteraBtn ? billeteraBtn.closest('li') : null;
    
    let activeSection = 'seccionPerfil';   // Solo se usa en móvil
    let rightActiveSection = 'seccionBilletera'; // Se usa en escritorio (columna derecha)

    function isLargeScreen() {
        return window.matchMedia("(min-width: 1300px)").matches;
    }

    function updateUI() {
        const large = isLargeScreen();
        
        if (large) {
            // --- ESCRITORIO: perfil fijo a la izquierda, derecha alterna entre wallet y config ---
            // Mostrar siempre la sección de perfil
            document.getElementById('seccionPerfil').style.display = 'block';
            // Ocultar / mostrar según rightActiveSection
            document.getElementById('seccionBilletera').style.display = rightActiveSection === 'seccionBilletera' ? 'block' : 'none';
            document.getElementById('seccionConfiguracion').style.display = rightActiveSection === 'seccionConfiguracion' ? 'block' : 'none';
            
            // Ajustar botones del navbar: ocultar Perfil, mostrar Billetera y Configuración
            if (perfilLi) perfilLi.style.display = 'none';
            if (configuracionLi) configuracionLi.style.display = 'block';
            if (billeteraLi) billeteraLi.style.display = 'block';
        } else {
            // --- MÓVIL: solo una sección visible a la vez (perfil, wallet o config) ---
            sections.forEach(s => {
                if (s.id === activeSection) {
                    s.style.display = 'block';
                } else {
                    s.style.display = 'none';
                }
            });
            
            // Mostrar los tres botones en el navbar
            if (perfilLi) perfilLi.style.display = 'block';
            if (configuracionLi) configuracionLi.style.display = 'block';
            if (billeteraLi) billeteraLi.style.display = 'block';
        }
    }

    // Manejadores de click
    navLinks.forEach((link) => {
        link.addEventListener('click', function(e) {
            const targetId = this.getAttribute('id');
            const large = isLargeScreen();
            
            if (large) {
                // En escritorio, solo se alterna entre billetera y configuración
                if (targetId === 'billeteraBtn') {
                    rightActiveSection = 'seccionBilletera';
                    updateUI();
                } else if (targetId === 'configuracionBtn') {
                    rightActiveSection = 'seccionConfiguracion';
                    updateUI();
                }
                // Los botones de ID Card, Certificado y Salir no afectan la visibilidad
            } else {
                // En móvil, se alterna entre las tres secciones
                if (targetId === 'perfilBtn') {
                    activeSection = 'seccionPerfil';
                    updateUI();
                } else if (targetId === 'billeteraBtn') {
                    activeSection = 'seccionBilletera';
                    updateUI();
                } else if (targetId === 'configuracionBtn') {
                    activeSection = 'seccionConfiguracion';
                    updateUI();
                }
            }
        });
    });

    // Inicializar y escuchar cambios de tamaño
    updateUI();
    window.addEventListener('resize', updateUI);
});
</script>

<script>
    // Usamos nombres de variables únicos para evitar el error "Identifier has already been declared"
    var srcImagenTarjetaBase = document.getElementById('imagenOriginal1').src;
    var srcFotoPerfilUsuario = document.getElementById('imagenFrente1').src;
    var idHumanoGlobal = '<%= humanoID %>';
    var nombreHumanoGlobal = '<%= nombre %>';
    var firmaDigitalUrl = '<%= firmaDigitalUrl %>';
    var qrCodeTarjetaUrl = '<%= qrCodeTarjeta %>';
    var tarjetaID = '<%= tarjetaID %>';
    
    // Calcular fecha de vencimiento (3 años después de la fecha actual)
    function calcularFechaVencimiento() {
        const fecha = new Date();
        const año = fecha.getFullYear() + 3;
        const mes = fecha.getMonth() + 1;
        return `${mes.toString().padStart(2, '0')}/${año.toString().slice(-2)}`;
    }
    var fechaVencimiento = calcularFechaVencimiento();

    var numeroTarjetaFormateado = '<%= numeroTarjeta %>';
    var fechaVencimiento = '<%= fechaVencimiento %>';
    var titularTarjeta = '<%= titularTarjeta %>';

    function mostrarSweetAlert() {
        Swal.fire({
            title: 'Cargando tarjeta <i class="fas fa-id-card ml-2"></i>',
            text: 'Por favor, espera mientras encontramos tu tarjeta.',
            allowOutsideClick: false,
            allowEscapeKey: false,
            didOpen: () => {
                Swal.showLoading();
            }
        });

        fetch('/verificarEstado', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ humanoID: idHumanoGlobal })
        })
        .then(response => response.json())
        .then(data => {
            if (data.estado === 'inactivo') {
                Swal.close(); 
                return Swal.fire({
                    title: '<i class="fas fa-exclamation-triangle mr-2"></i>Tarjeta inactiva',
                    text: 'Lo sentimos, esta tarjeta ya se reportó como perdida.',
                    icon: 'warning',
                    showConfirmButton: false,
                    timer: 3000
                });
            } else {
                lanzarTarjeta3D();
            }
        })
        .catch(error => {
            console.error('Error al preparar la tarjeta:', error);
            Swal.close();
            Swal.fire({
                title: 'Error',
                text: 'No se pudo cargar la tarjeta. Por favor, intenta nuevamente.',
                icon: 'error',
                confirmButtonText: 'OK',
                confirmButtonColor: '#1F4E67'
            });
        });
    }

    function lanzarTarjeta3D() {
        let mostrarFrente = true;

        const cardContainer = document.createElement('div');
        cardContainer.style.perspective = '1000px';
        cardContainer.style.width = '100%';
        cardContainer.style.maxWidth = '280px';
        cardContainer.style.margin = '0 auto';
        cardContainer.style.cursor = 'pointer';
        
        const cardInner = document.createElement('div');
        cardInner.style.position = 'relative';
        cardInner.style.width = '100%';
        cardInner.style.paddingBottom = '140%'; // Proporción vertical estricta (Alto = 1.4 * Ancho)
        cardInner.style.transition = 'transform 0.8s cubic-bezier(0.4, 0, 0.2, 1), padding-bottom 0.8s cubic-bezier(0.4, 0, 0.2, 1)';
        cardContainer.style.transition = 'max-width 0.8s cubic-bezier(0.4, 0, 0.2, 1)';
        cardInner.style.transformStyle = 'preserve-3d';
        cardInner.style.WebkitTransformStyle = 'preserve-3d';
        
        // ========== FRENTE DE LA TARJETA (INTACTO) ==========
        const cardFront = document.createElement('div');
        cardFront.style.position = 'absolute';
        cardFront.style.top = '0';
        cardFront.style.left = '0';
        cardFront.style.width = '100%';
        cardFront.style.height = '100%';
        cardFront.style.backfaceVisibility = 'hidden';
        cardFront.style.WebkitBackfaceVisibility = 'hidden';
        cardFront.style.borderRadius = '16px';
        cardFront.style.overflow = 'hidden';
        cardFront.style.backgroundColor = '#FFFFFF';
        cardFront.style.boxShadow = '0 10px 25px rgba(0,0,0,0.15)';
        cardFront.style.zIndex = '2';
        
        const imgBase = document.createElement('img');
        imgBase.src = srcImagenTarjetaBase;
        imgBase.style.width = '100%';
        imgBase.style.height = '100%';
        imgBase.style.objectFit = '100% 100%'; 
        
        const imgUser = document.createElement('img');
