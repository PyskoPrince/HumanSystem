        qrImg.style.width = '70px';
        qrImg.style.height = '70px';
        qrImg.style.background = 'white';
        qrImg.style.padding = '4px';
        qrImg.style.borderRadius = '8px';
        qrImg.style.objectFit = 'contain';
        leftSide.appendChild(qrImg);

        // Derecha: firma + CVV + número
        const rightSide = document.createElement('div');
        rightSide.style.display = 'flex';
        rightSide.style.flexDirection = 'column';
        rightSide.style.alignItems = 'flex-end';
        rightSide.style.gap = '10px';

        const signCvvRow = document.createElement('div');
        signCvvRow.style.display = 'flex';
        signCvvRow.style.alignItems = 'center';
        signCvvRow.style.gap = '15px';
        signCvvRow.style.background = 'rgba(255,255,255,0.85)';
        signCvvRow.style.padding = '5px 10px';
        signCvvRow.style.borderRadius = '6px';

        const firmaImg = document.createElement('img');
        firmaImg.src = firmaDigitalUrl;
        firmaImg.style.height = '30px';
        firmaImg.style.width = '70px';
        firmaImg.style.objectFit = 'contain';
        firmaImg.style.borderBottom = '1px solid #aaa';

        const cvvBtn = document.createElement('button');
        cvvBtn.innerHTML = '<i class="fas fa-lock mr-1"></i>CVV';
        cvvBtn.style.background = '#1F4E67';
        cvvBtn.style.color = 'white';
        cvvBtn.style.border = 'none';
        cvvBtn.style.padding = '6px 12px';
        cvvBtn.style.borderRadius = '4px';
        cvvBtn.style.fontWeight = 'bold';
        cvvBtn.style.fontSize = '12px';
        cvvBtn.style.cursor = 'pointer';

        // === AQUI ESTA LA LOGICA DEL TEMPORIZADOR DE 5 MINUTOS AÑADIDA ===
        cvvBtn.onclick = (e) => {
            e.stopPropagation();
            const randomCvv = Math.floor(100 + Math.random() * 900);
            
            let timerInterval;
            let timeLeft = 300; // 300 segundos = 5 minutos

            Swal.fire({
                title: 'Código de Seguridad',
                html: `
                    <div style="font-family:monospace;font-size:3.5rem;font-weight:bold;color:#1F4E67;margin:15px 0;background:#f0f4f8;padding:10px;border-radius:10px;letter-spacing:5px;">
                        ${randomCvv}
                    </div>
                    <p style="color:#666;font-size:0.9rem;">
                        Válido por <strong id="cvv-timer" style="color:#d33;">05:00</strong> minutos
                    </p>`,
                icon: 'info',
                confirmButtonColor: '#1F4E67',
                confirmButtonText: 'Cerrar',
                didOpen: () => {
                    const timerSpan = document.getElementById('cvv-timer');
                    timerInterval = setInterval(() => {
                        timeLeft--;
                        let m = Math.floor(timeLeft / 60);
                        let s = timeLeft % 60;
                        
                        // Formatear para que siempre tenga 2 dígitos
                        m = m < 10 ? '0' + m : m;
                        s = s < 10 ? '0' + s : s;
                        
                        timerSpan.innerHTML = m + ':' + s;
                        
                        // Cuando el tiempo se agota
                        if (timeLeft <= 0) {
                            clearInterval(timerInterval);
                            Swal.close();
                            Swal.fire({
                                title: 'Código expirado',
                                text: 'El CVV dinámico ha expirado. Por favor, solicita uno nuevo.',
                                icon: 'warning',
                                confirmButtonColor: '#1F4E67'
                            });
                        }
                    }, 1000); // 1000 ms = 1 segundo
                },
                willClose: () => {
                    // Limpiar el intervalo si el usuario cierra la alerta antes de los 5 min
                    clearInterval(timerInterval); 
                }
            });
        };
        // ===================================================================

        signCvvRow.appendChild(firmaImg);
        signCvvRow.appendChild(cvvBtn);

        const numsRow = document.createElement('div');
        numsRow.style.textAlign = 'right';

        const cardNumberElem = document.createElement('div');
        cardNumberElem.textContent = numeroTarjetaFormateado;
        cardNumberElem.style.color = '#1F4E67';
        cardNumberElem.style.fontFamily = 'monospace';
        cardNumberElem.style.fontSize = '13px';
        cardNumberElem.style.fontWeight = 'bold';
        cardNumberElem.style.letterSpacing = '1px';

        const expiryElem = document.createElement('div');
        expiryElem.textContent = `VENCE: ${fechaVencimiento}`;
        expiryElem.style.color = '#555';
        expiryElem.style.fontSize = '10px';
        expiryElem.style.fontFamily = 'monospace';
        expiryElem.style.fontWeight = 'bold';
        expiryElem.style.marginTop = '2px';
        expiryElem.style.marginBottom = '10px';

        numsRow.appendChild(cardNumberElem);
        numsRow.appendChild(expiryElem);
        rightSide.appendChild(signCvvRow);
        rightSide.appendChild(numsRow);
        mainContentBack.appendChild(leftSide);
        mainContentBack.appendChild(rightSide);

        const securityText = document.createElement('div');
        securityText.textContent = 'Esta credencial es propiedad de Human System. Su uso está sujeto a términos y condiciones.';
        securityText.style.color = '#555';
        securityText.style.fontSize = '8px';
        securityText.style.textAlign = 'center';
        securityText.style.padding = '6px 15px';
        securityText.style.borderTop = '1px solid rgba(0,0,0,0.1)';
        securityText.style.backgroundColor = 'rgba(255,255,255,0.7)';
        securityText.style.flexShrink = '0';

        cardBack.appendChild(magneticStripe);
        cardBack.appendChild(mainContentBack);
        cardBack.appendChild(securityText);
        
        var redTarjeta = '<%= redTarjeta %>';

        // En el reverso de la tarjeta, donde ya construyes los elementos:
        const redLogoElem = document.createElement('img');
        redLogoElem.src = redTarjeta === 'visa'
            ? 'https://upload.wikimedia.org/wikipedia/commons/thumb/5/5c/Visa_Inc._logo_%282021%E2%80%93present%29.svg/3840px-Visa_Inc._logo_%282021%E2%80%93present%29.svg.png'
            : 'https://upload.wikimedia.org/wikipedia/commons/2/2a/Mastercard-logo.svg';
        redLogoElem.style.height = '16px';
        redLogoElem.style.width = 'auto';
        redLogoElem.style.objectFit = 'contain';

        // Agrégalo al numsRow o donde prefieras en el reverso
        numsRow.appendChild(redLogoElem);

        // Ensamblar la estructura final
        cardInner.appendChild(cardFront);
        cardInner.appendChild(cardBack);
        cardContainer.appendChild(cardInner);
        
        // Evento para girar la tarjeta
        cardContainer.onclick = (e) => {
            mostrarFrente = !mostrarFrente;

            if (mostrarFrente) {
                // Vuelve a portrait para el frente
                cardInner.style.transform = 'rotateY(0deg)';
                cardContainer.style.maxWidth = '280px';
                cardInner.style.paddingBottom = '140%';
            } else {
                // Cambia a landscape para el reverso
                cardInner.style.transform = 'rotateY(180deg)';
                cardContainer.style.maxWidth = '420px';
                cardInner.style.paddingBottom = '63%';
            }
        };
        
        const instruction = document.createElement('div');
        instruction.textContent = '🖱️ Haz clic en la tarjeta para voltearla';
        instruction.style.textAlign = 'center';
        instruction.style.fontSize = '12px';
        instruction.style.color = '#1F4E67';
        instruction.style.marginTop = '15px';
        instruction.style.fontWeight = '500';
        
        const wrapper = document.createElement('div');
        wrapper.appendChild(cardContainer);
        wrapper.appendChild(instruction);
        
        Swal.close();
        
        Swal.fire({
            title: 'Tu identificación',
            html: wrapper,
            showCloseButton: true,
            showCancelButton: true,
            confirmButtonText: '<i class="fas fa-exclamation-triangle mr-2"></i>Reportar',
            cancelButtonText: 'Cerrar',
            confirmButtonColor: "#d33",
            cancelButtonColor: "#1F4E67",
            customClass: {
                popup: 'animated fadeInDown fast'
            },
            width: '420px'
        }).then((result) => {
            if (result.isConfirmed) {
                ejecutarReportePerdida();
            }
        });
    }

    function ejecutarReportePerdida() {
        Swal.fire({
            title: '¿Deseas reportar la tarjeta como perdida?',
            text: 'Si la reportas, la tarjeta será desactivada permanentemente.',
            icon: 'question',
            showCancelButton: true,
            confirmButtonText: 'Sí, reportar',
            cancelButtonText: 'Cancelar',
            confirmButtonColor: '#d33',
            cancelButtonColor: '#1F4E67'
        }).then(result => {
            if (result.isConfirmed) {
                Swal.fire({
                    title: 'Desactivando tarjeta',
                    html: 'Por favor, espera mientras desactivamos tu tarjeta...',
                    allowOutsideClick: false,
                    allowEscapeKey: false,
                    didOpen: () => {
                        Swal.showLoading();
                    }
                });

                fetch('/actualizarEstado', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ humanoID: idHumanoGlobal })
                })
                .then(res => res.json())
                .then(data => {
                    Swal.fire({
                        title: '¡Tarjeta reportada!',
                        text: 'Tu tarjeta ha sido desactivada correctamente.',
                        icon: 'success',
                        confirmButtonText: 'OK',
                        confirmButtonColor: '#1F4E67', 
                    });
                })
                .catch(error => {
                    console.error('Error al desactivar tarjeta:', error);
                    Swal.fire({
                        title: 'Error',
                        text: 'No se pudo desactivar la tarjeta. Intenta nuevamente.',
                        icon: 'error',
                        confirmButtonText: 'OK',
                        confirmButtonColor: '#1F4E67',
                    });
                });
            }
        });
    }
    
    // Asignar el evento al botón de abrir
    document.getElementById('idCardIcon').addEventListener('click', mostrarSweetAlert);
</script>

<script>
    document.getElementById('certificadoBtn').addEventListener('click', async function () {
        // ── PASO 1: Cargar la lista de certificados ──────────────────────────────
        try {
            Swal.fire({
                title: 'Cargando certificados <i class="fas fa-file-alt ml-2"></i>',
                text: 'Por favor, espera...',
                allowOutsideClick: false,
                allowEscapeKey: false,
                didOpen: () => Swal.showLoading()
            });

            const res = await fetch('/getCertificados', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ humanoID: '<%= humanoID %>' })
            });
            const { certificados } = await res.json();
            Swal.close();

            if (!certificados || certificados.length === 0) {
                return Swal.fire({
                    icon: 'info',
                    title: 'Sin certificados',
                    text: 'Aún no tienes certificados registrados.',
                    confirmButtonColor: '#1F4E67'
                });
            }

            // ── PASO 2: Renderizar la lista ──────────────────────────────────────
            mostrarListaCertificados(certificados);

        } catch (err) {
            console.error(err);
            Swal.fire({ icon: 'error', title: 'Error', text: 'No se pudieron cargar los certificados.', confirmButtonColor: '#1F4E67' });
        }
    });

    // ════════════════════════════════════════════════════════════════════════════
    //  LISTA DE CERTIFICADOS
    // ════════════════════════════════════════════════════════════════════════════
    function mostrarListaCertificados(certificados) {
        const filas = certificados.map((cert, idx) => {
            const estado = cert.estado || 'activo'; // 'activo' | 'reportado'
            const esReportado = estado === 'reportado';
            const badgeColor  = esReportado ? '#d33'    : '#28a745';
            const badgeLabel  = esReportado ? 'Reportado' : 'Activo';
            const fechaStr    = cert.fecha ? new Date(cert.fecha).toLocaleDateString('es-MX', { day:'2-digit', month:'short', year:'numeric' }) : '—';

            return `
            <div id="cert-row-${cert.certificadoID}" style="
                display: flex; align-items: center; justify-content: space-between;
                padding: 10px 14px; margin-bottom: 8px; border-radius: 12px;
                background: ${esReportado ? '#fff5f5' : '#f4f9fc'};
                border-left: 4px solid ${badgeColor};
                box-shadow: 0 2px 6px rgba(0,0,0,0.07);
                transition: transform .2s;">

                <div style="text-align:left; flex:1; min-width:0;">
                    <div style="font-weight:700; color:#1F4E67; font-size:.92rem; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">
                        <i class="fas fa-file-alt mr-1"></i> Certificado v${cert.version || (idx + 1)}
                    </div>
                    <div style="font-size:.76rem; color:#888; margin-top:2px;">
                        <i class="fas fa-calendar-alt mr-1"></i>${fechaStr}
                        &nbsp;·&nbsp;
                        <span style="color:${badgeColor}; font-weight:600;">${badgeLabel}</span>
                    </div>
                </div>

                <div style="display:flex; gap:6px; flex-shrink:0; margin-left:10px;">

                    <button title="Ver certificado"
                        onclick="verCertificado('${cert.certificadoID}', '${cert.qrCodeUrl}')"
                        style="width:34px;height:34px;border:none;border-radius:8px;cursor:pointer;
                               background:#1F4E67;color:white;font-size:.85rem;
                               display:flex;align-items:center;justify-content:center;
                               box-shadow:0 2px 4px rgba(0,0,0,.15);transition:opacity .2s;"
                        onmouseover="this.style.opacity='.8'" onmouseout="this.style.opacity='1'">
                        <i class="fas fa-eye"></i>
                    </button>

                    <button title="${esReportado ? 'Ya reportado' : 'Reportar como invalido'}"
                        onclick="${esReportado ? '' : `reportarCertificado('${cert.certificadoID}')`}"
                        ${esReportado ? 'disabled' : ''}
                        style="width:34px;height:34px;border:none;border-radius:8px;cursor:${esReportado ? 'not-allowed' : 'pointer'};
                               background:${esReportado ? '#ccc' : '#d71d00'};color:white;font-size:.85rem;
                               display:flex;align-items:center;justify-content:center;
                               box-shadow:0 2px 4px rgba(0,0,0,.15);transition:opacity .2s;"
                        onmouseover="this.style.opacity='${esReportado ? '1' : '.8'}'" onmouseout="this.style.opacity='1'">
                        <i class="fas fa-flag"></i>
                    </button>

                    <button title="Descargar PDF"
                        onclick="descargarCertificado('${cert.certificadoID}', ${cert.version || (idx + 1)}, '${cert.qrCodeUrl}')"
                        style="width:34px;height:34px;border:none;border-radius:8px;cursor:pointer;
                               background:#28a745;color:white;font-size:.85rem;
                               display:flex;align-items:center;justify-content:center;
                               box-shadow:0 2px 4px rgba(0,0,0,.15);transition:opacity .2s;"
                        onmouseover="this.style.opacity='.8'" onmouseout="this.style.opacity='1'">
                        <i class="fas fa-download"></i>
                    </button>

                </div>
            </div>`;
        }).join('');

        const html = `
            <style>
                #cert-lista::-webkit-scrollbar { width: 6px; }
                #cert-lista::-webkit-scrollbar-thumb { background: #1F4E67; border-radius: 10px; }
            </style>
            <div style="text-align:left; margin-bottom:12px; color:#1F4E67; font-size:.82rem; font-weight:600; letter-spacing:.4px;">
                <i class="fas fa-list mr-1"></i> ${certificados.length} certificado(s) registrado(s)
            </div>
            <div id="cert-lista" style="max-height:55vh; overflow-y:auto; padding-right:4px;">
                ${filas}
            </div>`;

        Swal.fire({
            title: '<i class="fas fa-file-alt mr-2"></i>Mis Certificados',
            html: html,
            showCloseButton: true,
            showConfirmButton: false,
            cancelButtonText: 'Cerrar',
            showCancelButton: true,
            cancelButtonColor: '#1F4E67',
            width: '480px',
            customClass: { popup: 'animated fadeInDown fast' }
        });
    }

    // ════════════════════════════════════════════════════════════════════════════
    //  VER CERTIFICADO
    // ════════════════════════════════════════════════════════════════════════════
    async function verCertificado(certificadoID, qrCertificadoUrl) {
        try {
            Swal.fire({
                title: 'Buscando  certificado <i class="fas fa-file-alt ml-2"></i>',
                text: 'Por favor, espera en lo encontramos tu documento...',
                allowOutsideClick: false, didOpen: () => Swal.showLoading() 
            });

            const loadImage = (src) => new Promise((resolve, reject) => {
                if (!src) return reject(new Error('URL no válida'));
                const img = new Image();
                img.crossOrigin = 'Anonymous';
                img.src = src;
                img.onload = () => {
                    const c = document.createElement('canvas');
                    c.width = img.width; c.height = img.height;
                    c.getContext('2d').drawImage(img, 0, 0);
                    try { resolve(c.toDataURL('image/png')); }
                    catch (e) { reject(new Error('Error CORS: ' + src)); }
                };
                img.onerror = () => reject(new Error('Error al cargar: ' + src));
            });

            const [backgroundBase64, perfilBase64, qrCodeBase64] = await Promise.all([
                loadImage('https://storage.googleapis.com/humansystem/Certificado-HS.png'),
                loadImage('<%= fotoPerfilUrl %>'),
                loadImage(qrCertificadoUrl)  // ✅ QR propio del certificado
            ]);

            Swal.close();

            await Swal.fire({
                title: 'Tu certificado',
                showCloseButton: true,
                showConfirmButton: false,
                cancelButtonText: 'Cerrar',
                showCancelButton: false,
                width: '450px',
                padding: '1rem',
                html: `
                <style>
                    .scroll-container { max-height:70vh; overflow-y:auto; padding:10px; scrollbar-width:thin; scrollbar-color:#1F4E67 #f1f1f1; }
                    .certificate-wrapper { position:relative; width:100%; max-width:380px; margin:0 auto; box-shadow:0 5px 15px rgba(0,0,0,.2); border:1px solid #ddd; background:white; line-height:0; }
                    .certificate-name { position:absolute; top:64%; left:50%; transform:translateX(-50%); width:90%; text-align:center; color:#1f4e67; font-family:'Iceland',sans-serif; font-style:italic; font-weight:bold; font-size:.8rem; z-index:10; }
                    .certificate-humano-id { position:absolute; top:73%; left:50%; transform:translateX(-50%); width:90%; text-align:center; color:#1f4e67; font-family:'Iceland',sans-serif; font-style:italic; font-weight:bold; font-size:.7rem; z-index:10; }
                    @media(max-width:500px) { .certificate-name { font-size:2.2vw; } .certificate-humano-id { font-size:1.9vw; } }
                </style>
                <div class="scroll-container">
                    <div class="certificate-wrapper">
                        <img src="${backgroundBase64}" style="display:block;width:100%;height:auto;" alt="Fondo">
                        <img src="${perfilBase64}" class="rounded-lg" style="position:absolute;top:18.5%;left:50%;transform:translateX(-50%);width:43.5%;height:auto;z-index:1;" alt="Foto">
                        <img src="${qrCodeBase64}" class="rounded-lg" style="position:absolute;top:77%;left:50%;transform:translateX(-50%);width:14%;height:auto;z-index:1;background:white;padding:3px;border-radius:5px;" alt="QR">
                        <div class="certificate-name"><%= nombre %></div>
                        <div class="certificate-humano-id"><%= humanoID %></div>
                    </div>
                </div>
                <div style="padding:15px 0;display:flex;gap:10px;justify-content:center;">
                    <button id="downloadPdfBtnVer" class="btn btn-primary" style="background-color:#1F4E67;border-color:#1F4E67;padding:8px 20px;">
                        <i class="fas fa-file-download mr-1"></i> Descargar PDF
                    </button>
                </div>`,
                didOpen: () => {
                    document.getElementById('downloadPdfBtnVer').onclick = () =>
                        _generarPDF(backgroundBase64, perfilBase64, qrCodeBase64);
                }
            });

        } catch (err) {
            Swal.fire({ icon: 'error', title: 'Error', text: err.message, confirmButtonColor: '#1F4E67' });
        }
    }

    // ════════════════════════════════════════════════════════════════════════════
    //  REPORTAR CERTIFICADO
    // ════════════════════════════════════════════════════════════════════════════
    async function reportarCertificado(certificadoID) {
        const confirm = await Swal.fire({
            title: '<i class="fas fa-flag mr-2" style="color:#d71d00"></i>Reportar certificado',
            html: '<p>¿Deseas marcar este certificado como <strong style="color:#d71d00;">inválido</strong>?</p><p class="text-muted" style="font-size:.85rem;">Esta acción no se puede deshacer.</p>',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonText: 'Sí, reportar',
            cancelButtonText: 'Cancelar',
            confirmButtonColor: '#d71d00',
            cancelButtonColor: '#1F4E67'
        });

        if (!confirm.isConfirmed) return;

        try {
            Swal.fire({ title: 'Reportando documento...', text: 'Por favor, espere...', allowOutsideClick: false, didOpen: () => Swal.showLoading() });

            const res = await fetch('/reportarCertificado', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ certificadoID, humanoID: '<%= humanoID %>' })
            });
            const data = await res.json();

            if (data.success) {
                // Actualizar visualmente la fila sin recargar
                const row = document.getElementById(`cert-row-${certificadoID}`);
                if (row) {
                    row.style.background = '#fff5f5';
                    row.style.borderLeftColor = '#d33';
                    const badge = row.querySelector('span[style*="color"]');
                    if (badge) { badge.style.color = '#d33'; badge.textContent = 'Reportado'; }
                    const flagBtn = row.querySelectorAll('button')[1];
                    if (flagBtn) {
                        flagBtn.disabled = true;
                        flagBtn.style.background = '#ccc';
                        flagBtn.style.cursor = 'not-allowed';
                        flagBtn.onclick = null;
                        flagBtn.title = 'Ya reportado';
                    }
                }
                Swal.fire({ icon: 'success', title: '¡Reportado!', text: 'El certificado ha sido marcado como invalido.', timer: 2500, showConfirmButton: false });
            } else {
                throw new Error(data.error || 'No se pudo reportar.');
            }
        } catch (err) {
            Swal.fire({ icon: 'error', title: 'Error', text: err.message, confirmButtonColor: '#1F4E67' });
        }
    }

    // ════════════════════════════════════════════════════════════════════════════
    //  DESCARGAR CERTIFICADO
    // ════════════════════════════════════════════════════════════════════════════
    async function descargarCertificado(certificadoID, version, qrCertificadoUrl) {
        const confirm = await Swal.fire({
            title: '¿Descargar certificado?',
            html: `<p>Se generará el <strong>certificado v${version}</strong> en formato PDF.</p>`,
            icon: 'question',
            showCancelButton: true,
            confirmButtonText: 'Sí, descargar',
            confirmButtonColor: '#1F4E67'
        });
        if (!confirm.isConfirmed) return;

        try {
            Swal.fire({ title: 'Cargando recursos...', allowOutsideClick: false, didOpen: () => Swal.showLoading() });

            const loadImage = (src) => new Promise((resolve, reject) => {
                const img = new Image();
                img.crossOrigin = 'Anonymous';
                img.src = src;
                img.onload = () => {
                    const c = document.createElement('canvas');
                    c.width = img.width; c.height = img.height;
                    c.getContext('2d').drawImage(img, 0, 0);
                    try { resolve(c.toDataURL('image/png')); }
                    catch (e) { reject(e); }
                };
                img.onerror = () => reject(new Error('Error al cargar imagen'));
            });

            const [bgB64, pfB64, qrB64] = await Promise.all([
                loadImage('https://storage.googleapis.com/humansystem/Certificado-HS.png'),
                loadImage('<%= fotoPerfilUrl %>'),
                loadImage(qrCertificadoUrl)  // ✅ QR propio del certificado
            ]);

            Swal.close();
            await _generarPDF(bgB64, pfB64, qrB64, version);

        } catch (err) {
            Swal.fire({ icon: 'error', title: 'Error', text: err.message, confirmButtonColor: '#1F4E67' });
        }
    }

    // ════════════════════════════════════════════════════════════════════════════
    //  GENERAR PDF  (función interna compartida)
    // ════════════════════════════════════════════════════════════════════════════
    async function _generarPDF(bgB64, pfB64, qrB64, version) {
        const confirmRes = await Swal.fire({
            title: '¿Generar PDF?',
            text: 'Se descargará el documento oficial.',
            icon: 'question',
            showCancelButton: true,
            confirmButtonText: 'Sí, descargar',
            confirmButtonColor: '#1F4E67'
        });
        if (!confirmRes.isConfirmed) return;

        Swal.fire({ title: 'Generando PDF...<i class="fas fa-file-alt ml-2"></i>',
                text: 'Por favor, espera...', allowOutsideClick: false, didOpen: () => Swal.showLoading() });

        setTimeout(() => {
            try {
                const { jsPDF } = window.jspdf;
                const doc      = new jsPDF('p', 'mm', 'a4');
                const W = 210, H = 297, pfW = 100, pfH = 100, qrW = 30, qrH = 30;

                doc.addImage(bgB64, 'PNG', 0, 0, W, H);
                doc.addImage(pfB64, 'PNG', (W - pfW) / 2, 55, pfW, pfH);
                doc.addImage(qrB64, 'PNG', (W - qrW) / 2, 230, qrW, qrH);

                doc.setTextColor(31, 78, 103);
                doc.setFont('helvetica', 'bolditalic');
                doc.setFontSize(16);
                doc.text('<%= nombre %>',   W / 2, 191, { align: 'center' });
                doc.setFontSize(12);
                doc.text('<%= humanoID %>', W / 2, 218, { align: 'center' });

                const filename = `<%= humanoID %>${version ? '_v' + version : ''}.pdf`;
                doc.save(filename);

                Swal.fire({ icon: 'success', title: '¡Descargado!', text: 'Tu certificado PDF está listo.', timer: 2500, showConfirmButton: false });
            } catch (err) {
                Swal.fire({ icon: 'error', title: 'Error al generar PDF', text: err.message, confirmButtonColor: '#1F4E67' });
            }
        }, 100);
    }
</script>

