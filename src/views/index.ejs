                    opciones.forEach(opt => opt.classList.remove('seleccionada'));
                    opcion.classList.add('seleccionada');
                    
                    iconoSeleccionado = opcion.dataset.icon;
                    hiddenInput.value = opcion.dataset.value;
                    actualizarIcono(iconoSeleccionado);
                });
            });
