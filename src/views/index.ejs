        imgUser.style.position = 'absolute';
        imgUser.style.width = '42%';
        imgUser.style.top = '19%';
        imgUser.style.left = '50%';
        imgUser.style.transform = 'translateX(-50%)';
        imgUser.style.borderRadius = '50%';
        imgUser.style.border = '3px solid #1F4E67';
        imgUser.style.boxShadow = '0 4px 10px rgba(0,0,0,0.2)';
        imgUser.style.zIndex = '2';
        imgUser.style.objectFit = 'cover';
        
        const nameElem = document.createElement('div');
        nameElem.textContent = nombreHumanoGlobal;
        nameElem.style.position = 'absolute';
        nameElem.style.top = '60%';
        nameElem.style.left = '0';
        nameElem.style.width = '100%';
        nameElem.style.textAlign = 'center';
        nameElem.style.fontWeight = 'bold';
        nameElem.style.fontSize = '16px';
        nameElem.style.color = '#1F4E67';
        nameElem.style.zIndex = '10';
        nameElem.style.fontFamily = 'Iceland, sans-serif';
        nameElem.style.fontStyle = 'italic';  // ← cursiva añadida
        
        const idElem = document.createElement('div');
