                <div id="colConfigContainer" class="col-md-9">
                       <div id="seccionBilletera" class="hidden-section">
                            <style>
                                /* ── Tokens de diseño ── */
                                :root {
                                    --hw-dark:    #0a0e14;
                                    --hw-blue:    #1F4E67;
                                    --hw-red:     #d71d00;
                                    --hw-gold:    #fcc404;
                                    --hw-success: #28a745;
                                    --hw-card-bg: rgba(255,255,255,0.05);
                                }

                                /* ── Contenedor principal ── */
                                .hw-wrapper {
                                    background: linear-gradient(135deg, #0a0e14 0%, #1a2a3a 100%);
                                    border-radius: 24px;
                                    padding: 24px;
                                    color: white;
                                    min-height: 80vh;
                                }

                                /* ── Balance cards ── */
                                .hw-balance-card {
                                    background: rgba(255,255,255,0.07);
                                    border: 1px solid rgba(255,255,255,0.12);
                                    border-radius: 16px;
                                    padding: 20px;
                                    backdrop-filter: blur(10px);
                                    transition: transform 0.2s, box-shadow 0.2s;
                                }
                                .hw-balance-card:hover {
                                    transform: translateY(-3px);
                                    box-shadow: 0 8px 24px rgba(0,0,0,0.3);
                                }
                                .hw-balance-label {
                                    font-size: .72rem;
                                    letter-spacing: 1.5px;
                                    color: rgba(255,255,255,0.5);
                                    text-transform: uppercase;
                                    margin-bottom: 4px;
                                }
                                .hw-balance-amount {
                                    font-size: 1.8rem;
                                    font-weight: 800;
                                    color: white;
                                    font-family: 'Iceland', monospace;
                                }
                                .hw-balance-sub {
                                    font-size: .78rem;
                                    color: rgba(255,255,255,0.4);
                                    margin-top: 4px;
                                }

                                /* ── Coin badge ── */
                                .hw-coin-badge {
                                    display: inline-flex;
                                    align-items: center;
                                    gap: 6px;
                                    background: rgba(252,196,4,0.15);
                                    border: 1px solid rgba(252,196,4,0.35);
                                    border-radius: 20px;
                                    padding: 4px 12px;
                                    font-size: .82rem;
                                    color: #fcc404;
                                    font-weight: 700;
                                }
                                .hw-coin-badge.eth { background: rgba(100,130,255,0.15); border-color: rgba(100,130,255,0.35); color: #8fa8ff; }
                                .hw-coin-badge.usdc { background: rgba(40,160,200,0.15); border-color: rgba(40,160,200,0.35); color: #5bc8e8; }
                                .hw-coin-badge.mxn { background: rgba(40,167,69,0.15); border-color: rgba(40,167,69,0.35); color: #5dd87e; }

                                /* ── Action buttons ── */
                                .hw-btn {
                                    border: none;
                                    border-radius: 12px;
                                    padding: 12px 20px;
                                    font-weight: 700;
                                    font-size: .88rem;
                                    cursor: pointer;
                                    transition: all 0.2s;
                                    display: flex;
                                    align-items: center;
                                    gap: 8px;
                                    justify-content: center;
                                }
                                .hw-btn-primary { background: linear-gradient(135deg, #1F4E67, #2a6a8a); color: white; }
                                .hw-btn-success { background: linear-gradient(135deg, #1a7a3a, #28a745); color: white; }
                                .hw-btn-danger  { background: linear-gradient(135deg, #9a1200, #d71d00); color: white; }
                                .hw-btn-gold    { background: linear-gradient(135deg, #c8a000, #fcc404); color: #0a0e14; }
                                .hw-btn:hover   { opacity: .85; transform: translateY(-1px); }
                                .hw-btn:active  { transform: translateY(0); }

                                /* ── Tabs ── */
                                .hw-tab-bar {
                                    display: flex;
                                    background: rgba(255,255,255,0.05);
                                    border-radius: 12px;
                                    padding: 4px;
                                    gap: 4px;
                                    margin-bottom: 20px;
                                }
                                .hw-tab {
                                    flex: 1;
                                    text-align: center;
                                    padding: 10px;
                                    border-radius: 8px;
                                    font-size: .85rem;
                                    font-weight: 600;
                                    cursor: pointer;
                                    color: rgba(255,255,255,0.5);
                                    transition: all 0.2s;
                                    border: none;
                                    background: none;
                                }
                                .hw-tab.active {
                                    background: rgba(31,78,103,0.8);
                                    color: white;
                                    box-shadow: 0 2px 8px rgba(0,0,0,0.3);
                                }

                                /* ── Transaction list ── */
                                .hw-txn-item {
                                    display: flex;
                                    align-items: center;
                                    justify-content: space-between;
                                    padding: 14px 16px;
                                    border-radius: 12px;
                                    background: rgba(255,255,255,0.04);
                                    border: 1px solid rgba(255,255,255,0.06);
                                    margin-bottom: 8px;
                                    transition: background 0.2s;
                                }
                                .hw-txn-item:hover { background: rgba(255,255,255,0.08); }
                                .hw-txn-icon {
                                    width: 38px; height: 38px;
                                    border-radius: 10px;
                                    display: flex; align-items: center; justify-content: center;
                                    font-size: 1rem;
                                    flex-shrink: 0;
                                }
                                .hw-txn-positivo  { color: #5dd87e; }
                                .hw-txn-negativo  { color: #ff6b6b; }
                                .hw-txn-neutro    { color: #8fa8ff; }

                                /* ── ETH address display ── */
                                .hw-address-box {
                                    background: rgba(0,0,0,0.3);
                                    border: 1px solid rgba(255,255,255,0.1);
                                    border-radius: 10px;
                                    padding: 10px 14px;
                                    font-family: monospace;
                                    font-size: .75rem;
                                    color: rgba(255,255,255,0.7);
                                    word-break: break-all;
                                    cursor: pointer;
                                    transition: border-color 0.2s;
                                }
                                .hw-address-box:hover { border-color: rgba(31,78,103,0.6); }

                                /* ── Plan badge ── */
                                .hw-plan-badge {
                                    display: inline-flex; align-items: center; gap: 5px;
                                    padding: 3px 10px; border-radius: 20px;
                                    font-size: .72rem; font-weight: 700; text-transform: uppercase;
                                }
                                .hw-plan-free { background: rgba(255,255,255,0.1); color: rgba(255,255,255,0.6); }
                                .hw-plan-pro  { background: rgba(252,196,4,0.2); color: #fcc404; border: 1px solid rgba(252,196,4,0.4); }

                                /* ── FX Rate ticker ── */
                                .hw-rate-ticker {
                                    display: flex; gap: 16px; overflow-x: auto; padding: 10px 0;
                                    scrollbar-width: none;
                                }
                                .hw-rate-ticker::-webkit-scrollbar { display: none; }
                                .hw-rate-pill {
                                    flex-shrink: 0; background: rgba(255,255,255,0.05);
                                    border: 1px solid rgba(255,255,255,0.1); border-radius: 20px;
                                    padding: 6px 14px; font-size: .78rem;
                                    white-space: nowrap; color: rgba(255,255,255,0.7);
                                }
                                .hw-rate-pill span { color: white; font-weight: 700; margin-left: 5px; }
                            </style>

