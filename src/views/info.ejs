<%- include('partials/header', { title: 'Información', pageClass: 'page-info' }) %>
<%- include('partials/navbar', { login: false }) %>

<style>
    /* Estilo específico para el nombre en la tarjeta */
.brand-name-style {
    color: #1F4E67;
    font-family: var(--font-tech); /* Usa la misma fuente que tus títulos */
    font-weight: 800;
    text-transform: uppercase;
    text-align: center;
    letter-spacing: 1px;
    font-size: 1.2rem;
    margin: 0;
    /* Sin fondos ni bordes, solo la letra limpia */
    background: none;
    border: none;
    font-style: italic;
    padding: 0 35px;
    word-wrap: break-word;
    line-height: 1.2;
}

.user-info-clean {
    width: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
    margin-top: 50px !important;
    min-height: 50px;
}
/* --- VISUALIZADOR DE VIDEO PREMIUM --- */
.video-modal-overlay {
    position: fixed;
    top: 0; left: 0; width: 100%; height: 100%;
    background: rgba(10, 17, 32, 0.9);
    backdrop-filter: blur(15px);
    display: none; /* Se activa con JS */
    justify-content: center;
    align-items: center;
    z-index: 100001;
    opacity: 0;
    transition: opacity 0.4s ease;
}

.video-modal-overlay.active {
    display: flex;
    opacity: 1;
}

.video-modal-content {
    width: 90%;
    max-width: 1000px;
    background: var(--hs-dark);
    border: 1px solid var(--hs-cyan);
    border-radius: 20px;
    padding: 10px;
    position: relative;
    box-shadow: 0 0 50px rgba(76, 161, 175, 0.3);
}

.video-modal-close {
    position: absolute;
    top: -50px;
    right: 0;
    background: none;
    border: none;
    color: white;
    font-size: 40px;
    cursor: pointer;
    transition: transform 0.3s ease;
}

.video-modal-close:hover {
    color: var(--hs-red);
    transform: rotate(90deg);
}

.video-responsive-container {
    position: relative;
    padding-bottom: 56.25%; /* Ratio 16:9 */
    height: 0;
    overflow: hidden;
    border-radius: 15px;
}

.video-responsive-container iframe {
    position: absolute;
    top: 0; left: 0; width: 100%; height: 100%;
}

.video-footer-text {
    padding: 15px;
    text-align: center;
    font-size: 10px;
    color: var(--hs-cyan);
    letter-spacing: 3px;
}

/* --- ARQUITECTURA DE LA CREDENCIAL 3D --- */
.card-3d-container {
    position: relative; 
    width: 350px; 
    height: 500px; 
    perspective: 1200px; 
    z-index: 10;
}

.card-3d {
    width: 100%;
    height: 100%;
    background-image: url('https://storage.googleapis.com/humansystem/HUMAN%20IDS%20(5.4%20x%208.56%20cm).png');
    background-size: contain;
    background-position: center;
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 20px;
    position: relative;
    transform-style: preserve-3d;
    transition: transform 0.1s ease-out;
    will-change: transform;
}

/* --- CAPAS DINÁMICAS Y CIRCUITOS --- */
.card-bg-animated {
    position: absolute;
    width: 100%;
    height: 100%;
    border-radius: 20px;
    overflow: hidden;
    z-index: 1;
}

.circuit-lines {
    position: absolute;
    width: 100%;
    height: 100%;
    background-image: 
        linear-gradient(90deg, transparent 95%, rgba(76, 161, 175, 0.1) 100%),
        linear-gradient(0deg, transparent 95%, rgba(76, 161, 175, 0.1) 100%);
    background-size: 30px 30px;
    animation: circuitMove 20s linear infinite;
}

.hologram-layer {
    position: absolute;
    width: 100%;
    height: 100%;
    background: linear-gradient(45deg, transparent 45%, rgba(255, 255, 255, 0.03) 50%, transparent 55%);
    animation: hologramMove 3s linear infinite;
}

/* --- FOTO DEL USUARIO Y FRAME --- */
.user-photo-container {
    position: relative;
    width: 130px;
    height: 130px;
    margin: 70px auto 20px;
    border-radius: 50%;
    overflow: hidden;
    border: 2px solid transparent;
    background: linear-gradient(45deg, var(--hs-cyan), var(--hs-red)) border-box;
}

.user-photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(20%);
}

/* --- GRID DE DATOS HOLOGRÁFICOS --- */
.data-grid {
    display: grid;
    gap: 8px;
    margin-top: 15px;
}

.data-item {
    display: flex;
    justify-content: space-between;
    padding: 5px 10px;
    background: rgba(0, 0, 0, 0.3);
    border-radius: 5px;
    border-left: 3px solid var(--hs-cyan);
}

.data-label, .data-value {
    font-size: 0.7rem;
    font-family: var(--font-tech);
}

.data-value.active {
    color: #4CAF50;
    animation: blinkActive 2s infinite;
}

/* --- SEGURIDAD Y CHIP --- */
.security-elements {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: auto;
    padding: 15px;
}


/* --- ANIMACIONES ADICIONALES --- */
@keyframes circuitMove {
    0% { background-position: 0 0; }
    100% { background-position: 30px 30px; }
}

@keyframes hologramMove {
    0% { transform: translateX(-100%); }
    100% { transform: translateX(100%); }
}

@keyframes blinkActive {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.7; }
}

/* Ajuste responsivo para móviles */
@media (max-width: 768px) {


/* 1. Subir el contenedor del nombre en móvil */
    .user-info-clean {
        margin-top: 50px !important;
        min-height: auto !important;
    }

    /* 2. Reducir el texto del nombre para que no choque con "Nombre:" */
    .brand-name-style {
        font-size: 0.95rem !important;
        padding: 0 40px !important;
        line-height: 1.1 !important;
    }

    /* 3. Subir el ID para alejarlo del chip dorado */
    #user-id-key {
        margin-top: 20px !important;
        position: relative;
        z-index: 2;
    }
    
    /* 4. Subir la foto un poco más en móvil (opcional pero ayuda) */
    .user-photo-container {
        width: 120px !important;  
        height: 120px !important;
        margin: 60px auto 10px !important; 
    }


    .card-3d-container {
        width: 300px;
        height: 450px;
    }
}
    /* --- VARIABLES GLOBALES --- */
    :root {
        --hs-dark: #0a1120;
        --hs-blue: #1f4e67;
        --hs-cyan: #4ca1af;
        --hs-red: #d71d00;
        --hs-warning: #FFC107;
        --slate-700: #334155;
        --slate-500: #64748b;
        --glass-bg: rgba(255, 255, 255, 0.05);
        --glass-border: rgba(255, 255, 255, 0.1);
        --font-tech: 'Monaco', 'Consolas', monospace;
        --easing-premium: cubic-bezier(0.23, 1, 0.32, 1);
    }

    /* --- UTILIDADES DE TEXTO --- */
    .text-justify-premium {
        text-align: justify; text-justify: inter-word;
        line-height: 1.7; hyphens: auto;
    }
    .gradient-text {
        background: linear-gradient(135deg, #ffffff 60%, rgba(255,255,255,0.4));
        -webkit-background-clip: text; -webkit-text-fill-color: transparent;
    }
    .hs-heading-tech em { 
        background: linear-gradient(90deg, var(--hs-blue) 0%, var(--hs-red) 100%);
        -webkit-background-clip: text; -webkit-text-fill-color: transparent;
        font-style: italic; padding-right: 5px; 
    }
    
    /* Colores y Pesos */
    .text-success { color: #28a745 !important; }
    .text-danger { color: #d71d00 !important; }
    .text-primary { color: #1F4E67 !important; }
    .text-info { color: #17a2b8 !important; } 
    .text-warning { color: #FFC107 !important; }
    .font-weight-bold { font-weight: 700 !important; }
    .lead { font-size: 1.15rem; font-weight: 300; }

    /* --- ANIMACIONES GENERALES --- */
    @keyframes breathe {
        0%, 100% { transform: scale(1); opacity: 1; }
        50% { transform: scale(1.02); opacity: 0.95; }
    }
    @keyframes pulseGreen {
        0% { box-shadow: 0 0 0 0 rgba(40, 167, 69, 0.7); }
        70% { box-shadow: 0 0 0 10px rgba(40, 167, 69, 0); }
        100% { box-shadow: 0 0 0 0 rgba(40, 167, 69, 0); }
    }
    @keyframes blinker { 50% { opacity: 0; } }
    @keyframes wave-drift {
        0% { transform: translateX(0) scaleY(1); }
        50% { transform: translateX(-25%) scaleY(1.1); }
        100% { transform: translateX(0) scaleY(1); }
    }
    @keyframes circuitMove { 0% { background-position: 0 0; } 100% { background-position: 30px 30px; } }
/* Animación mejorada: alterna opacidad real */
@keyframes tech-flicker {
    0%, 18%, 22%, 25%, 53%, 57%, 100% { opacity: 1; }
    20%, 24%, 55% { opacity: 0.3; } /* El "glitch" ocurre en estos puntos */
    54% { opacity: 0.7; }
}

.flicker-title {
    animation: tech-flicker 5s infinite;
    will-change: opacity;
    /* Eliminamos el display: inline-block si causa problemas de centrado */
}
    /* --- SCROLL REVEAL (Animaciones de entrada) --- */
    .ent-reveal, .ent-reveal-left, .ent-reveal-right {
        opacity: 0;
        transition: opacity 1.2s var(--easing-premium), transform 1.2s var(--easing-premium);
        will-change: opacity, transform;
    }
    .ent-reveal { transform: translateY(30px); }
    .ent-reveal-left { transform: translateX(-30px); }
    .ent-reveal-right { transform: translateX(30px); }
    
    .ent-reveal.visible { opacity: 1; transform: translateY(0); }
    .ent-reveal-left.visible { opacity: 1; transform: translateX(0); }
    .ent-reveal-right.visible { opacity: 1; transform: translateX(0); }

    /* --- LOADER PRINCIPAL (LIMPIO) --- */
    #loader-wrapper {
        position: fixed; top: 0; left: 0; width: 100vw; height: 100vh;
        background: linear-gradient(135deg, var(--hs-dark) 0%, var(--hs-blue) 100%);
        z-index: 100000; display: flex; justify-content: center; align-items: center;
        transition: transform 0.8s cubic-bezier(0.77, 0, 0.175, 1), opacity 0.5s;
    }
    .loader-hidden {
        transform: translateY(-100%) !important; opacity: 0 !important; pointer-events: none;
    }
    .biometric-fusion-container {
        display: flex; flex-direction: column; align-items: center; gap: 30px;
    }
    /* Barra de carga */
    .loading-track {
        width: 240px; height: 2px; background: rgba(255, 255, 255, 0.05);
        border-radius: 10px; overflow: hidden; position: relative;
    }
    .loading-fill {
        position: absolute; top: 0; left: 0; width: 0%; height: 100%;
        background: linear-gradient(90deg, var(--hs-cyan), var(--hs-red));
        box-shadow: 0 0 10px var(--hs-red);
    }
    /* Texto de estado */
    .loader-status {
        font-family: var(--font-tech); font-size: 10px; color: var(--hs-cyan);
        letter-spacing: 2px; text-transform: uppercase; display: flex; gap: 5px;
    }
    .status-dots { animation: dots-blink 1.5s infinite; }
    @keyframes dots-blink { 0%, 100% { opacity: 0.2; } 50% { opacity: 1; } }

    /* --- SECCIÓN HERO PRINCIPAL --- */
    #mission-vision-trust { 
        background: linear-gradient(135deg, #0a1120 0%, var(--hs-blue) 100%); 
        color: white; position: relative; overflow: hidden;
    }
    
    /* Configuración base de espaciado */
    .py-custom {
        padding-top: 20px !important;
        padding-bottom: clamp(120px, 15vw, 200px) !important;
        display: flex; align-items: center; min-height: 70vh;
    }

    /* ESTILOS ESPECÍFICOS SOLICITADOS (TÍTULO Y ESPACIO) */
    .hero-content h1 {
        text-transform: uppercase !important; /* Título en mayúsculas */
        font-weight: 800;
        letter-spacing: -2px;
        line-height: 1;
    }
#mission-vision-trust .row.align-items-center.mb-5 {
    margin-bottom: 120px !important; /* Espacio extra entre la Hero y los bloques de abajo */
}/* Espaciado responsivo para móviles */
@media (max-width: 768px) {
    #mission-vision-trust .row.align-items-center.mb-5 {
        margin-bottom: 80px !important;
    }
}
    /* Media Query para Pantallas Grandes (Desktop) */
    @media (min-width: 992px) {
        .hero-content {
        margin-bottom: 150px !important; 
    }
        /* Aumentar espacio arriba y abajo drásticamente */
        #mission-vision-trust.py-custom {
            padding-top: 100px !important;
            padding-bottom: 100px !important;
        }
        
        /* Título gigante en desktop */
        .hero-content h1 {
            font-size: 5rem !important; 
        }
    }

    .hero-content {
        display: flex; flex-direction: column; align-items: center; 
        justify-content: center; padding-bottom: 50px;
    }
    .hero-desc {
        margin-left: auto; margin-right: auto;
        border-top: 2px solid var(--hs-red); padding-top: 20px;
    }
    
    /* Botones y Elementos UI */
    .btn-glow {
        padding: 16px 40px; background: var(--hs-red); color: white; border: none; 
        font-weight: 700; box-shadow: 0 0 30px rgba(241, 8, 33, 0.4); transition: 0.3s;
    }
    .btn-glow:hover {
        box-shadow: 0 0 50px rgba(241, 8, 33, 0.8); transform: scale(1.05); color: white;
    }
    .icon-box-modern {
        width: 60px; height: 60px; background: rgba(255, 255, 255, 0.1);
        border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 15px;
        display: flex; align-items: center; justify-content: center;
        flex-shrink: 0; margin-right: 1.5rem !important;
    }

    /* Telemetría Card */
    .heroCard {
        background: linear-gradient(180deg, rgba(255, 255, 255, 0.06), rgba(255, 255, 255, 0.03));
        border: 1px solid rgba(255, 255, 255, 0.12); border-radius: 20px; padding: 25px;
        position: relative; overflow: hidden;
    }
    .heroCard:before {
        content: ""; position: absolute; inset: -2px;
        background: radial-gradient(600px 360px at 90% 30%, rgba(241, 8, 33, 0.15), transparent 60%);
        pointer-events: none;
    }
    .telemetry { display: grid; grid-template-columns: 1fr 1fr; gap: 15px; margin: 20px 0; }
    .tile {
        border-radius: 16px; padding: 15px; border: 1px solid rgba(255, 255, 255, 0.1);
        background: rgba(0, 0, 0, 0.2);
    }
    .tile .tvalue { font-size: 24px; font-weight: 700; margin: 5px 0; }
    .miniLine {
        margin-top: 12px; height: 4px; border-radius: 10px;
        background: rgba(255, 255, 255, 0.1); position: relative; overflow: hidden;
    }
    .miniLine i {
        position: absolute; height: 100%;
        background: linear-gradient(90deg, var(--hs-blue), var(--hs-red));
        border-radius: 10px;
    }
    .blink { animation: blinker 1s linear infinite; color: var(--hs-cyan); }

    /* Separador SVG */
    .wave-separator {
        position: absolute; bottom: 0; left: 0; width: 100%;
        overflow: hidden; line-height: 0; transform: rotate(180deg);
    }
    .wave-separator svg {
        position: relative; display: block; width: calc(200% + 1.3px);
        height: 80px; animation: wave-drift 8s ease-in-out infinite;
        transform-origin: center bottom;
    }
    .wave-separator .shape-fill { fill: #ffffff; }

    /* --- SECCIÓN GRID CONVERGENTE --- */
    .section-convergent-white { background: #ffffff; padding: 80px 0; position: relative; }
    .bento-grid-white {
        display: grid; grid-template-columns: repeat(3, 1fr); gap: 30px; margin-top: 60px;
    }
    .hs-card-clean {
        text-align: center; display: flex; flex-direction: column; align-items: center;
        padding: 40px 30px; width: 100%; height: 100%; box-sizing: border-box;
        position: relative;
    }
    .hs-card-clean h3 {
        font-size: 1.6rem; font-weight: 700; color: var(--hs-blue);
        letter-spacing: -0.02em; margin-bottom: 15px; width: 100%;
    }
    .hs-card-clean p {
        color: var(--slate-700); font-size: 1rem; line-height: 1.6;
        margin-bottom: 25px; width: 100%; max-width: 320px;
    }
    .hs-card-clean::after {
        content: ''; position: absolute; top: 0; left: 50%; transform: translateX(-50%);
        width: 60px; height: 4px; border-radius: 0 0 10px 10px;
        background: linear-gradient(90deg, var(--hs-blue), var(--hs-cyan));
        opacity: 0.3; transition: all 0.3s ease;
    }
    .hs-card-clean:hover::after { opacity: 1; width: 80px; }
    
    .hs-icon-frame {
        width: 80px; height: 80px; border-radius: 20px;
        display: flex; align-items: center; justify-content: center;
        margin-bottom: 25px; transition: all 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
        position: relative; overflow: hidden;
    }
    .hs-icon-frame::before {
        content: ''; position: absolute; inset: 0;
        background: linear-gradient(135deg, rgba(255,255,255,0.1) 0%, rgba(255,255,255,0) 60%); z-index: 1;
    }
    .hs-icon-frame i {
        font-size: 2rem; z-index: 2; position: relative; transition: transform 0.3s ease;
    }
    .hs-card-clean:hover .hs-icon-frame {
        transform: translateY(-5px) scale(1.05);
        box-shadow: 0 15px 35px rgba(31, 78, 103, 0.25);
    }
    .hs-card-clean:hover .hs-icon-frame i { transform: scale(1.1); }
    
    .frame-blue { background: linear-gradient(135deg, #1F4E67 0%, #2a6496 100%); color: white; box-shadow: 0 10px 25px rgba(31, 78, 103, 0.2); }
    .frame-cyan { background: linear-gradient(135deg, #4ca1af 0%, #7dcfd9 100%); color: white; box-shadow: 0 10px 25px rgba(76, 161, 175, 0.2); }
    .frame-red { background: linear-gradient(135deg, #d71d00 0%, #ff5a40 100%); color: white; box-shadow: 0 10px 25px rgba(215, 29, 0, 0.2); }

    /* --- SECCIÓN IMPACTO --- */
    .impact-showcase { background: #ffffff; padding: 100px 0; overflow: hidden; }
    .impact-visual-card {
        position: relative; border-radius: 25px; overflow: visible; margin-bottom: 60px;
    }
    .main-image-wrapper {
        position: relative; border-radius: 25px; overflow: hidden;
        box-shadow: 0 20px 40px rgba(0,0,0,0.1); z-index: 1; height: 350px;
    }
    .main-image-wrapper img {
        width: 100%; height: 100%; object-fit: cover; transition: transform 0.8s ease;
    }
    .impact-visual-card:hover .main-image-wrapper img { transform: scale(1.05); }
    .floating-data-card {
        position: absolute; bottom: -25px; left: -20px; width: 200px;
        background: white; border-radius: 18px; padding: 20px;
        box-shadow: 0 15px 35px rgba(0,0,0,0.15); z-index: 3;
        border: 1px solid rgba(0,0,0,0.05); animation: breathe 4s infinite ease-in-out;
    }
    .floating-data-card.right { left: auto; right: -20px; }
    .floating-data-card h3 {
        font-size: 2.5rem; font-weight: 800; margin-bottom: 0; line-height: 1; letter-spacing: -1px;
    }
    .floating-data-card span {
        font-size: 0.75rem; font-weight: bold; text-transform: uppercase; color: #6c757d; letter-spacing: 1px;
    }
    .impact-icon-box {
        width: 60px; height: 60px; border-radius: 15px;
        display: flex; align-items: center; justify-content: center; margin-bottom: 25px;
    }
    .text-container-impact { padding-left: 30px; }
    .text-container-impact.left-align { padding-left: 0; padding-right: 30px; }

    /* --- FORMULARIO Y HERO FINAL --- */
    .hs-hero-main {
        position: relative; background: linear-gradient(135deg, var(--hs-dark) 0%, var(--hs-blue) 100%);
        overflow: hidden; padding: clamp(80px, 10vw, 120px) 0; color: white;
    }
    .hs-hero-blob {
        position: absolute; width: 600px; height: 600px;
        background: radial-gradient(circle, rgba(76, 161, 175, 0.2) 0%, transparent 70%);
        filter: blur(80px); z-index: 0; pointer-events: none;
    }
    .hs-badge-premium {
        background: linear-gradient(90deg, var(--hs-blue), var(--hs-cyan));
        color: white; padding: 8px 20px; border-radius: 50px;
        font-size: 0.8rem; text-transform: uppercase; letter-spacing: 2px;
        font-weight: 700; display: inline-block; margin-bottom: 25px;
        box-shadow: 0 5px 15px rgba(31, 78, 103, 0.4);
    }
    .tpill {
        background: rgba(255, 255, 255, 0.05); border: 1px solid var(--glass-border);
        padding: 6px 14px; border-radius: 50px; font-size: 0.75rem;
        display: flex; align-items: center; gap: 8px; backdrop-filter: blur(5px);
        font-family: monospace; width: fit-content;
    }
    .tpill .dot-active {
        width: 8px; height: 8px; background: #28a745;
        border-radius: 50%; animation: pulseGreen 2s infinite;
    }
    
    /* Glass Form */
    .glass-form-container {
        background: rgba(15, 23, 42, 0.6); backdrop-filter: blur(20px);
        border: 1px solid var(--glass-border); border-radius: 24px;
        padding: 40px; box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
    }
    .form-glass-input {
        background: rgba(0, 0, 0, 0.2) !important;
        border: 1px solid var(--glass-border) !important;
        color: white !important; border-radius: 12px !important;
        padding: 12px 15px !important; transition: all 0.3s ease;
    }
    .form-glass-input:focus {
        border-color: var(--hs-cyan) !important;
        box-shadow: 0 0 15px rgba(76, 161, 175, 0.2) !important;
        background: rgba(0, 0, 0, 0.4) !important;
    }
    .btn-submit-premium {
        background: linear-gradient(90deg, var(--hs-blue), var(--hs-cyan));
        border: none; color: white; font-weight: 700;
        padding: 14px; border-radius: 12px; transition: all 0.3s ease;
        text-transform: uppercase; letter-spacing: 1px;
    }
    .btn-submit-premium:hover {
        transform: translateY(-2px); box-shadow: 0 10px 20px rgba(76, 161, 175, 0.4);
        filter: brightness(1.1);
    }

    /* --- FOOTER Y MODALES --- */
    .footer { background-color: white; border-top: 5px solid var(--hs-blue); position: relative; z-index: 10; }
    .footer hr { border-top: 1px solid rgba(0,0,0,0.1); }
    
    .premium-swal-popup {
        border: 1px solid rgba(76, 161, 175, 0.2) !important; border-radius: 24px !important;
        box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.8) !important;
    }
    .premium-swal-button {
        border-radius: 50px !important; padding: 12px 30px !important;
        text-transform: uppercase !important; font-size: 0.8rem !important;
        font-weight: 700 !important; letter-spacing: 1px !important;
    }
    div::-webkit-scrollbar { width: 5px; }
    div::-webkit-scrollbar-track { background: rgba(255,255,255,0.05); }
