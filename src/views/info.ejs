document.addEventListener('DOMContentLoaded', () => {
    const videoBtn = document.getElementById('btn-watch-video');
    const videoModal = document.getElementById('videoModal');
    const closeBtn = document.getElementById('closeVideo');
    const videoFrame = document.getElementById('hsVideoFrame');

    // URL del video (puedes usar YouTube, Vimeo o un archivo directo)
    const videoURL = "https://www.youtube.com/embed/TU_ID_DE_VIDEO?autoplay=1&rel=0";

    videoBtn.addEventListener('click', () => {
        videoFrame.src = videoURL;
        videoModal.classList.add('active');
        document.body.style.overflow = 'hidden'; // Evita scroll
    });

    const closeModal = () => {
        videoModal.classList.remove('active');
        videoFrame.src = ""; // Corta el audio al cerrar
        document.body.style.overflow = 'auto';
    };

    closeBtn.addEventListener('click', closeModal);
    
    // Cerrar al hacer click fuera del video
    videoModal.addEventListener('click', (e) => {
        if (e.target === videoModal) closeModal();
    });
});


document.addEventListener('DOMContentLoaded', () => {
    const missionCard = document.getElementById('mission-hero-card');
    
    if (missionCard) {
        missionCard.parentElement.addEventListener('mousemove', (e) => {
            const rect = missionCard.getBoundingClientRect();
            const x = e.clientX - rect.left;
            const y = e.clientY - rect.top;
            
            const centerX = rect.width / 2;
            const centerY = rect.height / 2;
            
            // Rotación suave de 10 grados máximo
            const rotateX = ((y - centerY) / centerY) * -10;
            const rotateY = ((x - centerX) / centerX) * 10;

            missionCard.style.transform = `perspective(1200px) rotateX(${rotateX}deg) rotateY(${rotateY}deg)`;
        });

        missionCard.parentElement.addEventListener('mouseleave', () => {
            missionCard.style.transform = 'perspective(1200px) rotateX(0deg) rotateY(0deg)';
        });
    }
});</script>



<script>
  document.addEventListener('DOMContentLoaded', () => {
    const loader = document.getElementById('loader-wrapper');
    const statusText = document.querySelector('.status-text');
    const loadingFill = document.querySelector('.loading-fill');

    // 1. Obtener todas las imágenes de la página
    const allImages = document.querySelectorAll('img');
    const totalImages = allImages.length;
    let imagesLoaded = 0;

    function updateProgress() {
        imagesLoaded++;
        const progress = (imagesLoaded / totalImages) * 100;
        
        if(loadingFill) loadingFill.style.width = `${progress}%`;
        
        // Cambiar estados del texto según el porcentaje real
        if (progress < 30) statusText.innerText = "CARGANDO_MOSAICO_DE_IMÁGENES";
        else if (progress < 60) statusText.innerText = "OPTIMIZANDO_CONTENIDO_MULTIMEDIA";
        else if (progress < 90) statusText.innerText = "RENDERIZANDO_IDENTIDAD_BIOMÉTRICA";
        else statusText.innerText = "LISTO_PARA_EXPLORAR";

        // Cuando la última imagen cargue
        if (imagesLoaded === totalImages) {
            finishLoading();
        }
    }

    function finishLoading() {
        if(loadingFill) {
            loadingFill.style.background = '#28a745';
            loadingFill.style.boxShadow = '0 0 15px #28a745';
        }
        setTimeout(() => {
            if(loader) loader.classList.add('loader-hidden');
        }, 800);
    }

    // 2. Escuchar la carga de cada imagen
    if (totalImages > 0) {
        allImages.forEach(img => {
            if (img.complete) {
                updateProgress();
            } else {
                img.addEventListener('load', updateProgress);
                img.addEventListener('error', updateProgress); // Para que no se trabe si una imagen falla
            }
        });
    } else {
        finishLoading(); // Si no hay imágenes, termina de inmediato
    }

    // Fallback de seguridad (por si algo tarda demasiado)
    setTimeout(() => {
        if (loader && !loader.classList.contains('loader-hidden')) {
             finishLoading();
        }
    }, 8000); 
});

const states = [
    "CARGANDO_MOSAICO_DE_IMÁGENES",
    "RENDERIZANDO_SECCIONES_INTERACTIVAS",
    "PREPARANDO_CUESTIONARIOS_DINÁMICOS",
    "OPTIMIZANDO_CONTENIDO_MULTIMEDIA",
    "LISTO_PARA_EXPLORAR"
];


        let i = 0;
        const progressPerStep = 100 / states.length;

        const stateInterval = setInterval(() => {
            if (i < states.length) {
                if(statusText) statusText.innerText = states[i];
                
                // Actualizar barra de carga
                if(loadingFill) {
                    loadingFill.style.width = `${(i + 1) * progressPerStep}%`;
                    loadingFill.style.transition = 'width 0.6s ease';
                }

                if (states[i] === "LISTO_PARA_EXPLORAR") {
                    clearInterval(stateInterval);
                    
                    // Efecto de éxito
                    if(loadingFill) {
                        loadingFill.style.background = '#28a745';
                        loadingFill.style.boxShadow = '0 0 15px #28a745';
                    }
                    // Ocultar dots si existen
                    if(statusDots) statusDots.style.display = 'none';
                    
                    // Salida final
                    setTimeout(() => {
                        if(loader) loader.classList.add('loader-hidden');
                    }, 800);
                }
                i++;
            }
        }, 700);

        // --- 2. INTERSECTION OBSERVER (ANIMACIONES) ---
        const observerOptions = {
            root: null,
            rootMargin: '0px',
            threshold: 0.15 
        };

        const observer = new IntersectionObserver((entries, observer) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.classList.add('visible');
                    observer.unobserve(entry.target);
                }
            });
        }, observerOptions);

        document.querySelectorAll('.ent-reveal, .ent-reveal-left, .ent-reveal-right').forEach(el => {
            observer.observe(el);
        });

        // --- 3. TELEMETRÍA SIMULADA ---
