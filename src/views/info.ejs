            if (latencyValue) {
                latencyValue.innerText = `${finalLatency}ms`;
                const barWidth = (finalLatency / 30) * 100; 
                if(latencyBar) {
                    latencyBar.style.width = `${barWidth}%`;
                    latencyBar.style.transition = 'width 0.8s ease';
                }
            }

            // Simular Uptime
