        { img:"https://storage.googleapis.com/humansystem/Gemini_Generated_Image_jp5hjcjp5hjcjp5h-Photoroom.png", names:["MARÍA JOSÉ","ANA PAULA","XIMENA","BEATRIZ","ELENA"], paternal:["GARCÍA","RODRÍGUEZ","MARTÍNEZ","SOTO","VARGAS"], maternal:["SÁNCHEZ","LÓPEZ","PÉREZ","CORTÉS","MÉNDEZ"], countryCode:"MEX", gender:"F", dob:"920514" },
        { img:"https://storage.googleapis.com/humansystem/Gemini_Generated_Image_l1rdudl1rdudl1rd-Photoroom.png", names:["JUAN CARLOS","LUIS ALBERTO","RICARDO","MAURICIO","ROBERTO"], paternal:["HERNÁNDEZ","SÁNCHEZ","PÉREZ","GÓMEZ","DÍAZ"], maternal:["GONZÁLEZ","GÓMEZ","RAMÍREZ","FLORES","ORTEGA"], countryCode:"ARG", gender:"M", dob:"881022" },
        { img:"https://storage.googleapis.com/humansystem/Gemini_Generated_Image_zemt3vzemt3vzemt-Photoroom.png", names:["CARLA SOFÍA","VALERIA","DANIELA","ADRIANA","NATALIA"], paternal:["RAMÍREZ","CRUZ","FLORES","MORALES","SOLÍS"], maternal:["MORALES","ORTIZ","CASTRO","RIVERA","REYES"], countryCode:"COL", gender:"F", dob:"950130" },
        { img:"https://storage.googleapis.com/humansystem/Gemini_Generated_Image_6x61cl6x61cl6x61-Photoroom.png", names:["MIGUEL ÁNGEL","FRANCISCO","JAVIER","ALEJANDRO","SANTIAGO"], paternal:["VAZQUEZ","REYES","JIMÉNEZ","TORRES","LUNA"], maternal:["TORRES","VARGAS","RUIZ","MENDOZA","SANTIAGO"], countryCode:"ESP", gender:"M", dob:"900715" },
        { img:"https://storage.googleapis.com/humansystem/Gemini_Generated_Image_ppy4sdppy4sdppy4-Photoroom.png", names:["SOFÍA","ISABELLA","CAMILA","VALENTINA","MARIANA"], paternal:["CASTILLO","GUZMÁN","ROMERO","MUÑOZ","AGUILAR"], maternal:["NAVARRO","SALAZAR","DELGADO","PACHECO","IBARRA"], countryCode:"CHL", gender:"F", dob:"940312" }
    ];

    function generateHumanoKey(profile,fullName){ const genderDigit=profile.gender==="M"?"1":"2"; const initials=fullName.split(' ').map(n=>n[0]).join('').substring(0,3); const randomSuffix=Math.random().toString().slice(2,7); return `${profile.countryCode}${initials}${genderDigit}${profile.dob}${randomSuffix}`; }

    let currentIndex=0;
    function rotateIdentity(){
        if(!nameDisplay||!idKeyDisplay) return;
        nameDisplay.style.opacity='0'; idKeyDisplay.style.opacity='0';
        setTimeout(()=>{
            currentIndex=(currentIndex+1)%staffProfiles.length;
