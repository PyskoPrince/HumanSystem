<script>
  
  // --- SISTEMA DE AUTENTICACIÓN BIOMÉTRICA ---
  class BiometricAuth {
    constructor() {
      this.stream = null;
      this.isCameraActive = false;
      this.recognitionAttempts = 0;
      this.maxAttempts = 3;
      this.mediaRecorder = null;
      this.audioChunks = [];
      this.isRecording = false;
      
      this.initializeBiometricEvents();
    }

    initializeBiometricEvents() {
      // Control de cámara facial
      const startCameraBtn = document.getElementById('startCamera');
      const captureFaceBtn = document.getElementById('captureFace');
      const retryCaptureBtn = document.getElementById('retryCapture');
      
      if (startCameraBtn) {
        startCameraBtn.addEventListener('click', () => {
          this.initializeCamera();
        });
      }

      if (captureFaceBtn) {
        captureFaceBtn.addEventListener('click', () => {
          this.captureAndVerifyFace();
        });
      }

      if (retryCaptureBtn) {
        retryCaptureBtn.addEventListener('click', () => {
          this.retryCapture();
        });
      }

      // Control de grabación de voz
      const startRecordingBtn = document.getElementById('startRecording');
      const stopRecordingBtn = document.getElementById('stopRecording');
      
      if (startRecordingBtn) {
        startRecordingBtn.addEventListener('click', () => {
          this.startVoiceRecording();
        });
      }

      if (stopRecordingBtn) {
        stopRecordingBtn.addEventListener('click', () => {
          this.stopVoiceRecording();
        });
      }
    }

    async initializeCamera() {
      try {
        const constraints = {
          video: { 
            width: { ideal: 640 },
            height: { ideal: 480 },
            facingMode: 'user'
          },
          audio: false
        };

        this.stream = await navigator.mediaDevices.getUserMedia(constraints);
        const video = document.getElementById('faceVideo');
        video.srcObject = this.stream;
        
        this.isCameraActive = true;
        document.getElementById('startCamera').disabled = true;
        document.getElementById('captureFace').disabled = false;
        
        this.showFaceMessage('Cámara activada. Posiciona tu rostro en el marco.', 'info');
        
      } catch (error) {
        console.error('Error accediendo a la cámara:', error);
        this.showError('No se pudo acceder a la cámara. Verifica los permisos.');
      }
    }

    async captureAndVerifyFace() {
      if (!this.isCameraActive) {
        this.showError('Activa primero la cámara.');
        return;
      }

      this.recognitionAttempts++;
      const video = document.getElementById('faceVideo');
      const canvas = document.getElementById('faceCanvas');
      const context = canvas.getContext('2d');

      canvas.width = video.videoWidth;
      canvas.height = video.videoHeight;
      context.drawImage(video, 0, 0, canvas.width, canvas.height);

      this.showFaceMessage('Analizando características faciales...', 'info');
      document.getElementById('captureFace').disabled = true;
      
      const confidenceMeter = document.querySelector('.login-confidence-meter');
      if (confidenceMeter) {
        confidenceMeter.style.display = 'block';
      }

      // Simulación de procesamiento biométrico
      await this.simulateFaceRecognition();
    }

    async simulateFaceRecognition() {
      // Simular tiempo de procesamiento
      for (let i = 0; i <= 100; i += 10) {
        await new Promise(resolve => setTimeout(resolve, 200));
        this.updateConfidenceMeter(i);
      }

      const confidence = Math.random() * 100;
      this.updateConfidenceMeter(confidence);

      if (confidence > 85) {
        this.handleBiometricSuccess('facial');
      } else if (this.recognitionAttempts < this.maxAttempts) {
        this.handleBiometricRetry(confidence);
      } else {
        this.handleBiometricFailure();
      }
    }

    updateConfidenceMeter(confidence) {
      const progressBar = document.getElementById('confidenceProgress');
      const confidenceValue = document.getElementById('confidenceValue');
      
      if (progressBar) {
        progressBar.style.width = `${confidence}%`;
      }
      
      if (confidenceValue) {
        confidenceValue.textContent = `${Math.round(confidence)}%`;
      }

      if (progressBar) {
        if (confidence > 85) {
          progressBar.style.background = 'linear-gradient(90deg, #00b894, #00cec9)';
        } else if (confidence > 60) {
          progressBar.style.background = 'linear-gradient(90deg, #f39c12, #e67e22)';
        } else {
          progressBar.style.background = 'linear-gradient(90deg, #e74c3c, #e67e22)';
        }
      }
    }

    async startVoiceRecording() {
      try {
        const stream = await navigator.mediaDevices.getUserMedia({ audio: true });
        this.mediaRecorder = new MediaRecorder(stream);
        this.audioChunks = [];
        this.isRecording = true;

        this.mediaRecorder.ondataavailable = (event) => {
          this.audioChunks.push(event.data);
        };

        this.mediaRecorder.onstop = () => {
          this.processVoiceRecording();
        };

        this.mediaRecorder.start();
        document.getElementById('startRecording').disabled = true;
        document.getElementById('stopRecording').disabled = false;
        this.showVoiceMessage('Grabando... Habla ahora.', 'info');
        
      } catch (error) {
        console.error('Error accediendo al micrófono:', error);
        this.showError('No se pudo acceder al micrófono. Verifica los permisos.');
      }
    }

    stopVoiceRecording() {
      if (this.mediaRecorder && this.isRecording) {
        this.mediaRecorder.stop();
        this.isRecording = false;
        this.mediaRecorder.stream.getTracks().forEach(track => track.stop());
        document.getElementById('stopRecording').disabled = true;
        this.showVoiceMessage('Procesando muestra de voz...', 'info');
      }
    }

    async processVoiceRecording() {
      // Simular procesamiento de voz
      await new Promise(resolve => setTimeout(resolve, 3000));
      
      const success = Math.random() > 0.3; // 70% de éxito
      
      if (success) {
        this.handleBiometricSuccess('voice');
      } else {
        this.showVoiceMessage('Voz no reconocida. Intenta nuevamente.', 'error');
        document.getElementById('startRecording').disabled = false;
      }
    }

    handleBiometricSuccess(method) {
      const methodName = method === 'facial' ? 'facial' : 'vocal';
      this.showSuccessMessage(`✅ Identidad verificada por ${methodName}`);
      
      // Simular redirección después de éxito
      setTimeout(() => {
        Swal.fire({
          title: '🔐 Acceso Autorizado',
          text: 'Bienvenido de nuevo a Human System',
          icon: 'success',
          confirmButtonText: 'Continuar'
        }).then(() => {
          window.location.href = '/dashboard';
        });
      }, 1500);
    }

    handleBiometricRetry(confidence) {
      this.showFaceMessage(`❌ Coincidencia baja (${Math.round(confidence)}%). Intenta nuevamente.`, 'warning');
      const retryBtn = document.getElementById('retryCapture');
      if (retryBtn) {
        retryBtn.style.display = 'block';
      }
      document.getElementById('captureFace').disabled = false;
    }

    handleBiometricFailure() {
      this.showFaceMessage('❌ No se pudo verificar tu identidad. Usa otro método.', 'error');
      const retryBtn = document.getElementById('retryCapture');
      if (retryBtn) {
        retryBtn.style.display = 'none';
      }
      document.getElementById('captureFace').disabled = true;
    }

    retryCapture() {
      const retryBtn = document.getElementById('retryCapture');
      if (retryBtn) {
        retryBtn.style.display = 'none';
      }
      document.getElementById('captureFace').disabled = false;
      const confidenceMeter = document.querySelector('.login-confidence-meter');
      if (confidenceMeter) {
        confidenceMeter.style.display = 'none';
      }
      this.showFaceMessage('Preparado para nuevo intento...', 'info');
    }

    showFaceMessage(message, type = 'info') {
      const alert = document.getElementById('faceMatchResult');
      const status = document.getElementById('matchStatus');
      
      if (alert && status) {
        status.textContent = message;
        alert.style.display = 'block';
        
        // Actualizar clases según tipo
        if (type === 'info') {
          alert.style.background = 'rgba(31, 78, 103, 0.3)';
          alert.style.borderColor = 'rgba(76, 161, 175, 0.4)';
        } else if (type === 'warning') {
          alert.style.background = 'rgba(243, 156, 18, 0.3)';
          alert.style.borderColor = 'rgba(243, 156, 18, 0.4)';
        } else if (type === 'error') {
          alert.style.background = 'rgba(231, 76, 60, 0.3)';
          alert.style.borderColor = 'rgba(231, 76, 60, 0.4)';
        }
      }
    }

    showVoiceMessage(message, type = 'info') {
      const alert = document.getElementById('voiceMatchResult');
      const status = document.getElementById('voiceStatus');
      
      if (alert && status) {
        status.textContent = message;
        alert.style.display = 'block';
        
        // Actualizar estilos según tipo
        if (type === 'info') {
          alert.style.background = 'rgba(31, 78, 103, 0.3)';
          alert.style.borderColor = 'rgba(76, 161, 175, 0.4)';
        } else if (type === 'error') {
          alert.style.background = 'rgba(215, 29, 0, 0.3)';
          alert.style.borderColor = 'rgba(215, 29, 0, 0.4)';
        }
      }
    }

    showSuccessMessage(message) {
      if (typeof Swal !== 'undefined') {
        Swal.fire({
          title: message,
          icon: 'success',
          timer: 2000,
          showConfirmButton: false
        });
      }
    }

    showError(message) {
      if (typeof Swal !== 'undefined') {
        Swal.fire({
          title: 'Error',
          text: message,
          icon: 'error',
          confirmButtonText: 'Entendido'
        });
      }
    }

    stopCamera() {
      if (this.stream) {
        this.stream.getTracks().forEach(track => track.stop());
        this.stream = null;
      }
      this.isCameraActive = false;
      const startCameraBtn = document.getElementById('startCamera');
      const captureFaceBtn = document.getElementById('captureFace');
      
      if (startCameraBtn) startCameraBtn.disabled = false;
      if (captureFaceBtn) captureFaceBtn.disabled = true;
      
      const confidenceMeter = document.querySelector('.login-confidence-meter');
      if (confidenceMeter) {
        confidenceMeter.style.display = 'none';
      }
    }

    stopVoice() {
      if (this.mediaRecorder && this.isRecording) {
        this.mediaRecorder.stop();
        this.isRecording = false;
      }
      const startRecordingBtn = document.getElementById('startRecording');
      const stopRecordingBtn = document.getElementById('stopRecording');
      
      if (startRecordingBtn) startRecordingBtn.disabled = false;
      if (stopRecordingBtn) stopRecordingBtn.disabled = true;
    }
  }

  // --- INICIALIZACIÓN CUANDO EL DOM ESTÉ LISTO ---
  document.addEventListener('DOMContentLoaded', function () {
    let biometricAuth = null;

    // Toggle password visibility
    const passwordInput = document.getElementById('passwordInput');
    const togglePasswordIcon = document.getElementById('togglePassword');
    if (passwordInput && togglePasswordIcon) {
      togglePasswordIcon.addEventListener('click', function () {
        const isPassword = passwordInput.type === 'password';
        passwordInput.type = isPassword ? 'text' : 'password';
        const icon = this.querySelector('i');
        if (icon) {
          icon.classList.toggle('fa-eye');
          icon.classList.toggle('fa-eye-slash');
        }
      });
    }

    // Cambiar método de autenticación
    const tabButtons = document.querySelectorAll('.login-tab-btn');
    const formSections = {
      'traditional': document.getElementById('traditionalSection'),
      'facial': document.getElementById('facialSection'),
      'voice': document.getElementById('voiceSection')
    };

    function switchAuthMethod(method) {
      // Detener cualquier proceso biométrico activo
      if (biometricAuth) {
        if (method !== 'facial') {
          biometricAuth.stopCamera();
        }
        if (method !== 'voice') {
          biometricAuth.stopVoice();
        }
      }

      // Oculta todas las secciones
      Object.values(formSections).forEach(section => {
        if (section) {
          section.classList.remove('active');
        }
      });

      // Muestra la sección seleccionada
      const selectedSection = formSections[method];
      if (selectedSection) {
        selectedSection.classList.add('active');
      }

      // Actualizar estado de pestañas
      tabButtons.forEach(btn => {
        btn.classList.remove('active');
      });
      
      const activeTab = document.querySelector(`[data-method="${method}"]`);
      if (activeTab) {
        activeTab.classList.add('active');
      }

      // Inicializar sistema biométrico si es necesario
      if ((method === 'facial' || method === 'voice') && !biometricAuth) {
        biometricAuth = new BiometricAuth();
      }

      // Manejar envío del formulario
      const loginForm = document.getElementById('loginForm');
      if (loginForm) {
        if (method === 'traditional') {
          loginForm.onsubmit = handleTraditionalLogin;
        } else {
          loginForm.onsubmit = function(event) { 
            event.preventDefault(); 
            if (typeof Swal !== 'undefined') {
              Swal.fire({
                title: 'Método Biométrico',
                text: 'Usa los botones dentro de la sección para autenticarte.',
                icon: 'info',
                confirmButtonText: 'Entendido'
              });
            }
          };
        }
      }
    }


function handleTraditionalLogin(event) {
    event.preventDefault();
    const humanoInput = document.getElementById('humanoInput');
    const passwordInput = document.getElementById('passwordInput');
    const loader = document.getElementById('loader-wrapper');
    const loaderText = document.getElementById('loader-text');

    if (!humanoInput.value || !passwordInput.value) {
        Swal.fire({ title: 'Error', text: 'Ingresa tus credenciales', icon: 'error' });
        return;
    }
    
    // 1. Reset limpio del estado
    loader.classList.remove('loader-hidden', 'loading-success', 'loading-active');
    // Forzar reflow para reiniciar animaciones
    void loader.offsetHeight;
    
    // 2. Mostrar loader (visible inmediatamente)
    loader.classList.add('loader-visible');
    
    // 3. Iniciar animación después de un micro delay
    
    setTimeout(() => {
        loader.classList.add('loading-active');
        loaderText.innerText = "AUTHENTICATING_USER";
        loaderText.style.color = "#4ca1af";
    }, 50);

    // 4. Promesa artificial para UX: asegura que el loader se vea por lo menos 2s
    const minWait = new Promise(resolve => setTimeout(resolve, 2000));
    
    // Promesa real de autenticación al servidor
    const authRequest = fetch('/auth', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ 
            humano: humanoInput.value.toUpperCase(), 
            contraseña: passwordInput.value 
        })
    }).then(async response => {
        const data = await response.json();
        if (!response.ok) throw new Error(data.alertMessage || 'Credenciales incorrectas');
        return data;
    });

    // 5. Esperamos a que AMBAS promesas terminen
    Promise.all([authRequest, minWait])
    .then(results => {
        const data = results[0];
        
        // ÉXITO: Cambiamos estilos al verde
        loaderText.innerText = "ACCESS_GRANTED";
        loaderText.style.color = "#00b894";
        loader.classList.remove('loading-active'); 
        loader.classList.add('loading-success'); 
        
        // Esperamos 1 segundo para mostrar el éxito y redirigir DIRECTAMENTE
        // SIN ocultar el loader primero (así no se ve el contenido de atrás)
        setTimeout(() => {
            // Redirigir directamente - el loader desaparece con la página
            window.location.href = data.ruta || '/';
        }, 500);
    })
    .catch(error => {
        // ERROR: Ocultar loader suavemente
        loader.classList.remove('loading-active', 'loader-visible');
        loader.classList.add('loader-hidden');
        
        Swal.fire({
            title: 'Acceso Denegado',
            text: error.message,
            icon: 'error',
            background: 'rgba(10, 17, 32, 0.95)',
            color: 'white',
            confirmButtonColor: '#1F4E67'
        });
    });
}


    // Inicializar con método tradicional
    document.getElementById('loginForm').onsubmit = handleTraditionalLogin;

    // Escucha clics en las pestañas
    tabButtons.forEach(button => {
      button.addEventListener('click', function() {
        const method = this.getAttribute('data-method');
        switchAuthMethod(method);
      });
    });

    // --- RECUPERAR CONTRASEÑA ---
    const forgotPasswordLink = document.getElementById('forgotPasswordLink');
    if (forgotPasswordLink) {
      forgotPasswordLink.addEventListener('click', function(e) {
        e.preventDefault();
        if (typeof Swal !== 'undefined') {
          Swal.fire({
            title: 'Recuperar Contraseña',
            input: 'text',
            inputLabel: 'Introduce tu correo electrónico o teléfono',
            inputPlaceholder: 'Correo electrónico o teléfono',
            showCancelButton: true,
            confirmButtonText: 'Enviar',
            cancelButtonText: 'Cancelar',
            background: 'rgba(10, 17, 32, 0.95)',
            backdrop: 'rgba(0, 0, 0, 0.6)',
            color: 'white',
            inputValidator: (value) => { 
              if (!value) return '¡Este campo es obligatorio!'; 
            }
          }).then((result) => {
            if (result.isConfirmed) {
              Swal.fire({
                title: '¡Enviado!',
                text: 'Te hemos enviado un enlace para recuperar tu contraseña.',
                icon: 'success',
                background: 'rgba(10, 17, 32, 0.95)',
                backdrop: 'rgba(0, 0, 0, 0.6)',
                color: 'white'
              });
            }
          });
        }
      });
    }

    // --- LOGIN CON GOOGLE ---
    const googleLoginBtn = document.getElementById('googleLoginBtn');
    if (googleLoginBtn) {
      googleLoginBtn.addEventListener('click', function() {
        if (typeof Swal !== 'undefined') {
          Swal.fire({
            title: 'Servicio aún no disponible',
            text: 'Esta funcionalidad está en desarrollo.',
            icon: 'warning',
            background: 'rgba(10, 17, 32, 0.95)',
            backdrop: 'rgba(0, 0, 0, 0.6)',
            color: 'white',
            confirmButtonText: 'OK'
          });
        }
      });
    }

   // --- CAMBIAR LOGO POR FOTO DE PERFIL ---
const humanoInputField = document.getElementById('humanoInput');
const brandLogo = document.querySelector('.login-logo-glass');

if (brandLogo && humanoInputField) {
  const defaultLogoSrc = brandLogo.src;
  let debounceTimeout;
  
  humanoInputField.addEventListener('input', function() {
    clearTimeout(debounceTimeout);
    const identifier = this.value.trim();
    
    console.log('[FRONTEND] Input detectado:', identifier);
    console.log('[FRONTEND] Longitud:', identifier.length);
    
    if (identifier.length < 3) {
      console.log('[FRONTEND] Menos de 3 caracteres, restaurando logo default');
      brandLogo.src = defaultLogoSrc;
      return;
    }
    
    debounceTimeout = setTimeout(async () => {
      console.log('[FRONTEND] Haciendo fetch a /api/get-user-profile-pic con:', identifier);
      try {
        const response = await fetch('/api/get-user-profile-pic', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ identifier: identifier })
        });
        
        console.log('[FRONTEND] Response status:', response.status);
        
        if (!response.ok) {
          console.log('[FRONTEND] Response no OK, restaurando default');
          brandLogo.src = defaultLogoSrc;
          return;
        }
        
        const data = await response.json();
        console.log('[FRONTEND] Data recibida:', data);
        
        if (data.success && data.fotoPerfilUrl) {
          console.log('[FRONTEND] ✅ Foto encontrada, cargando imagen:', data.fotoPerfilUrl);
          const tempImage = new Image();
          tempImage.onload = () => {
            console.log('[FRONTEND] ✅ Imagen cargada exitosamente');
            brandLogo.src = data.fotoPerfilUrl;
          };
          tempImage.onerror = (err) => {
            console.error('[FRONTEND] ❌ Error cargando imagen:', err);
            brandLogo.src = defaultLogoSrc;
          };
          tempImage.src = data.fotoPerfilUrl;
        } else {
          console.log('[FRONTEND] ❌ No success o no fotoPerfilUrl:', data.message);
          brandLogo.src = defaultLogoSrc;
        }
      } catch (error) {
        console.error('[FRONTEND] ❌ Error en fetch:', error);
        brandLogo.src = defaultLogoSrc;
      }
     }, 500);
      });
    }
  });
</script>

