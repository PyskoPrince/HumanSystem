<%- include('partials/header', { title: 'Iniciar Sesión', pageClass: 'page-login-liquid' }) %>
<%- include('partials/navbar', { login: false, currentPage: 'login' }) %>

<div id="loader-wrapper">
    <div class="biometric-container">
        <div class="fingerprint-scanner">
            <i class="fas fa-fingerprint"></i>
            <div class="scan-bar"></div>
        </div>
        <div class="loading-track">
            <div class="loading-fill"></div>
        </div>
        <div class="loader-status">
            <span class="status-text" id="loader-text">SYSTEM_AUTH_REQUIRED</span>
            <span class="status-dots">...</span>
        </div>
    </div>
</div>

<style>
  /* ========== PALETA DE COLORES HUMAN SYSTEM ========== */
  :root {
    --hs-dark: #0a1120;           /* Azul oscuro principal */
    --hs-blue: #1F4E67;          /* Azul corporativo */
    --hs-cyan: #4ca1af;          /* Cyan acento */
    --hs-accent: #d71d00;        /* Rojo acento */
    --hs-red: #f10821;           /* Rojo vibrante */
    --hs-light: rgba(255, 255, 255, 0.9);
    --hs-glass-bg: rgba(255, 255, 255, 0.05);
    --hs-glass-border: rgba(255, 255, 255, 0.1);
  }

  /* ========== FONDO SÓLIDO ========== */
  .page-login-liquid {
    background: linear-gradient(135deg, #0a1120 0%, #1a1f2e 50%, #1F4E67 100%);
    min-height: 100vh;
    margin: 0;
    overflow-x: hidden;
  }

  /* ========== CONTENEDOR PRINCIPAL ========== */
  .login-liquid-container {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
    z-index: 1;
  }

  /* ========== FONDO CON EFECTOS SUTILES ========== */
  .login-liquid-bg {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: -1;
    overflow: hidden;
    background: linear-gradient(135deg, #0a1120 0%, #1a1f2e 50%, #1F4E67 100%);
  }

  .login-blob {
    position: absolute;
    border-radius: 50%;
    filter: blur(80px);
    animation: floatBlob 25s infinite ease-in-out;
    opacity: 0.15;
  }

  .blob-1 {
    width: 400px;
    height: 400px;
    top: 10%;
    left: 10%;
    background: radial-gradient(circle at 30% 30%, var(--hs-cyan), transparent 70%);
    animation-delay: 0s;
  }

  .blob-2 {
    width: 300px;
    height: 300px;
    bottom: 20%;
    right: 15%;
    background: radial-gradient(circle at 30% 30%, var(--hs-accent), transparent 70%);
    animation-delay: -8s;
  }

  .blob-3 {
    width: 250px;
    height: 250px;
    top: 50%;
    left: 80%;
    background: radial-gradient(circle at 30% 30%, var(--hs-blue), transparent 70%);
    animation-delay: -16s;
  }

  /* ========== CONTAINER DEL FORMULARIO GLASS ========== */
  .login-glass-container {
    background: linear-gradient(
      135deg,
      rgba(31, 78, 103, 0.1) 0%,
      rgba(10, 17, 32, 0.2) 100%
    ) !important;
    backdrop-filter: blur(35px) saturate(180%) !important;
    -webkit-backdrop-filter: blur(35px) saturate(180%) !important;
    border: 1.5px solid rgba(76, 161, 175, 0.25) !important;
    border-radius: 24px !important;
    box-shadow: 
      0 20px 40px rgba(0, 0, 0, 0.3),
      inset 0 1px 0 rgba(255, 255, 255, 0.15),
      inset 0 0 30px rgba(76, 161, 175, 0.1) !important;
    padding: 40px;
    width: 100%;
    max-width: 440px;
    position: relative;
    overflow: hidden;
    transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.1);
  }

  /* Efecto de brillo líquido */
  .login-glass-container::before {
    content: '';
    position: absolute;
    top: -50%;
    left: -50%;
    width: 200%;
    height: 200%;
    background: linear-gradient(
      45deg,
      transparent 30%,
      rgba(76, 161, 175, 0.08) 50%,
      transparent 70%
    );
    transform: rotate(30deg);
    animation: liquidShine 8s infinite linear;
    pointer-events: none;
  }

  @keyframes liquidShine {
    0% { transform: rotate(30deg) translateX(-100%); }
    100% { transform: rotate(30deg) translateX(100%); }
  }

  @keyframes floatBlob {
    0%, 100% { transform: translate(0, 0) scale(1); }
    25% { transform: translate(30px, -30px) scale(1.05); }
    50% { transform: translate(-20px, 20px) scale(0.95); }
    75% { transform: translate(15px, -15px) scale(1.02); }
  }

  .login-glass-container:hover {
    background: linear-gradient(
      135deg,
      rgba(31, 78, 103, 0.15) 0%,
      rgba(10, 17, 32, 0.25) 100%
    ) !important;
    border: 1.5px solid var(--hs-cyan) !important;
    box-shadow: 
      0 30px 60px rgba(0, 0, 0, 0.4),
      inset 0 1px 0 rgba(255, 255, 255, 0.2),
      inset 0 0 40px rgba(76, 161, 175, 0.2) !important;
    transform: translateY(-5px);
  }

  /* ========== HEADER DEL FORMULARIO ========== */
  .login-glass-header {
    text-align: center;
    margin-bottom: 32px;
  }

  .login-logo-circle {
    position: relative;
    width: 100px;
    height: 100px;
    margin: 0 auto 20px;
  }

  .login-logo-glass {
    width: 100%;
    height: 100%;
    object-fit: contain;
    border-radius: 50%;
    position: relative;
    z-index: 2;
    background: rgba(255, 255, 255, 0.9);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(76, 161, 175, 0.3);
    padding: 12px;
    box-shadow: 0 4px 20px rgba(31, 78, 103, 0.2);
  }

  .login-logo-glow {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 120px;
    height: 120px;
    background: radial-gradient(circle, var(--hs-cyan), transparent 70%);
    border-radius: 50%;
    filter: blur(20px);
    opacity: 0.4;
    animation: pulseGlow 4s infinite ease-in-out;
  }

  @keyframes pulseGlow {
    0%, 100% { opacity: 0.3; transform: translate(-50%, -50%) scale(1); }
    50% { opacity: 0.6; transform: translate(-50%, -50%) scale(1.05); }
  }

  .login-glass-title {
    font-size: 28px;
    font-weight: 800;
    background: linear-gradient(135deg, #fff, var(--hs-cyan)) !important;
    -webkit-background-clip: text !important;
    -webkit-text-fill-color: transparent !important;
    background-clip: text !important;
    text-shadow: 0 2px 10px rgba(76, 161, 175, 0.3) !important;
    letter-spacing: 0.5px !important;
    font-family: 'Iceland', cursive !important;
    margin: 0 0 8px 0;
  }

  .login-glass-subtitle {
    color: rgba(255, 255, 255, 0.7) !important;
    font-size: 14px;
    margin: 0;
  }

  /* ========== SELECTOR DE MÉTODO ========== */
  .login-method-selector {
    margin-bottom: 32px;
  }

  .login-selector-tabs {
    display: flex;
    background: rgba(10, 17, 32, 0.3) !important;
    backdrop-filter: blur(20px) !important;
    border-radius: 16px !important;
    padding: 4px;
    border: 1px solid rgba(76, 161, 175, 0.1);
    box-shadow: inset 0 2px 8px rgba(0, 0, 0, 0.3);
  }

  .login-tab-btn {
    flex: 1;
    padding: 14px;
    border: none;
    background: transparent;
    border-radius: 12px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    cursor: pointer;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    color: rgba(255, 255, 255, 0.6);
    font-size: 12px;
    font-weight: 500;
  }

  .login-tab-btn i {
    font-size: 20px;
    transition: all 0.3s ease;
  }

  .login-tab-btn.active {
    background: linear-gradient(135deg, rgba(31, 78, 103, 0.3), rgba(76, 161, 175, 0.2)) !important;
    color: white;
    box-shadow: 0 4px 15px rgba(76, 161, 175, 0.4);
    font-weight: 600;
  }

  .login-tab-btn.active i {
    color: var(--hs-cyan);
    text-shadow: 0 0 15px rgba(76, 161, 175, 0.5);
  }

  .login-tab-btn:hover:not(.active) {
    background: rgba(76, 161, 175, 0.1);
    color: white;
    transform: translateY(-2px);
  }

  /* ========== INPUTS GLASS ========== */
  .login-input-group-glass {
    position: relative;
    margin-bottom: 28px;
  }

  .login-input-icon {
    position: absolute;
    left: 20px;
    top: 50%;
    transform: translateY(-50%);
    color: rgba(255, 255, 255, 0.5);
    font-size: 20px;
    z-index: 2;
    transition: color 0.3s ease;
  }

  .login-glass-input {
    width: 100%;
    padding: 18px 20px 18px 60px;
    background: rgba(10, 17, 32, 0.3) !important;
    border: 1.5px solid rgba(76, 161, 175, 0.2) !important;
    color: #fff !important;
    border-radius: 16px !important;
    backdrop-filter: blur(20px) !important;
    -webkit-backdrop-filter: blur(20px) !important;
    font-size: 16px !important;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    box-shadow: 
      inset 0 2px 8px rgba(0, 0, 0, 0.2),
      0 1px 0 rgba(255, 255, 255, 0.05) !important;
  }

  .login-glass-input:focus {
    background: rgba(10, 17, 32, 0.4) !important;
    border: 1.5px solid var(--hs-cyan) !important;
    box-shadow: 
      0 0 0 4px rgba(76, 161, 175, 0.2),
      inset 0 2px 8px rgba(0, 0, 0, 0.3),
      0 1px 0 rgba(255, 255, 255, 0.1) !important;
    outline: none !important;
    transform: translateY(-2px);
  }

  .login-glass-input:focus + .login-input-icon {
    color: var(--hs-cyan);
    text-shadow: 0 0 10px rgba(76, 161, 175, 0.5);
  }

  .login-glass-input::placeholder {
    color: rgba(255, 255, 255, 0.4) !important;
  }

  .login-toggle-password {
    position: absolute;
    right: 20px;
    top: 50%;
    transform: translateY(-50%);
    background: none;
    border: none;
    color: rgba(255, 255, 255, 0.5);
    cursor: pointer;
    font-size: 20px;
    padding: 4px;
    transition: color 0.3s ease;
    z-index: 2;
  }

  .login-toggle-password:hover {
    color: var(--hs-cyan);
    text-shadow: 0 0 10px rgba(76, 161, 175, 0.5);
  }

  /* ========== OPCIONES DEL FORMULARIO ========== */
  .login-form-options {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 28px;
  }

  .login-checkbox-glass {
    display: flex;
    align-items: center;
    cursor: pointer;
    position: relative;
  }

  .login-checkbox-glass input {
    position: absolute;
    opacity: 0;
    cursor: pointer;
  }

  .login-checkmark {
    width: 22px;
    height: 22px;
    background: rgba(10, 17, 32, 0.3);
    border: 2px solid rgba(76, 161, 175, 0.3);
    border-radius: 6px;
    margin-right: 12px;
    transition: all 0.3s ease;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: inset 0 1px 3px rgba(0, 0, 0, 0.3);
  }

  .login-checkbox-glass input:checked ~ .login-checkmark {
    background: linear-gradient(135deg, var(--hs-blue), var(--hs-cyan)) !important;
    border-color: transparent;
    box-shadow: 0 0 15px rgba(76, 161, 175, 0.5) !important;
  }

  .login-checkmark::after {
    content: '✓';
    color: white;
    font-size: 14px;
    font-weight: bold;
    opacity: 0;
    transform: scale(0);
    transition: all 0.3s ease;
  }

  .login-checkbox-glass input:checked ~ .login-checkmark::after {
    opacity: 1;
    transform: scale(1);
  }

  .login-checkbox-label {
    color: rgba(255, 255, 255, 0.8);
    font-size: 14px;
    font-weight: 500;
  }

  .login-forgot-link {
    color: var(--hs-cyan) !important;
    text-decoration: none !important;
    font-size: 14px;
    font-weight: 600;
    position: relative;
    padding: 2px 0;
    transition: all 0.3s ease;
  }

  .login-forgot-link::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 0;
    height: 2px;
    background: linear-gradient(90deg, var(--hs-cyan), var(--hs-blue));
    transition: width 0.3s ease;
  }

  .login-forgot-link:hover {
    color: white !important;
  }

  .login-forgot-link:hover::after {
    width: 100%;
  }

  /* ========== BOTONES ========== */
  .login-glass-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    width: 100%;
    padding: 18px;
    border: none !important;
    border-radius: 16px !important;
    font-size: 16px;
    font-weight: 700 !important;
    cursor: pointer;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    margin-bottom: 16px;
    position: relative;
    overflow: hidden;
    font-family: 'Iceland', cursive !important;
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  .login-glass-btn::before {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(
      90deg,
      transparent,
      rgba(255, 255, 255, 0.2),
      transparent
    );
    transition: left 0.6s ease;
  }

  .login-glass-btn:hover::before {
    left: 100%;
  }

  .login-glass-btn.primary {
    background: linear-gradient(135deg, var(--hs-blue), var(--hs-cyan)) !important;
    color: white !important;
    box-shadow: 
      0 10px 30px rgba(31, 78, 103, 0.4),
      inset 0 1px 0 rgba(255, 255, 255, 0.3),
      inset 0 -1px 0 rgba(0, 0, 0, 0.2) !important;
  }

  .login-glass-btn.primary:hover {
    background: linear-gradient(135deg, var(--hs-cyan), var(--hs-blue)) !important;
    transform: translateY(-3px) scale(1.02);
    box-shadow: 
      0 20px 40px rgba(76, 161, 175, 0.6),
      inset 0 1px 0 rgba(255, 255, 255, 0.4),
      inset 0 -1px 0 rgba(0, 0, 0, 0.2) !important;
  }

  .login-glass-btn.outline {
    background: transparent !important;
    color: var(--hs-cyan) !important;
    border: 1.5px solid var(--hs-cyan) !important;
    font-weight: 500 !important;
  }

  .login-glass-btn.outline:hover {
    background: rgba(76, 161, 175, 0.1) !important;
    transform: translateY(-2px);
    box-shadow: 0 8px 25px rgba(76, 161, 175, 0.3) !important;
  }

  .login-glass-btn.google {
    background: white !important;
    color: #333 !important;
    border: 1.5px solid rgba(255, 255, 255, 0.3) !important;
    box-shadow: 0 8px 25px rgba(0, 0, 0, 0.15) !important;
    font-weight: 500 !important;
    text-transform: none;
  }

  .login-glass-btn.google:hover {
    box-shadow: 0 12px 35px rgba(0, 0, 0, 0.25) !important;
    transform: translateY(-2px);
    border-color: var(--hs-cyan) !important;
  }

  /* ========== SEPARADOR ========== */
  .login-separator {
    display: flex;
    align-items: center;
    margin: 28px 0;
    color: rgba(255, 255, 255, 0.5);
    font-size: 14px;
    font-weight: 500;
  }

  .login-separator::before,
  .login-separator::after {
    content: '';
    flex: 1;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(76, 161, 175, 0.3), transparent);
    margin: 0 15px;
  }

  /* ========== SECCIONES DEL FORMULARIO ========== */
  .login-form-section {
    display: none;
    animation: fadeInUp 0.5s ease;
  }

  @keyframes fadeInUp {
    from { 
      opacity: 0; 
      transform: translateY(20px); 
    }
    to { 
      opacity: 1; 
      transform: translateY(0); 
    }
  }

  .login-form-section.active {
    display: block;
  }

  /* ========== SECCIÓN BIOMÉTRICA ========== */
  .login-biometric-header {
    text-align: center;
    margin-bottom: 32px;
  }

  .login-biometric-icon {
    width: 90px;
    height: 90px;
    background: rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(20px);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 20px;
    border: 2px solid rgba(76, 161, 175, 0.3);
    box-shadow: 
      0 10px 30px rgba(0, 0, 0, 0.3),
      inset 0 1px 0 rgba(255, 255, 255, 0.2);
  }

  .login-biometric-icon i {
    font-size: 36px;
    background: linear-gradient(135deg, var(--hs-cyan), var(--hs-blue));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .login-face-scanner,
  .login-voice-scanner {
    text-align: center;
  }

  .login-scanner-frame {
    position: relative;
    width: 250px;
    height: 250px;
    margin: 0 auto 28px;
    border-radius: 20px;
    overflow: hidden;
    border: 2px solid rgba(76, 161, 175, 0.4);
    background: rgba(0, 0, 0, 0.2);
    box-shadow: 
      inset 0 0 30px rgba(0, 0, 0, 0.3),
      0 10px 40px rgba(76, 161, 175, 0.3);
  }

  .login-scanner-frame video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .login-scanner-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .login-face-guide {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 180px;
    height: 220px;
    border: 2px dashed rgba(76, 161, 175, 0.6);
    border-radius: 40%;
  }

  .login-scan-line {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 3px;
    background: linear-gradient(90deg, transparent, var(--hs-cyan), transparent);
    animation: scan 2s linear infinite;
    box-shadow: 0 0 15px rgba(76, 161, 175, 0.7);
  }

  @keyframes scan {
    0% { top: 0; }
    100% { top: 100%; }
  }

  .login-scanner-controls {
    display: flex;
    gap: 15px;
    justify-content: center;
    margin-bottom: 25px;
    flex-wrap: wrap;
  }

  /* ========== MEDIDOR DE CONFIANZA ========== */
  .login-confidence-meter {
    margin-top: 25px;
    animation: slideUp 0.5s ease;
    padding: 20px;
    background: rgba(10, 17, 32, 0.3);
    border-radius: 16px;
    border: 1px solid rgba(76, 161, 175, 0.2);
    box-shadow: inset 0 2px 10px rgba(0, 0, 0, 0.3);
  }

  @keyframes slideUp {
    from { opacity: 0; transform: translateY(30px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .login-meter-label {
    display: flex;
    justify-content: space-between;
    margin-bottom: 12px;
    color: rgba(255, 255, 255, 0.9);
    font-size: 14px;
    font-weight: 600;
  }

  .login-meter-bar {
    height: 10px;
    background: rgba(0, 0, 0, 0.3);
    border-radius: 5px;
    overflow: hidden;
    box-shadow: inset 0 2px 5px rgba(0, 0, 0, 0.4);
  }

  .login-meter-fill {
    height: 100%;
    background: linear-gradient(90deg, #e74c3c, #f39c12, #00b894);
    border-radius: 5px;
    width: 0%;
    transition: width 0.5s ease;
    box-shadow: 0 0 15px rgba(0, 184, 148, 0.4);
  }

  /* ========== RECONOCIMIENTO DE VOZ ========== */
  .login-voice-visualizer {
    margin: 32px 0;
    padding: 25px;
    background: rgba(10, 17, 32, 0.3);
    border-radius: 16px;
    border: 1px solid rgba(76, 161, 175, 0.2);
  }

  .login-visualizer-bars {
    display: flex;
    align-items: flex-end;
    justify-content: center;
    gap: 6px;
    height: 50px;
  }

  .login-visualizer-bars .bar {
    width: 8px;
    background: linear-gradient(180deg, var(--hs-cyan), var(--hs-blue));
    border-radius: 4px;
    animation: voicePulse 1.5s ease-in-out infinite;
  }

  @keyframes voicePulse {
    0%, 100% { transform: scaleY(0.5); opacity: 0.7; }
    50% { transform: scaleY(1); opacity: 1; }
  }

  .login-visualizer-bars .bar:nth-child(1) { animation-delay: 0s; height: 15px; }
  .login-visualizer-bars .bar:nth-child(2) { animation-delay: 0.2s; height: 25px; }
  .login-visualizer-bars .bar:nth-child(3) { animation-delay: 0.4s; height: 35px; }
  .login-visualizer-bars .bar:nth-child(4) { animation-delay: 0.6s; height: 30px; }
  .login-visualizer-bars .bar:nth-child(5) { animation-delay: 0.8s; height: 20px; }

  .login-phrase-display {
    background: rgba(10, 17, 32, 0.4);
    backdrop-filter: blur(20px);
    border-radius: 16px;
    padding: 25px;
    margin: 28px 0;
    border: 1px solid rgba(76, 161, 175, 0.3);
    font-style: italic;
    color: rgba(255, 255, 255, 0.9);
    font-size: 16px;
    font-weight: 500;
    box-shadow: 0 8px 25px rgba(31, 78, 103, 0.2);
    text-align: center;
  }

  /* ========== ENLACES DE PIE ========== */
  .login-footer-links {
    text-align: center;
    margin-top: 28px;
    padding-top: 28px;
    border-top: 1px solid rgba(76, 161, 175, 0.2);
    color: rgba(255, 255, 255, 0.6);
    font-size: 14px;
  }

  .login-footer-links a {
    color: var(--hs-cyan) !important;
    text-decoration: none !important;
    font-weight: 600;
    transition: color 0.3s ease;
  }

  .login-footer-links a:hover {
    color: white !important;
    text-decoration: underline !important;
  }

  /* ========== ALERTAS ========== */
  .login-alert {
    border-radius: 12px !important;
    background: rgba(10, 17, 32, 0.3) !important;
    border: 1px solid rgba(76, 161, 175, 0.3) !important;
    color: white !important;
    backdrop-filter: blur(10px) !important;
    padding: 15px 20px !important;
