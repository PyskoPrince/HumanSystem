  <script>
       // --- 1. LÓGICA DEL MENÚ DE GADGETS (CORREGIDO) ---
    const gadgetToggler = document.getElementById('gadgetToggler'); // ID CORRECTO
    const gadgetsMenu = document.getElementById('gadgetsMenu');
    const mobileOverlay = document.getElementById('mobileOverlay');

    if (gadgetToggler && gadgetsMenu && mobileOverlay) {
        gadgetToggler.addEventListener('click', function(e) {
            e.preventDefault();
            gadgetsMenu.classList.toggle('active');
            mobileOverlay.classList.toggle('active');
        });

        mobileOverlay.addEventListener('click', function() {
            gadgetsMenu.classList.remove('active');
            mobileOverlay.classList.remove('active');
        });

        // Cierra el menú si se hace clic fuera de él
        document.addEventListener('click', function (e) {
            if (!gadgetsMenu.contains(e.target) && !gadgetToggler.contains(e.target)) {
                gadgetsMenu.classList.remove('active');
                mobileOverlay.classList.remove('active');
            }
        });
    }
    // -


    // --- 2. LÓGICA DE NAVEGACIÓN ENTRE SECCIONES ---
    const navLinks = document.querySelectorAll('.navbar-nav .nav-link');
    const contentSections = document.querySelectorAll('.content-section');
    
    function switchSection(targetId) {
        contentSections.forEach(section => section.classList.remove('active'));
        navLinks.forEach(link => link.classList.remove('active'));

        const targetSection = document.getElementById(targetId);
        if (targetSection) targetSection.classList.add('active');

        const targetLink = document.querySelector(`.nav-link[href="#${targetId}"]`);
        if (targetLink) targetLink.classList.add('active');
    }

    navLinks.forEach(link => {
        const targetId = link.getAttribute('href');
        if (targetId && targetId.startsWith('#')) {
            link.addEventListener('click', (e) => {
                e.preventDefault();
                switchSection(targetId.substring(1));
                // Opcional: cierra el menú de bootstrap en móvil
                const navbarCollapse = document.getElementById('navbarNav');
                if (window.getComputedStyle(document.querySelector('.navbar-toggler')).display !== 'none') {
                    $(navbarCollapse).collapse('hide');
                }
            });
        }
    });



    document.addEventListener('DOMContentLoaded', function() {
        // Search Button Handler
        document.getElementById('searchButton').addEventListener('click', function() {
            Swal.fire({
                title: 'Ingresa el folio de la solicitud',
                input: 'text',
                inputPlaceholder: 'Folio',
                showCancelButton: true,
                confirmButtonText: 'Buscar',
                cancelButtonText: 'Cancelar',
                inputValidator: (value) => {
                    if (!value) {
                        return '¡Debes ingresar un folio!';
                    }
                }
            }).then((result) => {
                if (result.isConfirmed) {
                    const folio = result.value;
                    // AQUÍ CAMBIAMOS LA LÓGICA PARA LLAMAR AL BACKEND
                    fetch('/search-folio', { // Nuevo endpoint para buscar folio
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                        },
                        body: JSON.stringify({ folio: folio })
                    })
                    .then(response => response.json())
                    .then(data => {
                        if (data.success) {
                            Swal.fire({
                                icon: 'success',
                                title: 'Éxito',
                                html: `Solicitud con folio <strong>${folio}</strong> encontrada correctamente.<br><pre>${JSON.stringify(data.solicitud, null, 2)}</pre>` // Muestra los datos de la solicitud
                            });
                        } else {
                            Swal.fire({
                                icon: 'error',
                                title: 'Fallo',
                                text: data.message || `No se encontró ninguna solicitud con el folio ${folio}.`
                            });
                        }
                    })
                    .catch(error => {
                        console.error('Error en búsqueda:', error);
                        Swal.fire({
                            icon: 'error',
                            title: 'Error de conexión',
                            text: 'Hubo un problema al buscar el folio.'
                        });
                    });
                }
            });
        });

        // Contact Form Handler
        document.getElementById('contactForm').addEventListener('submit', function(event) {
            event.preventDefault();
            const formData = new FormData(this);
            const nombre = formData.get('nombre');
            const correo = formData.get('correo');
            const mensaje = formData.get('mensaje');

            if (!nombre || !correo || !mensaje) {
                Swal.fire({
                    icon: 'error',
                    title: 'Campos incompletos',
                    text: 'Por favor, completa todos los campos.'
                });
                return;
            }

            // El endpoint es /contact y el método POST ya está configurado
            fetch('/contact', {
                method: 'POST',
                body: formData // FormData será procesado por multer en el backend
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    Swal.fire({
                        icon: 'success',
                        title: 'Contacto exitoso',
                        text: `Tu mensaje ha sido enviado correctamente. Tu folio es: ${data.folio}` // Mostrar el folio
                    });
                    this.reset();
                } else {
                    Swal.fire({
                        icon: 'error',
                        title: 'Error',
                        text: data.message || 'Hubo un error al enviar el mensaje.'
                    });
                }
            })
            .catch(error => {
                console.error('Error:', error);
                Swal.fire({
                    icon: 'error',
                    title: 'Error de conexión',
                    text: 'Hubo un error al procesar tu solicitud.'
                });
            });
        });
    });
    </script>

