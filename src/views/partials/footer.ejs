<script>
  document.addEventListener('DOMContentLoaded', function () {
    if (window.location.hash === '#termsModal') {
      $('#termsModal').modal('show');
    }

    // --- LÓGICA DE BOTONES DE AUTENTICACIÓN AÑADIDA ---
    const authButtons = document.querySelectorAll('.btn-group-toggle .btn');
    const formSections = {
        'facial': document.getElementById('facialFormFields'),
        'traditional': document.getElementById('traditionalFormFields'),
        'voice': document.getElementById('voiceFormFields')
    };

    function switchAuthMethod(method) {
        // Oculta todas las secciones
        Object.values(formSections).forEach(section => {
            if (section) {
                section.style.display = 'none';
            }
        });

        // Muestra la sección seleccionada
        const selectedSection = formSections[method];
        if (selectedSection) {
            selectedSection.style.display = 'block';
        }
    }
    
    // El formulario tradicional ya está visible por defecto por el HTML.
    // Escucha clics en los botones de grupo
    authButtons.forEach(button => {
        button.addEventListener('click', function() {
            const method = this.getAttribute('data-auth-method');
            // La clase 'active' la maneja Bootstrap con data-toggle="buttons"
            switchAuthMethod(method);
        });
    });
    // --- FIN LÓGICA DE BOTONES DE AUTENTICACIÓN ---
});
</script>
  

  <script>
    // --- MANEJAR ESTADO DE PAGO ---
    document.addEventListener('DOMContentLoaded', async () => {
      const urlParams = new URLSearchParams(window.location.search);
      const estadoPago = urlParams.get('estado_pago');

      if (estadoPago === 'exitoso') {
        Swal.fire({
          title: 'Pago Exitoso',
          text: 'Tu pago se ha completado con éxito. ¡Gracias por tu compra!',
          icon: 'success',
          confirmButtonText: 'Aceptar',
          confirmButtonColor: '#1F4E67'
        }).then((result) => {
          if (result.isConfirmed) window.location.href = '/';
        });
      } else if (estadoPago === 'cancelado') {
        Swal.fire({
          title: 'Pago Cancelado',
          text: 'Tu pago ha sido cancelado. Puedes intentar nuevamente más tarde.',
          icon: 'error',
          confirmButtonText: 'Aceptar',
          confirmButtonColor: '#d33'
        }).then((result) => {
          if (result.isConfirmed) window.location.href = '/';
        });
      }
    });
  </script>

  

  <script>
// Función para manejar la suscripción a un plan
function subscribeToPlan(planName) {
    const plan = planes.find(p => p.nombre === planName);
    
    if (plan) {
        Swal.fire({
            title: `Suscribirse a ${planName}`,
            html: `
                <div style="text-align: left;">
                    <p>Estás a punto de suscribirte al plan <strong>${planName}</strong>.</p>
                    ${plan.precio > 0 ? 
                        `<p>Precio: <strong>${plan.precio}${plan.periodo}</strong></p>
                         <p>Serás redirigido a nuestro procesador de pagos seguro.</p>` : 
                        '<p>¡Puedes comenzar a usar las funciones básicas inmediatamente!</p>'}
                </div>
            `,
            icon: 'info',
            showCancelButton: true,
            confirmButtonText: plan.precio > 0 ? 'Proceder al pago' : 'Activar gratis',
            cancelButtonText: 'Cancelar',
            confirmButtonColor: plan.color
        }).then((result) => {
            if (result.isConfirmed) {
                Swal.fire({
                    title: '¡Suscripción exitosa!',
                    html: `
                        <div style="text-align: left;">
                            <p>Ahora tienes acceso al plan <strong>${planName}</strong>.</p>
                            ${plan.precio > 0 ? 
                                `<p>Se ha cobrado exitosamente ${plan.precio}${plan.periodo}.</p>` : ''}
                            <p>Disfruta de todas las funciones disponibles.</p>
                        </div>
                    `,
                    icon: 'success',
                    confirmButtonColor: plan.color
                });
            }
        });
    }
}



