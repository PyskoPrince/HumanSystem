<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= typeof title !== 'undefined' ? title : 'Human System' %></title>
    <link rel="icon" href="https://i.ibb.co/G3XDtMJ/Logoapp.png">

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.1/dist/css/bootstrap.min.css" integrity="sha384-zCbKRCUGaJDkqS1kPbPd7TveP5iyJE0EjAuZQTgFLD2ylzuqKfdKlfG/eSrtxUkn" crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/croppie/2.6.5/croppie.min.css">
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Iceland&family=Play:wght@400;700&display=swap" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        window.FontAwesomeConfig = { autoReplaceSvg: false };
    </script> 

    <style>
        /* ==========================================================================
           1. ESTILOS GENERALES Y UTILIDADES
           ========================================================================== */
        *, *::before, *::after {
            box-sizing: border-box;
        }

        body {
            font-family: 'Iceland', sans-serif;
            color: #1F4E67;
            margin: 0;
            padding: 0;
            overflow-x: hidden;
            font-weight: 400;
            min-height: 100vh;
        }

        .container-fluid { padding: 0; margin: 0; width: 100%; }
        .blue-text { color: #1F4E67; }
        .red-text { color: #f40023; }
        .uppercase-input { text-transform: uppercase; }
        .hidden-section, .nav-item.hidden { display: none !important; }

        .content-module { display: none; }
        #seccionPerfil { display: block !important; }

        /* ==========================================================================
           2. ESTILOS DE BARRA DE NAVEGACIÓN (NAVBAR)
           ========================================================================== */
        .navbar {
            background: #fff;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.08);
            position: sticky;
            top: 0;
            left: 0;
            right: 0;
            z-index: 1000;
            padding: 0.5rem 2rem;
            transition: background-color 0.3s ease;
        }

        /* Marca y Logo */
        .navbar-brand-container { position: relative; }
        .navbar-brand {
            display: flex;
            align-items: center;
            font-weight: 700;
            color: #1F4E67;
            font-size: 1.6rem;
            text-decoration: none;
        }
        .navbar-brand img.brand-logo {
            height: 60px;
            width: 60px;
            border-radius: 20%;
            transition: transform 0.8s ease;
            margin-right: 10px;
        }
        .navbar-brand img.brand-logo:hover { transform: scale(1.1); }

        .brand-text-stack {
            display: flex;
            flex-direction: column;
            line-height: 1.1;
            text-align: left;
        }
        .brand-name {
            font-weight: bold;
            font-size: 1.4rem;
            display: block;
        }
        .brand-name em { font-style: italic; }
        .text-human { color: #1f4e67; }
        .text-system { color: #f10821; }
        .brand-sub {
            font-size: 0.7rem;
            color: #444;
            font-weight: bold;
            display: block;
            letter-spacing: 0.3px;
        }

        /* Menú Hamburguesa */
        .navbar-toggler {
            border: none;
            background: transparent;
            padding: 0;
            width: 40px;
            height: 20px;
            cursor: pointer;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }
        .navbar-toggler:focus { outline: none !important; box-shadow: none !important; }
        .navbar-toggler:hover .line { background: #d71d00; }
        
        .hamburger {
            width: 28px;
            height: 18px;
            position: relative;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }
        .hamburger .line {
            width: 100%;
            height: 3px;
            background: #1F4E67;
            border-radius: 3px;
            transition: all 0.3s ease-in-out;
            transform-origin: center;
        }
        .navbar-toggler[aria-expanded="true"] .line:nth-child(1) { transform: translateY(7px) rotate(45deg); }
        .navbar-toggler[aria-expanded="true"] .line:nth-child(2) { opacity: 0; transform: scale(0); }
        .navbar-toggler[aria-expanded="true"] .line:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

        /* Enlaces Públicos */
        .nav-link {
            padding: 0.6rem 1.4rem;
            color: #ffffff !important;
            text-decoration: none;
            border-radius: 8px;
            transition: all 0.3s ease;
            margin: 0 10px;
            font-size: 14px;
            font-weight: 500;
            letter-spacing: 0.5px;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .nav-link:hover { transform: translateY(-2px); opacity: 0.95; }
        .nav-link i { font-size: 1.1rem; }
        
        .nav-link.info { background: linear-gradient(45deg, #797c7e, #a0a8b0); }
        .nav-link.registro { background: linear-gradient(45deg, #d71d00, #fd4662); }
        .nav-link.ingreso { background: linear-gradient(45deg, #1F4E67, #2c758c); }
        .nav-text-mobile { display: none; }

        /* Navbar Autenticado */
        .navbar-authenticated-container {
            display: flex;
            align-items: center;
            justify-content: space-between;
            width: 100%;
            position: relative; /* Asegura el contexto para el menú absoluto */
        }
    
        /* Menú de Gadgets */
        .gadgets-menu {
            position: absolute;
            top: calc(100% + 5px);
            left: 50%; /* Centrado relativo a su contenedor superior para evitar desbordes */
            background: #fff;
            border-radius: 8px;
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);
            display: none;
            flex-direction: column;
            align-items: center;
            z-index: 1001;
            max-height: 80vh;
            overflow-y: auto;
            width: 70px;
            opacity: 0;
            transform: translateX(-50%) scaleY(0);
            transform-origin: top;
            transition: opacity 0.3s ease, transform 0.3s ease;
        }
        .gadgets-menu.active {
            display: flex;
            opacity: 1;
            transform: translateX(-50%) scaleY(1);
        }
        .gadgets-menu ul {
            list-style: none;
            padding: 10px 0;
            margin: 0;
            width: 100%;
            display: flex;
            flex-direction: column;
            align-items: center;
        }
        .gadget {
            position: relative;
            width: 50px;
            height: 50px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 10px;
            font-size: 1.5rem;
            text-decoration: none;
            transition: all 0.3s ease;
            background: #f8f9fa; /* Reemplazo seguro de variable omitida */
            margin: 5px 0;
            color: #1F4E67;
            box-shadow: 0 2px 5px rgba(0,0,0,0.05);
        }
        .gadget:hover, .gadget:focus { 
            transform: scale(1.1); 
            background: #1F4E67; 
            color: #fff; 
            outline: none;
        }
        .logout-item { background: #ffeaea; color: #d71d00; }
        .logout-item:hover { background: #d71d00; color: #fff; }

        /* ==========================================================================
           3. ESTILOS ESPECÍFICOS DEL INDEX
           ========================================================================== */
        .page-index #sidebar {
            display: none;
            position: fixed;
            top: 70px; left: 8px;
            height: calc(100% - 70px);
            width: 25%;
            background-color: whitesmoke;
            z-index: 999;
            padding-left: 30px;
            overflow-y: auto;
            flex-direction: column;
            align-items: flex-start;
            justify-content: flex-start;
        }
        .page-index #sidebar .navbar-nav { width: 100%; flex-direction: column; }
        .page-index #sidebar .nav-item { border-bottom: 2px solid #17a3b851; padding-bottom: 10px; width: 100%; }
        .page-index #sidebar .nav-item:last-child { border-bottom: none; }
        .page-index #sidebar .nav-item a { color: #17a2b8; width: 100%; text-decoration: none; font-size: 25px; }
        .page-index #sidebar .nav-item a:hover,
        .page-index #sidebar .nav-item a.active { color: #2c758c; text-decoration: underline; }
        
        .page-index .nav-link,
        .page-index .nav-calendar,
        .page-index .nav-transactions,
        .page-index .nav-files,
        .page-index .nav-user,
        .page-index .nav-building,
        .page-index .nav-statistics,
        .page-index .nav-documents {
            padding: 0.6rem 1.2rem;
            color: #000000 !important;
            font-size: 14px;
            font-weight: 500;
            margin: 0 5px;
            border-radius: 8px;
            display: flex; 
            align-items: center;
            transition: all 0.3s ease;
            cursor: pointer;
        }
        .page-index .nav-link:hover,
        .page-index .nav-link.active {
            background-color: #f0f2f5;
            color: #1F4E67 !important;
            transform: translateY(-2px);
        }
        .page-index .main-content-wrapper {
            box-shadow: 4px 4px 16px rgba(0, 0, 0, 0.1);
            background: linear-gradient(to bottom, #1F4E67, #d71d00);
            border-radius: 30px;
        }
        .page-index .content-section { display: none; }
        .page-index .content-section.active { display: block; animation: fadeIn 0.5s; }

        @keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }

        /* ==========================================================================
           4. RESPONSIVE
           ========================================================================== */
        @media (max-width: 991px) {
            .main-content-wrapper { flex-direction: column; }
            #seccionPerfil { width: 100%; }
            .nav-text-mobile { display: inline !important; }

            .navbar .navbar-collapse {
                background: transparent;
                padding: 0;
                margin-top: 5px;
                box-shadow: none;
                border-top: 1px solid #e0e0e0;
            }

            /* Corrección de especificidad para evitar !important */
            .navbar-collapse .nav-item { 
                width: 100%; 
                margin: 5px 0; 
                padding: 0; 
            }

            .navbar-collapse .nav-link { 
                width: 100%; 
                margin: 0; 
                padding: 12px 15px; 
                justify-content: center; 
                box-sizing: border-box;
            }
        }

        @media (max-width: 768px) {
            .container { padding: 0 20px; }
            .navbar .navbar-collapse { background: #ffffff; border-radius: 0; }
            
            /* Ajuste para que el menú gadgets sea más amigable en pantallas muy pequeñas */
            .gadgets-menu { 
                width: 50px; 
                left: 50%; 
            }
            .gadget { 
                width: 40px; 
                height: 40px; 
                font-size: 1.2rem; 
            }
        }
    </style>
</head>
<body class="<%= typeof pageClass !== 'undefined' ? pageClass : '' %>">