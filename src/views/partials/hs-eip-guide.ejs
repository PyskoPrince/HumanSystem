<section class="section-dark-premium" id="guia-eip" style="padding:100px 0;">
    <div class="hs-hero-blob" style="top:-10%; right:-5%;"></div>
    <div class="container position-relative" style="z-index:2;">
        <div class="row align-items-center">
            <div class="col-lg-6 ent-reveal-left mb-5 mb-lg-0 text-center">
                <img src="https://storage.googleapis.com/humansystem/GUIA_EIP_3D_MOCKUP.png"
