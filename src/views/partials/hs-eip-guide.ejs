                     style="max-width:420px; width:100%; filter:drop-shadow(0 25px 45px rgba(0,0,0,0.5));">
            </div>
            <div class="col-lg-6 ent-reveal-right">
                <span class="hs-badge-premium" style="background:var(--hs-red);">RECURSO EXCLUSIVO</span>
