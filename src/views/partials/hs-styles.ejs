<style>
    @import url('https://fonts.googleapis.com/css2?family=Iceland&display=swap');

    :root {
        --hs-dark: #0a0e14;
        --hs-blue: #1F4E67;
        --hs-cyan: #4ca1af;
        --hs-red: #d71d00;
        --hs-gold: #fcc404;
        --hs-dark-blue: #0a1120;
        --hs-warning: #FFC107;
        --slate-700: #334155;
        --slate-500: #64748b;
        --glass-bg: rgba(255, 255, 255, 0.05);
        --glass-border: rgba(255, 255, 255, 0.1);
        --font-tech: 'Monaco', 'Consolas', monospace;
        --easing-premium: cubic-bezier(0.23, 1, 0.32, 1);
    }

    body { background: var(--hs-dark); color: white; }

    .hs-landing-wrapper {
        color: white;
        font-family: 'Iceland', sans-serif !important;
        overflow-x: hidden;
    }

    .hs-landing-wrapper h1, .hs-landing-wrapper h2, .hs-landing-wrapper h3,
    .hs-landing-wrapper h4, .hs-landing-wrapper h5, .hs-landing-wrapper h6,
    .hs-landing-wrapper p, .hs-landing-wrapper span, .hs-landing-wrapper div,
    .hs-landing-wrapper a, .hs-landing-wrapper li, .hs-landing-wrapper strong,
    .hs-landing-wrapper em, .hs-landing-wrapper input, .hs-landing-wrapper textarea,
    .hs-landing-wrapper button {
        font-family: 'Iceland', sans-serif !important;
        letter-spacing: 1px;
    }

    h1, h2, h3, h4, h5, h6 { font-weight: 700; }

.hs-landing-wrapper {
    color: white;
    font-family: 'Iceland', sans-serif !important;
    overflow-x: hidden;
}
.hs-landing-wrapper .container {
    padding-left: clamp(20px, 5vw, 50px) !important;
    padding-right: clamp(20px, 5vw, 50px) !important;
}
    .text-gradient {
        background: linear-gradient(135deg, #fff, var(--hs-cyan));
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }
    .text-justify-premium { text-align: justify; text-justify: inter-word; line-height: 1.7; hyphens: auto; }
    .text-success { color: #28a745 !important; }
    .text-danger { color: #d71d00 !important; }
    .text-primary { color: #1F4E67 !important; }
    .text-info { color: #17a2b8 !important; }
    .text-warning { color: #FFC107 !important; }
    .font-weight-bold { font-weight: 700 !important; }
    .lead { font-size: 1.15rem; font-weight: 300; opacity: 0.9; }

    .hs-badge-premium {
        background: linear-gradient(90deg, var(--hs-blue), var(--hs-cyan));
        color: white; padding: 8px 20px; border-radius: 50px;
        font-size: 0.9rem; text-transform: uppercase; letter-spacing: 2px;
        font-weight: 700; display: inline-block; margin-bottom: 25px;
        box-shadow: 0 5px 15px rgba(31, 78, 103, 0.4);
    }
    .tpill {
        background: rgba(255,255,255,0.05); border: 1px solid var(--glass-border);
        padding: 6px 14px; border-radius: 50px; font-size: 0.85rem;
        display: flex; align-items: center; gap: 8px; backdrop-filter: blur(5px);
        width: auto; font-family: monospace !important;
    }
    .tpill .dot-active {
        width: 8px; height: 8px; background: #28a745;
        border-radius: 50%; animation: pulseGreen 2s infinite;
    }
    .btn-hs {
        padding: 16px 32px; border-radius: 12px; font-weight: 600;
        font-size: 1.3rem; cursor: pointer; transition: all 0.3s ease;
        text-decoration: none; display: inline-flex; align-items: center;
        gap: 10px; text-transform: uppercase;
    }
    .btn-primary { background: linear-gradient(135deg, var(--hs-blue), var(--hs-cyan)); color: white; border: none; }
    .btn-primary:hover { transform: translateY(-3px); box-shadow: 0 10px 25px rgba(76,161,175,0.4); color: white; }
    .btn-outline { background: transparent; border: 2px solid var(--hs-cyan); color: var(--hs-cyan); }
    .btn-outline:hover { background: rgba(76,161,175,0.1); transform: translateY(-3px); color: white; }
    .btn-glow {
        padding: 16px 40px; background: var(--hs-red); color: white; border: none;
        font-weight: 700; box-shadow: 0 0 30px rgba(241,8,33,0.4); transition: 0.3s;
        text-transform: uppercase; text-decoration: none; display: inline-block; border-radius: 8px;
    }
    .btn-glow:hover { box-shadow: 0 0 50px rgba(241,8,33,0.8); transform: scale(1.05); color: white; }
    .btn-submit-premium {
        background: linear-gradient(90deg, var(--hs-blue), var(--hs-cyan));
        border: none; color: white; font-weight: 700; padding: 14px;
        border-radius: 12px; transition: all 0.3s ease; text-transform: uppercase; letter-spacing: 1px;
    }
    .btn-submit-premium:hover { transform: translateY(-2px); box-shadow: 0 10px 20px rgba(76,161,175,0.4); filter: brightness(1.1); }

    .section-dark-premium {
        background: linear-gradient(135deg, #0a1120 0%, var(--hs-blue) 100%);
        position: relative; padding: 100px 0; color: white;
    }
    .section-dark-premium h2 { font-size: 3.5rem; font-weight: 700; text-transform: uppercase; }

    .section-convergent-white { background: #ffffff; padding: 100px 0; position: relative; }
    .impact-showcase { background: #ffffff; padding: 100px 0; overflow: hidden; }

    .hs-hero-main {
        position: relative; background: linear-gradient(135deg, var(--hs-dark) 0%, var(--hs-blue) 100%);
        overflow: hidden; padding: clamp(80px,10vw,120px) 0; color: white;
    }
    .hs-hero-blob {
        position: absolute; width: 600px; height: 600px;
        background: radial-gradient(circle, rgba(76,161,175,0.2) 0%, transparent 70%);
        filter: blur(80px); z-index: 0; pointer-events: none;
    }

    .hero-content { display: flex; flex-direction: column; align-items: center; justify-content: center; padding-bottom: 50px; }
    .hero-content h1 { font-size: clamp(3.5rem,6vw,6rem); font-weight: 800; margin-bottom: 20px; line-height: 1; text-transform: uppercase; }
    .hero-content p { font-size: clamp(1.4rem,2vw,1.8rem); color: rgba(255,255,255,0.8); max-width: 800px; margin: 0 auto 40px auto; text-align: center; }
    .hero-desc { margin-left: auto; margin-right: auto; border-top: 2px solid var(--hs-red); padding-top: 20px; }

    .glass-form-style, .glass-form-container, .hs-glass-panel {
        background: rgba(15,23,42,0.6); backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px);
        border: 1px solid var(--hs-cyan); border-radius: 24px; padding: 35px 25px;
        box-shadow: 0 25px 50px -12px rgba(0,0,0,0.5); color: white; height: 100%; transition: all 0.3s ease;
    }
    .glass-form-style:hover, .hs-glass-panel:hover { transform: translateY(-5px); box-shadow: 0 30px 60px rgba(76,161,175,0.2); }
    .glass-form-style h5 { color: white !important; }
    .glass-form-style p { color: rgba(255,255,255,0.7) !important; }

    .form-glass-input {
        background: rgba(0,0,0,0.2) !important; border: 1px solid var(--glass-border) !important;
        color: white !important; border-radius: 12px !important; padding: 12px 15px !important; transition: all 0.3s ease;
    }
    .form-glass-input:focus {
        border-color: var(--hs-cyan) !important; box-shadow: 0 0 15px rgba(76,161,175,0.2) !important; background: rgba(0,0,0,0.4) !important;
    }

    .icon-box-modern {
        width: 60px; height: 60px; background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.1);
        border-radius: 15px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; margin-right: 1.5rem !important;
    }

    .heroCard {
        background: linear-gradient(180deg, rgba(255,255,255,0.06), rgba(255,255,255,0.03)); border: 1px solid rgba(255,255,255,0.12);
        border-radius: 20px; padding: 25px; position: relative; overflow: hidden;
    }
    .telemetry { display: grid; grid-template-columns: 1fr 1fr; gap: 15px; margin: 20px 0; }
    .tile { border-radius: 16px; padding: 15px; border: 1px solid rgba(255,255,255,0.1); background: rgba(0,0,0,0.2); }
    .tile .tvalue { font-size: 24px; font-weight: 700; margin: 5px 0; }
    .miniLine { margin-top: 12px; height: 4px; border-radius: 10px; background: rgba(255,255,255,0.1); position: relative; overflow: hidden; }
    .miniLine i { position: absolute; height: 100%; background: linear-gradient(90deg, var(--hs-blue), var(--hs-red)); border-radius: 10px; }

    .bento-grid-premium { display: grid; grid-template-columns: repeat(3, 1fr); gap: 25px; margin-top: 50px; }
    .hs-card-clean {
        text-align: center; display: flex; flex-direction: column; align-items: center; padding: 40px 30px;
        background: #f8f9fa; border-radius: 24px; position: relative; transition: all 0.4s var(--easing-premium);
        border: 1px solid rgba(0,0,0,0.05); height: 100%;
    }
    .hs-card-clean:hover { transform: translateY(-10px); box-shadow: 0 20px 40px rgba(0,0,0,0.1); }
    .hs-card-clean h3 { font-size: 1.8rem; font-weight: 700; color: var(--hs-blue); margin-bottom: 15px; }
    .hs-card-clean p { color: #555; font-size: 1.1rem; line-height: 1.4; margin-bottom: 25px; }
    .hs-card-clean::after {
        content: ''; position: absolute; top: 0; left: 50%; transform: translateX(-50%); width: 60px; height: 4px;
        border-radius: 0 0 10px 10px; background: linear-gradient(90deg, var(--hs-blue), var(--hs-cyan)); opacity: 0.3; transition: all 0.3s ease;
    }
    .hs-card-clean:hover::after { opacity: 1; width: 80px; }

    .hs-icon-frame {
        width: 80px; height: 80px; border-radius: 20px; display: flex; align-items: center; justify-content: center;
        margin-bottom: 25px; color: white; box-shadow: 0 10px 20px rgba(0,0,0,0.1); transition: all 0.4s cubic-bezier(0.34,1.56,0.64,1);
    }
    .hs-card-clean:hover .hs-icon-frame { transform: translateY(-5px) scale(1.05); }
    .hs-card-clean:hover .hs-icon-frame i { transform: scale(1.1); }
    .frame-cyan { background: linear-gradient(135deg, #4ca1af, #2c3e50); }
    .frame-blue { background: linear-gradient(135deg, #1F4E67, #0a1120); }
    .frame-red { background: linear-gradient(135deg, #d71d00, #8b0000); }
    .frame-gold { background: linear-gradient(135deg, #fcc404, #b8860b); }
    .frame-green { background: linear-gradient(135deg, #28a745, #1e7e34); }
    .frame-purple { background: linear-gradient(135deg, #6f42c1, #4527a0); }

    .impact-visual-card { position: relative; border-radius: 25px; overflow: visible; margin-bottom: 60px; }
    .main-image-wrapper { position: relative; border-radius: 25px; overflow: hidden; box-shadow: 0 20px 40px rgba(0,0,0,0.1); z-index: 1; height: 350px; }
    .main-image-wrapper img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.8s ease; }
   .main-image-wrapper video { transition: transform 0.8s ease; }
   .impact-visual-card:hover .main-image-wrapper img,
.impact-visual-card:hover .main-image-wrapper video { transform: scale(1.05); }
    .floating-data-card {
        position: absolute; bottom: -25px; left: -20px; width: 200px; background: white; border-radius: 18px; padding: 20px;
        box-shadow: 0 15px 35px rgba(0,0,0,0.15); z-index: 3; border: 1px solid rgba(0,0,0,0.05); animation: breathe 4s infinite ease-in-out;
    }
    .floating-data-card.right { left: auto; right: -20px; }
    .floating-data-card h3 { font-size: 2.5rem; font-weight: 800; margin-bottom: 0; line-height: 1; letter-spacing: -1px; }
    .floating-data-card span { font-size: 0.75rem; font-weight: bold; text-transform: uppercase; color: #6c757d; letter-spacing: 1px; }
    .impact-icon-box { width: 60px; height: 60px; border-radius: 15px; display: flex; align-items: center; justify-content: center; margin-bottom: 25px; }
    .text-container-impact { padding-left: 30px; }
    .text-container-impact.left-align { padding-left: 0; padding-right: 30px; }

    .hs-currency-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(130px, 1fr)); gap: 20px; margin-top: 25px; }
    .hs-currency-item {
        background: rgba(10,14,20,0.5); border-radius: 20px; padding: 25px 15px; text-align: center;
        border: 1px solid rgba(255,255,255,0.05); transition: all 0.3s; position: relative;
    }
    .hs-currency-item:hover { border-color: var(--hs-cyan); background: rgba(10,14,20,0.7); transform: translateY(-5px); }
    .hs-currency-item i { font-size: 2.5rem; margin-bottom: 12px; }
    .hs-currency-item h5 { font-size: 1.6rem; color: var(--hs-blue); font-weight: bold; margin-bottom: 5px; }
    .hs-currency-item.disabled { opacity: 0.55; }
    .hs-currency-item.disabled:hover { transform: none; border-color: rgba(255,255,255,0.05); background: rgba(10,14,20,0.5); }
    .pronto-badge {
        display: inline-block; background: rgba(252,196,4,0.15); border: 1px solid rgba(252,196,4,0.4);
        color: #fcc404; border-radius: 20px; padding: 2px 10px; font-size: 0.7rem;
        font-weight: 700; letter-spacing: 1px; text-transform: uppercase; margin-top: 4px;
    }

    .card-3d-container { position: relative; width: 280px; height: 420px; perspective: 1200px; z-index: 10; margin: 0 auto; }
    
    .card-3d {
        width: 100%; height: 100%;
        background-image: url('https://storage.googleapis.com/humansystem/HUMANID%20FRENTE.png');
        background-size: 100% 100%; background-position: center; background-repeat: no-repeat;
        border: 1px solid rgba(205,25,255,0.2); border-radius: 20px; position: relative;
        transform-style: preserve-3d; transition: transform 0.1s ease-out; will-change: transform;
    }
    .card-bg-animated { position: absolute; width: 100%; height: 100%; border-radius: 20px; overflow: hidden; z-index: 1; }
    .circuit-lines {
        position: absolute; width: 100%; height: 100%;
        background-image: linear-gradient(90deg, transparent 95%, rgba(76,161,175,0.1) 100%), linear-gradient(0deg, transparent 95%, rgba(76,161,175,0.1) 100%);
        background-size: 30px 30px; animation: circuitMove 20s linear infinite;
    }
    .hologram-layer {
        position: absolute; width: 100%; height: 100%;
        background: linear-gradient(45deg, transparent 45%, rgba(255,255,255,0.03) 50%, transparent 55%);
        animation: hologramMove 3s linear infinite;
    }
    .user-photo-container {
        position: relative; width: 120px; height: 120px; margin: 60px auto 12px; border-radius: 50%;
        overflow: hidden; border: 2px solid transparent; background: linear-gradient(45deg, var(--hs-cyan), var(--hs-red)) border-box;
    }   
    .user-photo { width: 100%; height: 100%; object-fit: cover; filter: grayscale(20%); }
    .brand-name-style {
        color: var(--hs-blue); font-weight: bold !important; font-style: italic; text-transform: uppercase;
        text-align: center; font-size: 1rem; margin-top: 0px; padding: 0 15px; 
        word-wrap: break-word; line-height: 1.0;
    }
    .user-info-clean { 
        width: 100%; display: flex; justify-content: center; align-items: center; 
        margin-top: 0px !important; min-height: 45px; 
    }

    #user-id-key {
        font-style: italic; font-weight: bold; color: var(--hs-blue) !important; 
        font-size: 0.75rem !important; opacity: 0.85;
        letter-spacing: 2px; text-transform: uppercase; margin-top: 0px !important; 
        position: relative; z-index: 5; text-align: center; line-height: 1.0;
    }

    #loader-wrapper {
        position: fixed; top: 0; left: 0; width: 100vw; height: 100vh;
        background: linear-gradient(135deg, var(--hs-dark) 0%, var(--hs-blue) 100%);
        z-index: 100000; display: flex; justify-content: center; align-items: center;
        transition: transform 0.8s cubic-bezier(0.77,0,0.175,1), opacity 0.5s;
    }
    .loader-hidden { transform: translateY(-100%) !important; opacity: 0 !important; pointer-events: none; }
    .biometric-fusion-container { display: flex; flex-direction: column; align-items: center; gap: 30px; }
    .loading-track { width: 240px; height: 2px; background: rgba(255,255,255,0.05); border-radius: 10px; overflow: hidden; position: relative; }
    .loading-fill { position: absolute; top: 0; left: 0; width: 0%; height: 100%; background: linear-gradient(90deg, var(--hs-cyan), var(--hs-red)); box-shadow: 0 0 10px var(--hs-red); }
    .loader-status { font-family: var(--font-tech); font-size: 10px; color: var(--hs-cyan); letter-spacing: 2px; text-transform: uppercase; display: flex; gap: 5px; }
    .status-dots { animation: dots-blink 1.5s infinite; }

    .video-modal-overlay {
        position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(10,17,32,0.9);
        backdrop-filter: blur(15px); display: none; justify-content: center; align-items: center;
        z-index: 100001; opacity: 0; transition: opacity 0.4s ease;
    }
    .video-modal-overlay.active { display: flex; opacity: 1; }
    .video-modal-content {
        width: 90%; max-width: 1000px; background: var(--hs-dark); border: 1px solid var(--hs-cyan);
        border-radius: 20px; padding: 10px; position: relative; box-shadow: 0 0 50px rgba(76,161,175,0.3);
    }
    .video-modal-close { position: absolute; top: -50px; right: 0; background: none; border: none; color: white; font-size: 40px; cursor: pointer; transition: transform 0.3s ease; }
    .video-modal-close:hover { color: var(--hs-red); transform: rotate(90deg); }
    .video-responsive-container { position: relative; padding-bottom: 56.25%; height: 0; overflow: hidden; border-radius: 15px; }
    .video-responsive-container iframe { position: absolute; top: 0; left: 0; width: 100%; height: 100%; }
    .video-footer-text { padding: 15px; text-align: center; font-size: 10px; color: var(--hs-cyan); letter-spacing: 3px; }

    .footer { background-color: white; border-top: 5px solid var(--hs-blue); position: relative; z-index: 10; color: #333; }
    .footer hr { border-top: 1px solid rgba(0,0,0,0.1); }
    .footer p, .footer li, .footer a { font-family: 'Iceland', sans-serif !important; }

    .premium-swal-popup { border: 1px solid rgba(76,161,175,0.2) !important; border-radius: 24px !important; box-shadow: 0 25px 50px -12px rgba(0,0,0,0.8) !important; }
    .premium-swal-button { border-radius: 50px !important; padding: 12px 30px !important; text-transform: uppercase !important; font-size: 0.8rem !important; font-weight: 700 !important; letter-spacing: 1px !important; }

    /* ── FAQ STYLES ── */
    .faq-section { background: #ffffff; padding: 80px 0; }
    .faq-item {
        border: 1px solid rgba(31,78,103,0.15); border-radius: 16px; margin-bottom: 12px;
        overflow: hidden; transition: all 0.3s ease; background: #fff;
    }
    .faq-item:hover { border-color: var(--hs-cyan); box-shadow: 0 5px 20px rgba(76,161,175,0.1); }
    .faq-question {
        display: flex; justify-content: space-between; align-items: center;
        padding: 22px 28px; cursor: pointer; font-weight: 700; color: var(--hs-blue);
        font-size: 1.1rem; user-select: none;
    }
    .faq-question:hover { color: var(--hs-cyan); }
    .faq-question i { transition: transform 0.3s ease; color: var(--hs-cyan); flex-shrink: 0; margin-left: 15px; }
    .faq-answer {
        max-height: 0; overflow: hidden; transition: max-height 0.4s ease, padding 0.3s ease;
        padding: 0 28px; color: #555; font-size: 1rem; line-height: 1.7;
        text-align: justify; text-justify: inter-word;
    }
    .faq-item.open .faq-answer { max-height: 300px; padding: 0 28px 22px; }
    .faq-item.open .faq-question i { transform: rotate(180deg); }
    .faq-item.open { border-color: var(--hs-cyan); box-shadow: 0 8px 25px rgba(76,161,175,0.12); }

    /* ── PARTNER SECTION STYLES ── */
    .partner-features { display: grid; grid-template-columns: 1fr 1fr; gap: 15px; margin-top: 20px; }
    .partner-feature {
        background: rgba(255,255,255,0.05); border: 1px solid rgba(76,161,175,0.2);
        border-radius: 12px; padding: 15px; display: flex; align-items: center; gap: 12px;
    }
    .partner-feature i { color: var(--hs-cyan); font-size: 1.2rem; flex-shrink: 0; }
    .partner-feature span { color: rgba(255,255,255,0.85); font-size: 0.95rem; }

/* ── BOTÓN ICONO PDF (EVALUACIÓN DE IMPACTO) ── */
.btn-icon-legal {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: rgba(76,161,175,0.08);
    border: 1px solid rgba(76,161,175,0.3);
    color: var(--hs-cyan);
    font-size: 1rem;
    text-decoration: none;
    position: relative;
    transition: all 0.3s ease;
}
.btn-icon-legal:hover {
    background: linear-gradient(135deg, var(--hs-blue), var(--hs-cyan));
    color: white;
    border-color: transparent;
    transform: translateY(-3px) scale(1.08);
    box-shadow: 0 8px 20px rgba(76,161,175,0.35);
}
.btn-icon-legal::after {
    content: attr(data-tooltip);
    position: absolute;
    bottom: 120%;
    left: 50%;
    transform: translateX(-50%) translateY(4px);
    background: var(--hs-dark);
    color: #fff;
    font-size: 0.65rem;
    letter-spacing: 0.5px;
    text-transform: none;
    padding: 6px 10px;
    border-radius: 8px;
    white-space: nowrap;
    opacity: 0;
    pointer-events: none;
    box-shadow: 0 5px 15px rgba(0,0,0,0.25);
    transition: all 0.25s ease;
}
.btn-icon-legal:hover::after {
    opacity: 1;
    transform: translateX(-50%) translateY(-4px);
}

    @keyframes breathe { 0%,100%{transform:scale(1);opacity:1}50%{transform:scale(1.02);opacity:0.95} }
    @keyframes pulseGreen { 0%{box-shadow:0 0 0 0 rgba(40,167,69,0.7)}70%{box-shadow:0 0 0 10px rgba(40,167,69,0)}100%{box-shadow:0 0 0 0 rgba(40,167,69,0)} }
    @keyframes blinker { 50%{opacity:0} }
    @keyframes wave-drift { 0%{transform:translateX(0) scaleY(1)}50%{transform:translateX(-25%) scaleY(1.1)}100%{transform:translateX(0) scaleY(1)} }
    @keyframes circuitMove { 0%{background-position:0 0}100%{background-position:30px 30px} }
    @keyframes hologramMove { 0%{transform:translateX(-100%)}100%{transform:translateX(100%)} }
    @keyframes dots-blink { 0%,100%{opacity:0.2}50%{opacity:1} }

    .ent-reveal, .ent-reveal-left, .ent-reveal-right { opacity:0; transition:opacity 1.2s var(--easing-premium),transform 1.2s var(--easing-premium); will-change:opacity,transform; }
    .ent-reveal { transform:translateY(30px); }
