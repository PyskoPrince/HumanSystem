    $('#paymentModal').on('shown.bs.modal', function () {
        if (!isCardMounted) {
            cardElement.mount('#card-element');
            isCardMounted = true;
        }
    });
    
    // ===== VARIABLES GLOBALES =====
    let croppieInstance = null;
    let signaturePad = null;
    let formData = null;

    // ===== ELEMENTOS DEL DOM =====
    const inputFoto = document.getElementById('inputFoto');
    const croppieContainer = document.getElementById('croppie-container');
    const cameraButton = document.getElementById('cameraButton');
    const cropButton = document.getElementById('cropButton');
    const croppedImage64Input = document.getElementById('croppedImage64');
    const imagePreviewContainer = document.getElementById('image-preview-container');
    const firmaInput = document.getElementById('firmaInput');
    const registerForm = document.getElementById('registerForm');
    const openPrivacyModal = document.getElementById('openPrivacyModal');
    const signatureCanvas = document.getElementById('signature-canvas');

    // ===== PREVENIR ENVÍO DEL FORMULARIO CON ENTER =====
    // Esto evita que Enter dispare el submit desde cualquier paso
    registerForm.addEventListener('keypress', function(e) {
        // Si presionas Enter y NO estamos en el paso 5, evitar el submit
        if (e.key === 'Enter' && currentStep !== 4) { // Paso 5 es index 4
            e.preventDefault();
            return false;
        }
    });

    // También prevenir el submit nativo del formulario (ya lo haces con e.preventDefault)
    // Pero asegurarnos que ningún input dentro del formulario dispare submit con Enter
    document.querySelectorAll('#registerForm input, #registerForm textarea').forEach(input => {
        input.addEventListener('keypress', function(e) {
            if (e.key === 'Enter' && currentStep !== 4) {
                e.preventDefault();
                return false;
            }
        });
    });

    // ===== CONFIGURACIÓN DE PASOS =====
    const steps = document.querySelectorAll('.form-step');
    const stepDots = document.querySelectorAll('.step-dot');
    let currentStep = 0;

    function updateStepUI() {
        steps.forEach((step, index) => {
            step.classList.toggle('active', index === currentStep);
        });
        stepDots.forEach((dot, index) => {
            dot.classList.toggle('active', index === currentStep);
            dot.classList.toggle('completed', index < currentStep);
            dot.innerHTML = index < currentStep ? '✓' : index + 1;
        });
        window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    // ===== CONVERTIR BASE64 A BLOB =====
    function base64ToBlob(base64) {
        try {
            let base64Data = base64;
            if (base64.includes(',')) base64Data = base64.split(',')[1];
            const byteCharacters = atob(base64Data);
            const byteNumbers = new Array(byteCharacters.length);
            for (let i = 0; i < byteCharacters.length; i++) {
                byteNumbers[i] = byteCharacters.charCodeAt(i);
            }
            return new Blob([new Uint8Array(byteNumbers)], { type: 'image/png' });
        } catch (error) {
            throw new Error('Error al procesar la imagen');
        }
    }

    // ===== VALIDACIÓN DE CONTRASEÑAS =====
    function validarContraseñas(contrasena1, contrasena2) {
        if (contrasena1 !== contrasena2) return { success: false, message: 'Las contraseñas no coinciden.' };
        if (contrasena1.length < 8) return { success: false, message: 'La contraseña debe tener al menos 8 caracteres.' };
        if (contrasena1.length > 20) return { success: false, message: 'La contraseña no debe exceder los 20 caracteres.' };
        const regex = /^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)/;
        if (!regex.test(contrasena1)) return { success: false, message: 'La contraseña debe contener al menos una letra mayúscula, una minúscula y un número.' };
        return { success: true };
    }

    // ===== VERIFICAR DUPLICADOS EN BD =====
    async function verificarDuplicados(curp, rfc, correo, telefono) {
        try {
            const response = await fetch('/verificarDuplicados', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ curp, rfc, correo, telefono })
            });
            const data = await response.json();
            if (!data.success) {
                Swal.fire('Error de Validación', data.message || 'No se pudo verificar la información', 'error');
                return false;
            }
            return true;
        } catch (error) {
            Swal.fire('Error de Conexión', 'Hubo un problema al verificar los datos. Inténtalo de nuevo.', 'error');
            return false;
        }
    }

    // ========== VALIDACIONES DEL PASO 2 (SECUENCIAL) ==========
    
    function validarNombreCompleto(nombre) {
        nombre = nombre.trim().toUpperCase();
        if (!nombre) return { valid: false, message: 'El nombre completo es obligatorio' };
        if (nombre.length < 5) return { valid: false, message: 'Ingresa nombre(s) y apellidos completos' };
        if (nombre.length > 100) return { valid: false, message: 'El nombre no debe exceder 100 caracteres' };
        const nombreRegex = /^[A-Za-zÁÉÍÓÚáéíóúÑñüÜ\s\.]+$/;
        if (!nombreRegex.test(nombre)) return { valid: false, message: 'El nombre solo debe contener letras y espacios' };
        const palabras = nombre.split(/\s+/);
        if (palabras.length < 2) return { valid: false, message: 'Ingresa nombre(s) y apellidos completos' };
        return { valid: true, message: '', nombreLimpio: nombre };
    }
function validarCURP(curp) {
    curp = curp.trim().toUpperCase();
    if (curp.length !== 18) return { valid: false, message: 'La CURP debe tener exactamente 18 caracteres' };
    
    // REGEX CORREGIDO: Los últimos 2 caracteres pueden ser números o letras
    // Formato: 4 letras + 6 números + 6 letras + 2 caracteres (letra o número)
    const curpRegex = /^[A-Z]{4}[0-9]{6}[A-Z]{6}[A-Z0-9]{2}$/;
    if (!curpRegex.test(curp)) return { valid: false, message: 'Formato de CURP inválido (4 letras + 6 números + 6 letras + 2 caracteres alfanuméricos)' };
    
    const anio = parseInt(curp.substring(4, 6));
    const mes = parseInt(curp.substring(6, 8));
    const dia = parseInt(curp.substring(8, 10));
    
    if (anio < 0 || anio > 99) return { valid: false, message: 'Año inválido en CURP' };
    if (mes < 1 || mes > 12) return { valid: false, message: 'Mes inválido en CURP' };
    if (dia < 1 || dia > 31) return { valid: false, message: 'Día inválido en CURP' };
    
    const diasPorMes = [31, (anio % 4 === 0 ? 29 : 28), 31, 30, 31, 30, 31, 31, 30, 31, 30, 31];
    if (dia > diasPorMes[mes - 1]) return { valid: false, message: 'La fecha en CURP no es válida' };
    
    return { valid: true, message: '', curpLimpia: curp };
}

    function validarRFC(rfc) {
        rfc = rfc.trim().toUpperCase();
        if (rfc.length !== 13) return { valid: false, message: 'El RFC debe tener 13 caracteres para persona física' };
        const rfcRegex = /^[A-Z]{4}[0-9]{6}[A-Z0-9]{3}$/;
        if (!rfcRegex.test(rfc)) return { valid: false, message: 'Formato de RFC inválido (4 letras + 6 números + 3 caracteres)' };
        const anio = parseInt(rfc.substring(4, 6));
        const mes = parseInt(rfc.substring(6, 8));
        const dia = parseInt(rfc.substring(8, 10));
        if (anio < 0 || anio > 99) return { valid: false, message: 'Año inválido en RFC' };
        if (mes < 1 || mes > 12) return { valid: false, message: 'Mes inválido en RFC' };
        if (dia < 1 || dia > 31) return { valid: false, message: 'Día inválido en RFC' };
        const diasPorMes = [31, (anio % 4 === 0 ? 29 : 28), 31, 30, 31, 30, 31, 31, 30, 31, 30, 31];
        if (dia > diasPorMes[mes - 1]) return { valid: false, message: 'La fecha en RFC no es válida' };
        return { valid: true, message: '', rfcLimpio: rfc };
    }

    function validarFechaNacimiento(fecha, curp = null) {
        if (!fecha) return { valid: false, message: 'La fecha de nacimiento es obligatoria' };
        const fechaNac = new Date(fecha);
        const hoy = new Date();
        if (isNaN(fechaNac.getTime())) return { valid: false, message: 'Fecha de nacimiento inválida' };
        if (fechaNac > hoy) return { valid: false, message: 'La fecha no puede ser futura' };
        let edad = hoy.getFullYear() - fechaNac.getFullYear();
        const mesDiff = hoy.getMonth() - fechaNac.getMonth();
        const diaDiff = hoy.getDate() - fechaNac.getDate();
        if (mesDiff < 0 || (mesDiff === 0 && diaDiff < 0)) edad--;
        if (edad < 18) return { valid: false, message: 'Debes ser mayor de 18 años para registrarte' };
        if (edad > 100) return { valid: false, message: 'La edad debe ser coherente (menor de 100 años)' };
        if (curp && curp.length === 18) {
            const anioCurp = parseInt(curp.substring(4, 6));
            const mesCurp = parseInt(curp.substring(6, 8));
            const diaCurp = parseInt(curp.substring(8, 10));
            const anioCompletoCurp = anioCurp <= (hoy.getFullYear() % 100) ? 2000 + anioCurp : 1900 + anioCurp;
            const fechaCurp = new Date(anioCompletoCurp, mesCurp - 1, diaCurp);
            if (fechaCurp.toDateString() !== fechaNac.toDateString()) {
                return { valid: false, message: 'La fecha no coincide con la CURP proporcionada' };
            }
        }
        return { valid: true, message: '', edad: edad };
    }

    function marcarCampoInvalido(selector, mensaje) {
        const campo = document.querySelector(selector);
        if (campo) {
            campo.style.borderColor = '#df0000';
            campo.style.boxShadow = '0 0 0 4px rgba(223, 0, 0, 0.1)';
            campo.style.backgroundColor = 'rgba(223, 0, 0, 0.1)';
            let hint = campo.parentElement.querySelector('.validation-hint');
            if (!hint) {
                hint = document.createElement('small');
                hint.className = 'validation-hint error';
                campo.parentElement.appendChild(hint);
            }
            hint.textContent = mensaje;
            hint.style.display = 'block';
        }
    }

    function marcarCampoValido(selector) {
        const campo = document.querySelector(selector);
        if (campo) {
            campo.style.borderColor = '#28a745';
            campo.style.boxShadow = '0 0 0 4px rgba(40, 167, 69, 0.1)';
            campo.style.backgroundColor = 'rgba(40, 167, 69, 0.05)';
            const hint = campo.parentElement.querySelector('.validation-hint');
            if (hint) hint.style.display = 'none';
        }
    }

    function limpiarMarcasPaso2() {
        ['nombre', 'curp', 'rfc', 'fechaNacimiento'].forEach(campo => {
            const elemento = document.querySelector(`input[name="${campo}"]`);
            if (elemento) {
                elemento.style.borderColor = 'rgba(76, 161, 175, 0.2)';
                elemento.style.backgroundColor = 'rgba(10, 17, 32, 0.3)';
                const hint = elemento.parentElement.querySelector('.validation-hint');
                if (hint) hint.remove();
            }
        });
    }

    function validarPaso2Secuencial() {
        const nombre = document.querySelector('input[name="nombre"]').value;
        const curp = document.querySelector('input[name="curp"]').value;
        const rfc = document.querySelector('input[name="rfc"]').value;
        const fecha = document.querySelector('input[name="fechaNacimiento"]').value;
        
        limpiarMarcasPaso2();
        
        const nombreVal = validarNombreCompleto(nombre);
        if (!nombreVal.valid) {
            marcarCampoInvalido('input[name="nombre"]', nombreVal.message);
            Swal.fire({ title: '⚠️ Verifica tu nombre', text: nombreVal.message, icon: 'warning', confirmButtonColor: '#1F4E67' });
            return false;
        }
        marcarCampoValido('input[name="nombre"]');
        
        const curpVal = validarCURP(curp);
        if (!curpVal.valid) {
            marcarCampoInvalido('input[name="curp"]', curpVal.message);
            Swal.fire({ title: '⚠️ CURP inválida', text: curpVal.message, icon: 'warning', confirmButtonColor: '#1F4E67' });
            return false;
        }
        marcarCampoValido('input[name="curp"]');
        
        const rfcVal = validarRFC(rfc);
        if (!rfcVal.valid) {
            marcarCampoInvalido('input[name="rfc"]', rfcVal.message);
            Swal.fire({ title: '⚠️ RFC inválido', text: rfcVal.message, icon: 'warning', confirmButtonColor: '#1F4E67' });
            return false;
        }
        marcarCampoValido('input[name="rfc"]');
        
        const fechaVal = validarFechaNacimiento(fecha, curp);
        if (!fechaVal.valid) {
            marcarCampoInvalido('input[name="fechaNacimiento"]', fechaVal.message);
            Swal.fire({ title: '⚠️ Fecha inválida', text: fechaVal.message, icon: 'warning', confirmButtonColor: '#1F4E67' });
            return false;
        }
        marcarCampoValido('input[name="fechaNacimiento"]');
        
        Swal.fire({ title: '✅ Datos correctos', text: `Bienvenido ${nombreVal.nombreLimpio}`, icon: 'success', timer: 1500, showConfirmButton: false, toast: true, position: 'top-end' });
        return true;
    }

    // ===== MANEJO DE CROPPIE (FOTO DE PERFIL) =====
    cameraButton.addEventListener('click', () => inputFoto.click());

    inputFoto.addEventListener('change', function(e) {
        if (this.files && this.files[0]) {
            const file = this.files[0];
            if (!file.type.startsWith('image/')) {
                Swal.fire({ icon: 'error', title: 'Formato inválido', text: 'Selecciona un archivo de imagen (JPG o PNG)', confirmButtonColor: '#1F4E67' });
                this.value = '';
                return;
            }
            const reader = new FileReader();
            reader.onload = function(evt) {
                imagePreviewContainer.style.display = 'none';
                cameraButton.style.display = 'none';
                croppieContainer.style.display = 'block';
                if (croppieInstance) croppieInstance.destroy();
                croppieInstance = new Croppie(croppieContainer, {
                    viewport: { width: 200, height: 200, type: 'circle' },
                    boundary: { width: 250, height: 250 },
                    showZoomer: true,
                    enableOrientation: true
                });
                croppieInstance.bind({ url: evt.target.result });
                cropButton.style.display = 'inline-block';
            };
            reader.readAsDataURL(file);
        }
    });

    cropButton.addEventListener('click', function() {
        croppieInstance.result({ type: 'base64', size: 'viewport', format: 'png', quality: 1 }).then(function(base64) {
            croppedImage64Input.value = base64;
            imagePreviewContainer.innerHTML = `<img src="${base64}" style="width:150px; height:150px; object-fit:cover; border-radius:50%; border:4px solid var(--hs-cyan);">`;
            imagePreviewContainer.style.display = 'block';
            croppieContainer.style.display = 'none';
            cropButton.style.display = 'none';
            cameraButton.innerHTML = '<i class="fas fa-redo mr-2"></i> CAMBIAR FOTO';
            cameraButton.style.display = 'inline-block';
            Swal.fire({ icon: 'success', title: 'Foto confirmada', text: 'Tu foto ha sido procesada correctamente', timer: 1500, showConfirmButton: false });
        });
    });

    // ===== MANEJO DE LA FIRMA DIGITAL =====
    function initSignaturePad() {
        const container = signatureCanvas.parentElement;
        const containerWidth = container.clientWidth - 40;
        if (containerWidth > 0) {
            signatureCanvas.width = Math.min(containerWidth, 600);
            signatureCanvas.height = 200;
        }
        signaturePad = new SignaturePad(signatureCanvas, {
            backgroundColor: 'rgb(255, 255, 255)',
            penColor: 'rgb(0, 0, 0)',
            velocityFilterWeight: 0.7,
            minWidth: 0.5,
            maxWidth: 2.5
        });
        
        const undoButton = document.getElementById('undo-signature');
        const clearButton = document.getElementById('clear-signature');
        const confirmButton = document.getElementById('confirm-signature');
        
        undoButton.addEventListener('click', () => {
            const data = signaturePad.toData();
            if (data && data.length > 0) {
                data.pop();
                signaturePad.fromData(data);
            }
        });
        clearButton.addEventListener('click', () => signaturePad.clear());
        confirmButton.addEventListener('click', function() {
            if (signaturePad.isEmpty()) {
                Swal.fire({ icon: 'info', title: 'Firma vacía', text: 'Dibuja tu firma antes de confirmar.' });
                return;
            }
            const dataURL = signaturePad.toDataURL('image/png');
            firmaInput.value = dataURL;
            signatureCanvas.style.display = 'none';
            undoButton.style.display = 'none';
            clearButton.style.display = 'none';
            confirmButton.style.display = 'none';
            const preview = document.getElementById('signature-preview');
            preview.innerHTML = `<div class="text-center p-3" style="background: rgba(255,255,255,0.05); border-radius: 15px; border: 1px dashed var(--hs-cyan);">
                <p class="small mb-2" style="color: var(--hs-cyan); letter-spacing: 2px;">FIRMA REGISTRADA</p>
                <img src="${dataURL}" class="img-fluid mb-3" style="max-width: 200px; filter: invert(1) brightness(2);">
                <br><button type="button" class="btn btn-outline-sm" id="re-do-signature" style="font-size: 0.7rem; color: var(--hs-red); border: 1px solid var(--hs-red); background: transparent; border-radius: 20px; padding: 5px 15px;"><i class="fas fa-redo mr-1"></i> REHACER FIRMA</button></div>`;
            preview.style.display = 'block';
            document.getElementById('re-do-signature').addEventListener('click', function() {
                preview.style.display = 'none';
                signatureCanvas.style.display = 'block';
                undoButton.style.display = 'inline-block';
                clearButton.style.display = 'inline-block';
                confirmButton.style.display = 'inline-block';
                signaturePad.clear();
                firmaInput.value = '';
            });
            Swal.fire({ icon: 'success', title: 'Protocolo Confirmado', timer: 1000, showConfirmButton: false });
        });
    }

    const observer = new MutationObserver(function(mutations) {
        mutations.forEach(function(mutation) {
            if (mutation.target.id === 'step5' && mutation.target.classList.contains('active')) {
                setTimeout(initSignaturePad, 100);
            }
        });
    });
    observer.observe(document.getElementById('step5'), { attributes: true, attributeFilter: ['class'] });

    // ===== BOTÓN SIGUIENTE PASO 1 =====
    document.getElementById('nextStep1').addEventListener('click', function() {
        if (!croppedImage64Input.value) {
            Swal.fire({ title: 'Atención', text: 'Debes subir y confirmar tu foto para continuar.', icon: 'warning', confirmButtonColor: '#1F4E67' });
            return;
        }
        if (currentStep < steps.length - 1) { currentStep++; updateStepUI(); }
    });

    // ===== BOTÓN SIGUIENTE PASO 2 (VALIDACIÓN SECUENCIAL) =====
    const nextStep2Btn = document.getElementById('nextStep2');
    if (nextStep2Btn) {
        const newNextStep2Btn = nextStep2Btn.cloneNode(true);
        nextStep2Btn.parentNode.replaceChild(newNextStep2Btn, nextStep2Btn);
        newNextStep2Btn.addEventListener('click', function() {
            if (validarPaso2Secuencial()) {
                if (currentStep < steps.length - 1) { currentStep++; updateStepUI(); }
            }
        });
    }

    // ===== BOTÓN SIGUIENTE PASO 3 =====
    const nextStep3Btn = document.getElementById('nextStep3');
    if (nextStep3Btn) {
        nextStep3Btn.addEventListener('click', async function() {
            const correo = document.querySelector('input[name="correo"]').value.trim();
            const telefono = document.querySelector('input[name="telefono"]').value.trim();
            const direccion = document.querySelector('textarea[name="direccion"]').value.trim();
            const curp = document.querySelector('input[name="curp"]').value.trim();
            const rfc = document.querySelector('input[name="rfc"]').value.trim();

            if (!correo || !telefono || !direccion) {
                Swal.fire('Campos incompletos', 'Por favor, llena tu correo, celular y dirección.', 'warning');
                return;
            }
            const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
            if (!emailRegex.test(correo)) {
                Swal.fire('Correo inválido', 'El formato del correo electrónico no es correcto.', 'warning');
                return;
            }
            const telRegex = /^\d{10}$/;
            if (!telRegex.test(telefono)) {
                Swal.fire('Celular inválido', 'El celular debe contener exactamente 10 dígitos numéricos.', 'warning');
                return;
            }
            Swal.fire({ title: 'Verificando datos...', text: 'Comprobando disponibilidad en Human System...', allowOutsideClick: false, didOpen: () => Swal.showLoading() });
            const duplicadosOk = await verificarDuplicados(curp, rfc, correo, telefono);
            if (duplicadosOk) {
                Swal.close();
                if (currentStep < steps.length - 1) { currentStep++; updateStepUI(); }
            }
        });
    }

    // ===== VALIDACIÓN DE CONTRASEÑAS PASO 4 =====
    document.getElementById('validatePassword').addEventListener('click', function() {
        const pass1 = document.getElementById('pass1').value;
        const pass2 = document.getElementById('pass2').value;
        if (!pass1 || !pass2) {
            Swal.fire('Error', 'Completa los campos de contraseña', 'warning');
            return;
        }
        const validation = validarContraseñas(pass1, pass2);
        if (!validation.success) {
            Swal.fire('Contraseña Inválida', validation.message, 'error');
            return;
        }
        if (currentStep < steps.length - 1) { currentStep++; updateStepUI(); }
    });

    // ===== BOTONES ANTERIOR =====
    document.querySelectorAll('.prev-step').forEach(btn => {
        btn.addEventListener('click', () => { if (currentStep > 0) { currentStep--; updateStepUI(); } });
    });

    // ===== MANEJO DEL MODAL DE PRIVACIDAD =====
    openPrivacyModal.addEventListener('click', (e) => { e.preventDefault(); $('#termsModal').modal('show'); });

    // ===== ENVÍO DEL FORMULARIO =====
    registerForm.addEventListener('submit', async function(e) {
        e.preventDefault();
        if (!firmaInput.value) { Swal.fire('Firma requerida', 'Debes confirmar tu firma digital.', 'warning'); return; }
        if (!document.getElementById('termsCheck').checked) { Swal.fire('Aceptación requerida', 'Debes aceptar el Aviso de Privacidad.', 'warning'); return; }
        if (!croppedImage64Input.value) { Swal.fire('Foto requerida', 'Debes subir y confirmar tu foto de perfil.', 'warning'); return; }
        
        formData = new FormData(registerForm);
        try {
            const fotoPerfilBlob = base64ToBlob(croppedImage64Input.value);
            formData.append('fotoPerfil', fotoPerfilBlob, 'fotoPerfil.png');
            const firmaDigitalBlob = base64ToBlob(firmaInput.value);
            formData.append('firmaDigital', firmaDigitalBlob, 'firmaDigital.png');
        } catch (error) {
            Swal.fire('Error de Imagen', 'Hubo un problema al procesar las imágenes.', 'error');
            return;
        }
        
        Swal.fire({ title: 'Validando datos...', text: 'Por favor espera.', allowOutsideClick: false, didOpen: () => Swal.showLoading() });
        
        const curp = formData.get('curp');
        const rfc = formData.get('rfc');
        const correo = formData.get('correo');
        const telefono = formData.get('telefono');
        const duplicadosOk = await verificarDuplicados(curp, rfc, correo, telefono);
        
        if (!duplicadosOk) { Swal.close(); return; }
        Swal.close();
        $('#paymentModal').modal('show');
    });

    // ===== PROCESAR PAGO =====
    document.getElementById('payButton').addEventListener('click', async function() {
        $('#paymentModal').modal('hide');
        Swal.fire({ title: 'Procesando pago...', text: 'Por favor espera.', allowOutsideClick: false, didOpen: () => Swal.showLoading() });
        try {
            const { paymentMethod, error } = await stripe.createPaymentMethod({ type: 'card', card: cardElement });
            if (error) throw new Error(error.message);
            const paymentResponse = await fetch('/procesarPago', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ paymentMethodId: paymentMethod.id })
            });
            const paymentResult = await paymentResponse.json();
            if (!paymentResult.success) throw new Error(paymentResult.message || 'Error en el pago');
            const registerResponse = await fetch('/register', { method: 'POST', body: formData });
            const registerResult = await registerResponse.json();
            if (registerResult.success) {
                Swal.fire({ title: '¡Registro exitoso!', text: 'Tu identidad ha sido registrada en Human System.', icon: 'success', confirmButtonText: 'Iniciar Sesión' }).then(() => window.location.href = '/login');
            } else {
                throw new Error(registerResult.message || 'Error en el registro');
            }
        } catch (error) {
            Swal.fire({ title: 'Error', text: error.message || 'Ocurrió un error al procesar tu solicitud.', icon: 'error', confirmButtonText: 'Cerrar' });
        }
    });

    cardElement.on('change', function(event) {
        document.getElementById('card-errors').textContent = event.error ? event.error.message : '';
    });

    window.addEventListener('resize', function() {
        if (signaturePad && document.getElementById('step5').classList.contains('active')) {
            const container = signatureCanvas.parentElement;
            const containerWidth = container.clientWidth - 40;
            if (containerWidth > 0) {
                const oldData = signaturePad.toData();
                signatureCanvas.width = Math.min(containerWidth, 600);
                signatureCanvas.height = 200;
                signaturePad.clear();
                if (oldData && oldData.length > 0) signaturePad.fromData(oldData);
            }
        }
    });

    // Configurar fecha máxima (18 años atrás)
    const fechaInputElem = document.querySelector('input[name="fechaNacimiento"]');
    if (fechaInputElem) {
        const hoy = new Date();
        const fechaMax = new Date();
        fechaMax.setFullYear(hoy.getFullYear() - 18);
        fechaInputElem.max = fechaMax.toISOString().split('T')[0];
        const fechaMin = new Date();
        fechaMin.setFullYear(hoy.getFullYear() - 100);
        fechaInputElem.min = fechaMin.toISOString().split('T')[0];
    }
});
</script>

<%- include('partials/footer', { login: false }) %>