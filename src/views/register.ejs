<script>
document.addEventListener('DOMContentLoaded', function() {
    // Verificar hash para abrir modal de términos
    if (window.location.hash === '#termsModal') {
        $('#termsModal').modal('show');
    }

    // ===== CONFIGURACIÓN DE STRIPE =====
    const stripe = Stripe('pk_test_51RzULWPzFVL2ubLUEK6vHTCzHmw5ZKR7fIxywToZU62Hh6iG11Hok9sxeLPQDaMe75mlD5kQMrQarJSMw0LhYlAY00fkNYY5y7');
