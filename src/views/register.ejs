                <!-- Vista previa de la imagen -->
                <div class="photo-area">
                    <div id="image-preview-container" class="mb-3">
                        <i class="fas fa-user-circle fa-6x" style="color: rgba(14,54,72,0.2);"></i>
                    </div>
                    
