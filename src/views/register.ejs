                    <input type="file" id="inputFoto" class="d-none" accept="image/*">
                    <input type="hidden" id="croppedImage64" name="croppedImage64">
                    
                    <!-- Botones de control -->
                    <div class="mt-3">
    <button type="button" class="btn-brand" id="cameraButton">
        <i class="fas fa-camera mr-2"></i> SUBIR FOTO
    </button>
    
    <button type="button" class="btn-success-hs" id="cropButton" style="display:none;">
        <i class="fas fa-check mr-2"></i> CONFIRMAR FOTO
    </button>

    </div>
                </div>
                
                <!-- Botón de siguiente paso -->
                <div class="d-flex justify-content-end mt-4">
                    <button type="button" class="btn-brand" id="nextStep1">SIGUIENTE ></button>
                </div>
            </div>

            <!-- PASO 2: DATOS DE IDENTIDAD -->
            <div class="form-step" id="step2">
                <h4 class="text-center mb-4">FASE 2: DATOS DE IDENTIDAD</h4>
                
